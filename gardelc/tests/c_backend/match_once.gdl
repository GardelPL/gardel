program MATCH_ONCE

feature {ANY}

  fib_pair(n: U64): TUPLE[U64, U64]
    variant
      n
    do
      if n = 0 then
        (0, 1)
      else
        match fib_pair(n - 1)
          case (a, b) then (b, a +% b)
        end
      end
    end

  classify(n: U64): U64
    variant
      n
    do
      if n = 0 then
        0
      else
        match classify(n - 1)
          case 0 then 1
          case 1 then 2
          case _ then 0
        end
      end
    end

  first_failure: U64
    do
      if fib_pair(90).first != 2880067194370816120 then 1
      else if classify(60) != 0 then 2
      else if classify(61) != 1 then 3
      else 0
      end end end
    end

  main(args: SEQ[STRING]): IO[EXIT_CODE]
    do
      IO.exit(first_failure)
    end

end
