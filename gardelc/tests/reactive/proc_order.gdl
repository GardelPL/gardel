-- A child that ends at once, leaving a child of its own to write later (Task F.11a): its
-- ProcessExited comes only after that output, when nothing can write to it any more.
--
--   proc_order <child>
reactive program PROC_ORDER

feature {ANY}

  init(args: SEQ[STRING]): STEP[NAT]
    do
      let xs = args.to_list
      Continue(0, LIST.empty.prepend(RunProcess(1, if xs.length > 0 then xs.head else "" end, LIST.empty.prepend("orphan"), "")))
    end

  step(s: NAT, e: EVENT): STEP[NAT]
    do
      match e
        case ProcessOutput(p, data) then
          match STRING.from_utf8(data)
            case Ok(t) then Continue(s, LIST.empty.prepend(Print(t)))
            case Error(_) then Continue(s, LIST.empty.prepend(Print("(not UTF-8)")))
          end
        case ProcessExited(p, code) then
          Stop(0, LIST.empty.prepend(Print("exited")))
        case ProcessFailed(tag, err) then
          Stop(4, LIST.empty.prepend(Print("failed")))
        case Shutdown then
          Stop(9, LIST.empty)
        case _ then
          Continue(s, LIST.empty)
      end
    end

end
