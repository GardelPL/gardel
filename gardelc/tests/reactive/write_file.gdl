-- WriteFile (Task F.16a): writes a new file, replaces one, and tries a file in a directory that
-- does not exist and a path that is a directory. When the four have answered, it reads the new
-- file back and stops.
--
-- It runs in the directory it writes in.
reactive program WRITE_FILE

feature {ANY}

  -- `a` and `b`, when they fit.
  joined(a: STRING, b: STRING): STRING
    do
      if a.byte_length <= 1000 and b.byte_length <= 1000 then a.concat(b) else a end
    end

  -- One more of the four answered; after the fourth, the new file is read.
  answered(s: NAT, cmds: LIST[COMMAND], dir: STRING): STEP[NAT]
    do
      if s >= 3 then
        Continue(4, cmds.prepend(ReadFile(5, joined(dir, "/new.txt"))))
      else
        Continue(s + 1, cmds)
      end
    end

  init(args: SEQ[STRING]): STEP[NAT]
    do
      let dir = "."
      Continue(0, LIST.empty
        .prepend(WriteFile(4, dir, "x".to_utf8))
        .prepend(WriteFile(3, joined(dir, "/missing/x.txt"), "x".to_utf8))
        .prepend(WriteFile(2, joined(dir, "/old.txt"), "replaced".to_utf8))
        .prepend(WriteFile(1, joined(dir, "/new.txt"), "first line\nsecond".to_utf8)))
    end

  step(s: NAT, e: EVENT): STEP[NAT]
    do
      match e
        case FileWritten(tag, r) then
          let line = match r
            case Ok(n) then joined(joined("written ", NUMBER_TEXT.nat_to_text(tag)), joined(" ", NUMBER_TEXT.nat_to_text(n)))
            case Error(_) then joined("failed ", NUMBER_TEXT.nat_to_text(tag))
          end
          answered(s, LIST.empty.prepend(Print(line)), ".")
        case FileRead(tag, r) then
          match r
            case Ok(data) then
              match STRING.from_utf8(data)
                case Ok(t) then Stop(0, LIST.empty.prepend(Print("done")).prepend(Print(joined("read ", t))))
                case Error(_) then Stop(1, LIST.empty)
              end
            case Error(_) then Stop(1, LIST.empty.prepend(Print("not read")))
          end
        case Shutdown then Stop(2, LIST.empty)
        case _ then Continue(s, LIST.empty)
      end
    end

end
