-- Formally verified reactive HTTP/1.1 server written in Gardel (pure core + reactive shell).
--
--   gardelc --project ghttp --strict
reactive program HTTP_SERVER

feature {ANY}

  -- Parses 1..5 ASCII decimal digits into a valid TCP port (1..65535), or falls back to 8080.
  parse_port_digits(bs: BYTES, idx: NAT, acc: NAT): NAT
    require
      idx_bounded: idx <= 5
      acc_bounded: acc <= 65535
    variant
      5 - idx
    do
      if bs.length = 0 or bs.length > 5 then
        8080
      else if idx >= bs.length or idx = 5 then
        if acc >= 1 and acc <= 65535 then acc else 8080 end
      else
        let b = bs.at(idx)
        if b < 48 or b > 57 then
          8080
        else
          let next_acc = acc * 10 + (b - 48)
          if next_acc > 65535 then
            8080
          else
            parse_port_digits(bs, idx + 1, next_acc)
          end
        end
      end end
    ensure
      valid_port: Result >= 1 and Result <= 65535
    end

  -- Resolves the TCP listen port from `args` (defaults to 8080 when omitted or invalid).
  resolve_port(args: SEQ[STRING]): NAT
    variant
      args
    do
      match args
        case Empty then
          8080
        case Leaf(arg0) then
          parse_port_digits(arg0.to_utf8, 0, 0)
        case Concat(left_seq, _, _) then
          resolve_port(left_seq)
      end
    ensure
      valid_port: Result >= 1 and Result <= 65535
    end

  init(args: SEQ[STRING]): STEP[HTTP_SERVER_STATE]
    do
      let port = resolve_port(args)
      Continue(HTTP_SERVER_STATE.make_on_port(64, port), LIST.empty.prepend(Listen(port)))
    end

  handle_received(s: HTTP_SERVER_STATE, c: CONN_ID, data: BYTES): STEP[HTTP_SERVER_STATE]
    do
      match s.lookup_connection(c)
        case None then
          Continue(s, LIST.empty.prepend(Close(c)))
        case Some(conn) then
          if not conn.connection_status.can_accept_bytes then
            Continue(s.release_connection(c), LIST.empty.prepend(Close(c)))
          else
            match HTTP_PARSER.feed(conn.parser_state, data)
              case NeedMore(next_p) then
                Continue(s.save_connection(conn.with_parser_state(next_p)), LIST.empty)
              case Complete(req, _) then
                let wire = HTTP_SERIALIZER.serialize_answer(HTTP_APPLICATION.dispatch(req, s.router), req.method.equals(Head), True)
                Continue(s.release_connection(c), LIST.empty.prepend(Close(c)).prepend(Send(c, wire)))
              case Failed(err) then
                let wire = HTTP_SERIALIZER.serialize_answer(HTTP_RESPONSE.from_error(err), False, True)
                Continue(s.release_connection(c), LIST.empty.prepend(Close(c)).prepend(Send(c, wire)))
            end
          end
      end
    end

  step(s: HTTP_SERVER_STATE, e: EVENT): STEP[HTTP_SERVER_STATE]
    do
      match e
        case Accepted(c) then
          if s.has_connection_room then
            Continue(s.admit_connection(c), LIST.empty)
          else
            Continue(s, LIST.empty.prepend(Close(c)))
          end
        case Received(c, data) then
          handle_received(s, c, data)
        case SendFailed(c, _) then
          Continue(s.release_connection(c), LIST.empty.prepend(Close(c)))
        case Closed(c) then
          Continue(s.release_connection(c), LIST.empty)
        case ListenFailed(_, _) then
          Stop(1, LIST.empty.prepend(Print("ghttp: listen failed")))
        case Shutdown then
          Stop(0, LIST.empty)
        case _ then
          Continue(s, LIST.empty)
      end
    end

end
