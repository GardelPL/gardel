-- The media type a response states in `Content-Type` (RFC 9110 section 8.3), from a fixed
-- set, so the header line it adds is known and holds no line break.
module HTTP_CONTENT_TYPE satisfies CANONICAL_EQ

representation {ANY}
  -- No `Content-Type` field is sent.
  | Unstated
  -- `text/plain; charset=utf-8`
  | PlainText
  -- `application/json`, which is UTF-8 by definition (RFC 8259 section 8.1).
  | Json

feature {ANY}

  equals(other: HTTP_CONTENT_TYPE): BOOL
    do
      Current = other
    ensure
      def: Result = (Current = other)
    end

  -- The header line this type adds to a response, with its CRLF, or "" for `Unstated`.
  header_line: STRING
    do
      match Current
        case Unstated then ""
        case PlainText then "Content-Type: text/plain; charset=utf-8\r\n"
        case Json then "Content-Type: application/json\r\n"
      end
    ensure
      bounded: Result.byte_length <= 41
      unstated_empty: (Current = Unstated) implies Result.byte_length = 0
    end

specify {CANONICAL_EQ}

  law agrees_with_structural(a: HTTP_CONTENT_TYPE, b: HTTP_CONTENT_TYPE)
    ensure
      sound: a.equals(b) = (a = b)
    end

specify {EQ}

  law reflexive(a: HTTP_CONTENT_TYPE)
    ensure
      refl: a.equals(a)
    end

  law symmetric(a: HTTP_CONTENT_TYPE, b: HTTP_CONTENT_TYPE)
    require
      ab: a.equals(b)
    ensure
      ba: b.equals(a)
    end

  law transitive(a: HTTP_CONTENT_TYPE, b: HTTP_CONTENT_TYPE, c: HTTP_CONTENT_TYPE)
    require
      ab: a.equals(b)
      bc: b.equals(c)
    ensure
      ac: a.equals(c)
    end

end
