-- Single HTTP header field with bounded name and value lengths (RFC 9110 Section 5).
module HTTP_HEADER satisfies EQ

representation {NONE}
  field_name: STRING
  field_value: STRING
  name_len: NAT
  value_len: NAT

invariant
  name_len_matches: name_len = field_name.byte_length
  value_len_matches: value_len = field_value.byte_length
  name_non_empty: name_len >= 1
  name_bounded: name_len <= 128
  value_bounded: value_len <= 1024

create {ANY}

  make(n: STRING, v: STRING): HTTP_HEADER
    require
      name_present: n.byte_length >= 1
      name_fits: n.byte_length <= 128
      val_fits: v.byte_length <= 1024
    do
      { field_name = n,
        field_value = v,
        name_len = n.byte_length,
        value_len = v.byte_length }
    ensure
      name_set: Result.name.equals(n)
      value_set: Result.value.equals(v)
      nlen_set: Result.name_byte_length = n.byte_length
      vlen_set: Result.value_byte_length = v.byte_length
    end

  content_type_json: HTTP_HEADER
    do
      { field_name = "Content-Type",
        field_value = "application/json",
        name_len = 12,
        value_len = 16 }
    ensure
      nlen_12: Result.name_byte_length = 12
      vlen_16: Result.value_byte_length = 16
    end

  content_type_text: HTTP_HEADER
    do
      { field_name = "Content-Type",
        field_value = "text/plain",
        name_len = 12,
        value_len = 10 }
    ensure
      nlen_12: Result.name_byte_length = 12
      vlen_10: Result.value_byte_length = 10
    end

  connection_close: HTTP_HEADER
    do
      { field_name = "Connection",
        field_value = "close",
        name_len = 10,
        value_len = 5 }
    ensure
      nlen_10: Result.name_byte_length = 10
      vlen_5: Result.value_byte_length = 5
    end

  -- `b` with an ASCII capital letter made small; any other byte is itself.
  fold_byte(b: U64): U64
    do
      if b >= 65 and b <= 90 then b + 32 else b end
    end

  -- Whether `a` and `b` agree from `i` on, ignoring the case of ASCII letters.
  same_ci(a: BYTES, b: BYTES, i: NAT): BOOL
    variant
      a.length - i
    do
      if a.length != b.length then
        False
      else if i >= a.length then
        True
      else if HTTP_HEADER.fold_byte(a.at(i)) = HTTP_HEADER.fold_byte(b.at(i)) then
        HTTP_HEADER.same_ci(a, b, i + 1)
      else
        False
      end end end
    ensure
      same_length: Result implies a.length = b.length
    end

  -- Bytes that are the same are the same ignoring case.
  same_ci_equal(a: BYTES, b: BYTES, i: NAT): BOOL
    require
      same: a.model = b.model
    variant
      a.length - i
    do
      if i >= a.length then
        True
      else
        check
          same_byte: a.at(i) = b.at(i)
          same_fold: HTTP_HEADER.fold_byte(a.at(i)) = HTTP_HEADER.fold_byte(b.at(i))
        end
        HTTP_HEADER.same_ci_equal(a, b, i + 1)
      end
    ensure
      holds: Result
      ci: HTTP_HEADER.same_ci(a, b, i)
    end

feature {ANY}

  name: STRING
    do
      Current.field_name
    ensure
      non_empty: Result.byte_length >= 1
      bounded: Result.byte_length <= 128
    end

  value: STRING
    do
      Current.field_value
    ensure
      bounded: Result.byte_length <= 1024
    end

  name_byte_length: NAT
    do
      Current.name_len
    ensure
      matches_str: Result = Current.name.byte_length
      in_range: Result >= 1 and Result <= 128
    end

  value_byte_length: NAT
    do
      Current.value_len
    ensure
      matches_str: Result = Current.value.byte_length
      bounded: Result <= 1024
    end

  -- Whether this field is named `key`. Field names ignore case (RFC 9110, section 5.1),
  -- so `content-type` names the field `Content-Type`.
  name_matches(key: STRING): BOOL
    do
      if Current.field_name.equals(key) then
        check
          ci: HTTP_HEADER.same_ci_equal(Current.field_name.to_utf8, key.to_utf8, 0)
        end
        HTTP_HEADER.same_ci(Current.field_name.to_utf8, key.to_utf8, 0)
      else
        HTTP_HEADER.same_ci(Current.field_name.to_utf8, key.to_utf8, 0)
      end
    ensure
      def: Result = HTTP_HEADER.same_ci(Current.name.to_utf8, key.to_utf8, 0)
      exact: Current.name.equals(key) implies Result
      same_length: Result implies Current.name_byte_length = key.byte_length
    end

  wire_byte_length: NAT
    do
      Current.name_len + 2 + Current.value_len + 2
    ensure
      def: Result = Current.name_byte_length + Current.value_byte_length + 4
      at_least_five: Result >= 5
      bounded: Result <= 1156
    end

  serialize_line: STRING
    do
      Current.field_name.concat(": ").concat(Current.field_value).concat("\r\n")
    ensure
      exact_wire_len: Result.byte_length = Current.wire_byte_length
      at_least_five: Result.byte_length >= 5
    end

  equals(other: HTTP_HEADER): BOOL
    do
      Current.field_name.equals(other.field_name) and Current.field_value.equals(other.field_value)
    ensure
      def: Result = (Current.name.equals(other.name) and Current.value.equals(other.value))
    end

specify {EQ}

  law reflexive(a: HTTP_HEADER)
    ensure
      refl: a.equals(a)
    end

  law symmetric(a: HTTP_HEADER, b: HTTP_HEADER)
    require
      ab: a.equals(b)
    ensure
      ba: b.equals(a)
    end

  law transitive(a: HTTP_HEADER, b: HTTP_HEADER, c: HTTP_HEADER)
    require
      ab: a.equals(b)
      bc: b.equals(c)
    ensure
      ac: a.equals(c)
    end

end
