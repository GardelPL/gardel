-- Verified HTTP/1.1 response domain model with RFC 9112 framing invariants. The
-- `Content-Length` it sends is computed from the body, never given by the caller.
module HTTP_RESPONSE

representation {NONE}
  resp_version: HTTP_VERSION
  resp_status: HTTP_STATUS
  status_num: NAT
  status_digits: STRING
  digits_len: NAT
  body_text: STRING
  body_len: NAT
  ctype: HTTP_CONTENT_TYPE

invariant
  status_num_matches: status_num = resp_status.status_code
  status_in_range: status_num >= 100 and status_num <= 599
  digits_len_matches: digits_len = status_digits.byte_length
  digits_exact_three: digits_len = 3
  body_len_matches: body_len = body_text.byte_length
  body_bounded: body_len <= 65536
  no_body_when_forbidden: resp_status.forbids_body implies (body_len = 0)

create {ANY}

  make_text(st: HTTP_STATUS, text_body: STRING): HTTP_RESPONSE
    require
      allows_body: not st.forbids_body
      body_fits: text_body.byte_length <= 65536
    do
      let d = st.code_digits
      { resp_version = Http11,
        resp_status = st,
        status_num = st.status_code,
        status_digits = d,
        digits_len = d.byte_length,
        body_text = text_body,
        body_len = text_body.byte_length,
        ctype = Unstated }
    ensure
      status_set: Result.status = st
      code_set: Result.response_status_code = st.status_code
      version_http11: Result.version = Http11
      body_len_set: Result.response_body_length = text_body.byte_length
    end

  ok_text(text_body: STRING): HTTP_RESPONSE
    require
      body_fits: text_body.byte_length <= 65536
    do
      { resp_version = Http11,
        resp_status = HTTP_STATUS.ok,
        status_num = 200,
        status_digits = "200",
        digits_len = 3,
        body_text = text_body,
        body_len = text_body.byte_length,
        ctype = Unstated }
    ensure
      is_200: Result.response_status_code = 200
      body_len_set: Result.response_body_length = text_body.byte_length
    end

  created_text(text_body: STRING): HTTP_RESPONSE
    require
      body_fits: text_body.byte_length <= 65536
    do
      { resp_version = Http11,
        resp_status = HTTP_STATUS.created,
        status_num = 201,
        status_digits = "201",
        digits_len = 3,
        body_text = text_body,
        body_len = text_body.byte_length,
        ctype = Unstated }
    ensure
      is_201: Result.response_status_code = 201
      body_len_set: Result.response_body_length = text_body.byte_length
    end

  not_found_empty: HTTP_RESPONSE
    do
      { resp_version = Http11,
        resp_status = HTTP_STATUS.not_found,
        status_num = 404,
        status_digits = "404",
        digits_len = 3,
        body_text = "",
        body_len = 0,
        ctype = Unstated }
    ensure
      is_404: Result.response_status_code = 404
      empty_body: Result.response_body_length = 0
    end

  method_not_allowed_empty: HTTP_RESPONSE
    do
      { resp_version = Http11,
        resp_status = HTTP_STATUS.method_not_allowed,
        status_num = 405,
        status_digits = "405",
        digits_len = 3,
        body_text = "",
        body_len = 0,
        ctype = Unstated }
    ensure
      is_405: Result.response_status_code = 405
      empty_body: Result.response_body_length = 0
    end

  no_content_empty: HTTP_RESPONSE
    do
      { resp_version = Http11,
        resp_status = HTTP_STATUS.no_content,
        status_num = 204,
        status_digits = "204",
        digits_len = 3,
        body_text = "",
        body_len = 0,
        ctype = Unstated }
    ensure
      is_204: Result.response_status_code = 204
      empty_body: Result.response_body_length = 0
    end

  make_empty(st: HTTP_STATUS): HTTP_RESPONSE
    do
      let d = st.code_digits
      { resp_version = Http11,
        resp_status = st,
        status_num = st.status_code,
        status_digits = d,
        digits_len = d.byte_length,
        body_text = "",
        body_len = 0,
        ctype = Unstated }
    ensure
      status_set: Result.status = st
      code_set: Result.response_status_code = st.status_code
      version_http11: Result.version = Http11
      empty_body: Result.response_body_length = 0
    end

  from_error(err: HTTP_ERROR): HTTP_RESPONSE
    do
      let st = err.to_status
      let d = st.code_digits
      { resp_version = Http11,
        resp_status = st,
        status_num = st.status_code,
        status_digits = d,
        digits_len = d.byte_length,
        body_text = "",
        body_len = 0,
        ctype = Unstated }
    ensure
      is_err: Result.status.is_client_error or Result.status.is_server_error
      empty_body: Result.response_body_length = 0
    end

feature {ANY}

  version: HTTP_VERSION
    do
      Current.resp_version
    end

  status: HTTP_STATUS
    do
      Current.resp_status
    end

  response_status_code: NAT
    do
      Current.status_num
    ensure
      matches_status: Result = Current.status.status_code
      in_range: Result >= 100 and Result <= 599
    end

  status_digits_string: STRING
    do
      Current.status_digits
    ensure
      exact_three: Result.byte_length = 3
    end

  body_string: STRING
    do
      Current.body_text
    ensure
      exact_len: Result.byte_length = Current.response_body_length
      bounded: Result.byte_length <= 65536
      forbidden_implies_zero: Current.status.forbids_body implies (Result.byte_length = 0)
    end

  body: BYTES
    do
      Current.body_text.to_utf8
    ensure
      exact_len: Result.length = Current.response_body_length
      bounded: Result.length <= 65536
    end

  -- The media type stated in `Content-Type`; `Unstated` unless `with_content_type` set it.
  content_type: HTTP_CONTENT_TYPE
    do
      Current.ctype
    end

  -- The same response, stating the media type `t`.
  with_content_type(t: HTTP_CONTENT_TYPE): HTTP_RESPONSE
    do
      { Current with ctype = t }
    ensure
      type_set: Result.content_type = t
      status_same: Result.response_status_code = Current.response_status_code
      body_same: Result.response_body_length = Current.response_body_length
      body_text_same: Result.body_string.byte_model = Current.body_string.byte_model
    end

  response_body_length: NAT
    do
      Current.body_len
    ensure
      bounded: Result <= 65536
      forbidden_implies_zero: Current.status.forbids_body implies (Result = 0)
    end

  -- The `Content-Length` field value: the body's length in decimal, worked out here so it
  -- cannot disagree with the body.
  content_length_header_value: STRING
    do
      NUMBER_TEXT.nat_to_text(Current.body_len)
    ensure
      says_body: NUMBER_TEXT.parse_nat(Result) = Ok(Current.response_body_length)
      matches_cl_len: Result.byte_length = Current.content_length_digits_len
      non_empty: Result.byte_length >= 1
      bounded: Result.byte_length <= 10
    end

  content_length_digits_len: NAT
    do
      NUMBER_TEXT.digit_count(Current.body_len)
    ensure
      in_range: Result >= 1 and Result <= 10
    end

end
