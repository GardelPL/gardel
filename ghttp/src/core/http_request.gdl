-- Verified HTTP/1.1 request domain model (RFC 9110 / RFC 9112).
module HTTP_REQUEST

representation {NONE}
  req_method: HTTP_METHOD
  req_target: STRING
  target_len: NAT
  req_version: HTTP_VERSION
  req_headers: HTTP_HEADERS
  hdr_count: NAT
  req_body: BYTES
  body_len: NAT
  max_body: NAT

invariant
  target_len_matches: target_len = req_target.byte_length
  target_non_empty: target_len >= 1
  target_bounded: target_len <= 512
  hdr_count_matches: hdr_count = req_headers.num_headers
  hdr_count_bounded: hdr_count <= 64
  body_len_matches: body_len = req_body.length
  body_within_limit: body_len <= max_body
  max_body_bounded: max_body <= 65536
  safe_method_empty_body: req_method.is_safe implies (body_len = 0)

create {ANY}

  make(m: HTTP_METHOD, t: STRING, v: HTTP_VERSION, hs: HTTP_HEADERS, b: BYTES, body_limit: NAT): HTTP_REQUEST
    require
      target_present: t.byte_length >= 1
      target_fits: t.byte_length <= 512
      hdrs_fit: hs.num_headers <= 64
      limit_ok: body_limit <= 65536
      body_fits: b.length <= body_limit
      safe_no_body: m.is_safe implies (b.length = 0)
    do
      { req_method = m,
        req_target = t,
        target_len = t.byte_length,
        req_version = v,
        req_headers = hs,
        hdr_count = hs.num_headers,
        req_body = b,
        body_len = b.length,
        max_body = body_limit }
    ensure
      method_set: Result.method = m
      target_set: Result.target.equals(t)
      tlen_set: Result.target_byte_length = t.byte_length
      version_set: Result.version = v
      hcount_set: Result.request_header_count = hs.num_headers
      body_set: Result.body.model = b.model
      body_len_set: Result.request_body_length = b.length
      limit_set: Result.request_body_limit = body_limit
    end

  make_simple(m: HTTP_METHOD, t: STRING): HTTP_REQUEST
    require
      target_present: t.byte_length >= 1
      target_fits: t.byte_length <= 512
    do
      { req_method = m,
        req_target = t,
        target_len = t.byte_length,
        req_version = Http11,
        req_headers = HTTP_HEADERS.default_empty,
        hdr_count = 0,
        req_body = BYTES.empty,
        body_len = 0,
        max_body = 4096 }
    ensure
      method_set: Result.method = m
      target_set: Result.target.equals(t)
      tlen_set: Result.target_byte_length = t.byte_length
      is_http11: Result.version = Http11
      zero_hdrs: Result.request_header_count = 0
      empty_body: Result.request_body_length = 0
      limit_4096: Result.request_body_limit = 4096
    end

  -- What a request line gives: no headers and no body yet.
  make_line(m: HTTP_METHOD, t: STRING, v: HTTP_VERSION): HTTP_REQUEST
    require
      target_present: t.byte_length >= 1
      target_fits: t.byte_length <= 512
    do
      { req_method = m,
        req_target = t,
        target_len = t.byte_length,
        req_version = v,
        req_headers = HTTP_HEADERS.default_empty,
        hdr_count = 0,
        req_body = BYTES.empty,
        body_len = 0,
        max_body = 0 }
    ensure
      method_set: Result.method = m
      target_set: Result.target.equals(t)
      version_set: Result.version = v
      zero_hdrs: Result.request_header_count = 0
      empty_body: Result.request_body_length = 0
    end

feature {ANY}

  method: HTTP_METHOD
    do
      Current.req_method
    end

  -- The request target exactly as it was received, such as `/users/42?x=1`.
  target: STRING
    do
      Current.req_target
    ensure
      non_empty: Result.byte_length >= 1
      bounded: Result.byte_length <= 512
    end

  target_byte_length: NAT
    do
      Current.target_len
    ensure
      matches_str: Result = Current.target.byte_length
      in_range: Result >= 1 and Result <= 512
    end

  -- True iff the request target is byte-for-byte equal to `path`.
  target_equals(path: STRING): BOOL
    do
      Current.req_target.equals(path)
    ensure
      def: Result = Current.target.equals(path)
    end

  -- True iff the request target starts with `prefix` (for parameterized routes).
  target_starts_with(prefix: STRING): BOOL
    do
      Current.req_target.starts_with(prefix)
    ensure
      def: Result = Current.target.starts_with(prefix)
    end

  version: HTTP_VERSION
    do
      Current.req_version
    end

  headers: HTTP_HEADERS
    do
      Current.req_headers
    ensure
      headers_bounded: Result.num_headers <= 64
    end

  request_header_count: NAT
    do
      Current.hdr_count
    ensure
      matches_hdrs: Result = Current.headers.num_headers
      bounded: Result <= 64
    end

  body: BYTES
    do
      Current.req_body
    ensure
      len: Result.length = Current.request_body_length
    end

  request_body_length: NAT
    do
      Current.body_len
    ensure
      within_limit: Result <= Current.request_body_limit
      bounded: Result <= 65536
      safe_empty: Current.method.is_safe implies (Result = 0)
    end

  request_body_limit: NAT
    do
      Current.max_body
    ensure
      bounded: Result <= 65536
    end

  -- The same request with the headers `hs`.
  with_headers(hs: HTTP_HEADERS): HTTP_REQUEST
    do
      { Current with req_headers = hs, hdr_count = hs.num_headers }
    ensure
      method_same: Result.method = Current.method
      target_same: Result.target.equals(Current.target)
      version_same: Result.version = Current.version
      hcount_set: Result.request_header_count = hs.num_headers
      body_same: Result.request_body_length = Current.request_body_length
    end

  -- The same request with the body `b`, of at most `limit` bytes.
  with_body(b: BYTES, limit: NAT): HTTP_REQUEST
    require
      limit_ok: limit <= 65536
      body_fits: b.length <= limit
      safe_no_body: Current.method.is_safe implies (b.length = 0)
    do
      { Current with req_body = b, body_len = b.length, max_body = limit }
    ensure
      method_same: Result.method = Current.method
      target_same: Result.target.equals(Current.target)
      version_same: Result.version = Current.version
      hcount_same: Result.request_header_count = Current.request_header_count
      body_set: Result.body.model = b.model
      body_len_set: Result.request_body_length = b.length
      limit_set: Result.request_body_limit = limit
    end

end
