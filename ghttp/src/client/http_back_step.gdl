-- Stage D of the round trip: the step of `HTTP_READ_BACK.reads_back`, from what it says
-- of the tail. Apart from the laws it uses and from the induction that uses it.
functions HTTP_BACK_STEP

specify {ANY}

  -- The step of `reads_back`, from what it says of the tail.
  law back_step(buf: BYTES, pos: NAT, he: NAT, hs: LIST[HTTP_HEADER], acc: HTTP_HEADERS, p: NAT, e: NAT)
    require
      ok: HTTP_REQUEST_WRITER.fields_ok(hs)
      some: hs.length > 0
      few: hs.length <= 64
      holds: forall k: NAT. (pos <= k and k < pos + HTTP_REQUEST_WRITER.fields_text(hs).byte_model.length) implies
        LIST_OPS.at(buf.model, k) = LIST_OPS.at(HTTP_REQUEST_WRITER.fields_text(hs).byte_model, k - pos)
      fits: pos + HTTP_REQUEST_WRITER.fields_text(hs).byte_model.length <= he + 2
      in_buf: he + 4 <= buf.length
      room: acc.num_headers + hs.length <= acc.max_headers
      small: pos <= 1000000000
      at: p = pos + HTTP_REQUEST_WRITER.fields_text(hs.tail).byte_model.length
      ends: e + 2 = p + hs.head.serialize_line.byte_model.length
      tail_count: HTTP_READ_FIELDS.reads(buf, pos, hs.tail, acc).num_headers = acc.num_headers + hs.tail.length
      tail_cap: HTTP_READ_FIELDS.reads(buf, pos, hs.tail, acc).max_headers = acc.max_headers
      tail_names: HTTP_READ_FIELD.names_of(HTTP_READ_FIELDS.reads(buf, pos, hs.tail, acc).fields) =
        HTTP_READ_FIELD.names_of(hs.tail).append(HTTP_READ_FIELD.names_of(acc.fields))
      tail_values: HTTP_READ_FIELD.values_of(HTTP_READ_FIELDS.reads(buf, pos, hs.tail, acc).fields) =
        HTTP_READ_FIELD.values_of(hs.tail).append(HTTP_READ_FIELD.values_of(acc.fields))
    do
      HTTP_REQUEST_WRITER.field_ok(hs.head) and
      HTTP_READ_FIELDS.text_step(hs) and
      HTTP_READ_FIELDS.split_holds(buf, pos, p, hs) and
      HTTP_READ_FIELD.room_after(HTTP_READ_FIELDS.reads(buf, pos, hs.tail, acc), acc, hs.tail.length) and
      HTTP_LINE_PLAIN.line_plain(buf, p, e, hs.head) and
      HTTP_READ_FIELDS.reads_step(buf, pos, hs, acc, p, e) and
      HTTP_READ_FIELD.add_counts(HTTP_READ_FIELDS.reads(buf, pos, hs.tail, acc), HTTP_HEAD_PARSER.field_at(buf, p, e).get) and
      HTTP_READ_FIELD.names_of(HTTP_READ_FIELDS.reads(buf, pos, hs, acc).fields) =
        HTTP_READ_FIELD.names_of(HTTP_READ_FIELDS.reads(buf, pos, hs.tail, acc).fields).prepend(hs.head.name.byte_model) and
      HTTP_READ_FIELD.values_of(HTTP_READ_FIELDS.reads(buf, pos, hs, acc).fields) =
        HTTP_READ_FIELD.values_of(HTTP_READ_FIELDS.reads(buf, pos, hs.tail, acc).fields).prepend(hs.head.value.byte_model)
    ensure
      count: HTTP_READ_FIELDS.reads(buf, pos, hs, acc).num_headers = acc.num_headers + hs.length
      cap: HTTP_READ_FIELDS.reads(buf, pos, hs, acc).max_headers = acc.max_headers
      names: HTTP_READ_FIELD.names_of(HTTP_READ_FIELDS.reads(buf, pos, hs, acc).fields) =
        HTTP_READ_FIELD.names_of(hs).append(HTTP_READ_FIELD.names_of(acc.fields))
      values: HTTP_READ_FIELD.values_of(HTTP_READ_FIELDS.reads(buf, pos, hs, acc).fields) =
        HTTP_READ_FIELD.values_of(hs).append(HTTP_READ_FIELD.values_of(acc.fields))
    end

end
