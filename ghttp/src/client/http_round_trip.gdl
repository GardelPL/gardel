-- What the request parser makes of what `HTTP_REQUEST_WRITER` writes (F.8, step 1): a
-- request reads back as itself. Proven in stages, as `gjson` did for its round trip:
--
-- * A, `request_line_reads_back`: the line the writer writes parses to the same method,
--   target and version.
-- * B, `body_reads_back`: after a head that declares the body's length, the framing gives
--   the same body and nothing after it.
-- * C, `line_end_found` and `head_end_found`: in bytes that start with the writer's head,
--   the parser's searches find the end of its request line and its blank line. The bytes'
--   shape is proven in `HTTP_WIRE_FACTS`, `HTTP_WRITER_LINES`, `HTTP_WRITER_FIELDS`,
--   `HTTP_HEAD_SHAPE`, `HTTP_HEAD_WHOLE` and `HTTP_WRITER_HEAD`, and carried over to the
--   bytes searched in `HTTP_WIRE_PREFIX`.
-- * D, `fields_read_back`: from there to the blank line, the parser reads the writer's
--   fields in order, then the `Content-Length` it adds. One field line read back is proven
--   in `HTTP_READ_FIELD`, `HTTP_READ_LINE`, `HTTP_LINE_PLAIN` and `HTTP_LINE_READS`, all of
--   them by induction in `HTTP_READ_BACK` and `HTTP_READ_STEPS` (whose steps are
--   `HTTP_BACK_STEP`, `HTTP_STEPS_STEP`, `HTTP_LINE_STEP` and `HTTP_READS_ADD`), and the
--   chain to the blank line in `HTTP_FIELDS_PART`, `HTTP_FIELDS_READ`, `HTTP_LENGTH_LAST`
--   and `HTTP_FIELDS_CHAIN`. For at most 31 fields of the request's own: the parser keeps
--   32 (`HTTP_HEADERS.default_empty`) and the writer may add `Content-Length`. The writer
--   accepts up to 64, and the parser refuses more than 32 in all (`TooManyHeaders`).
functions HTTP_ROUND_TRIP

specify {ANY}

  -- Stage A. Any bytes that start with the line that `line_text` writes parse, up to its end,
  -- to the same method, target and version.
  law request_line_reads_back(m: HTTP_METHOD, t: STRING, v: HTTP_VERSION, buf: BYTES)
    require
      target: HTTP_REQUEST_WRITER.target_ok(t)
      fits: t.byte_length <= 512
      prefix: buf.starts_with(HTTP_REQUEST_WRITER.line_text(m, t, v).to_utf8)
    do
      HTTP_METHOD.wire_no_space(m) and
      t.to_utf8.model = t.byte_model and
      HTTP_HEAD_PARSER.visible_bytes(t.to_utf8, 0, t.byte_length) and
      HTTP_REQUEST_WRITER.line_text(m, t, v).to_utf8.model = HTTP_REQUEST_WRITER.line_text(m, t, v).byte_model and
      -- The two spaces.
      LIST_OPS.at(buf.model, m.to_string.byte_length) = 32 and
      LIST_OPS.at(buf.model, m.to_string.byte_length + 1 + t.byte_length) = 32 and
      -- Where `request_line`'s cursor finds the two spaces.
      CURSOR.start(buf).input.model = buf.model and
      CURSOR.start(buf).offset = 0 and
      HTTP_HEAD_PARSER.word_ends_at(CURSOR.start(buf), m.to_string.byte_length) and
      HTTP_HEAD_PARSER.word_end(CURSOR.start(buf)).advance(1).offset = m.to_string.byte_length + 1 and
      HTTP_HEAD_PARSER.word_end(CURSOR.start(buf)).advance(1).input.model = buf.model and
      HTTP_HEAD_PARSER.word_ends_at(HTTP_HEAD_PARSER.word_end(CURSOR.start(buf)).advance(1),
        m.to_string.byte_length + 1 + t.byte_length) and
      -- The method, the target and the version, each read back from its bytes.
      BYTES.same_items(
        HTTP_HEAD_PARSER.word_end(CURSOR.start(buf)).since(CURSOR.start(buf)).model,
        m.to_string.byte_model) and
      HTTP_HEAD_PARSER.method_reads_back(m,
        HTTP_HEAD_PARSER.word_end(CURSOR.start(buf)).since(CURSOR.start(buf))) and
      BYTES.same_items(
        buf.slice(m.to_string.byte_length + 1, m.to_string.byte_length + 1 + t.byte_length).model,
        t.byte_model) and
      HTTP_HEAD_PARSER.visible_from(buf, m.to_string.byte_length + 1, m.to_string.byte_length + 1 + t.byte_length) and
      BYTES.same_items(
        buf.slice(m.to_string.byte_length + 2 + t.byte_length, m.to_string.byte_length + t.byte_length + 10).model,
        v.to_string.byte_model) and
      HTTP_HEAD_PARSER.version_reads_back(v,
        buf.slice(m.to_string.byte_length + 2 + t.byte_length, m.to_string.byte_length + t.byte_length + 10)) and
      -- The target.
      HTTP_HEAD_PARSER.target_of(buf, m.to_string.byte_length + 1, m.to_string.byte_length + 1 + t.byte_length).is_ok and
      HTTP_HEAD_PARSER.target_of(buf, m.to_string.byte_length + 1, m.to_string.byte_length + 1 + t.byte_length).get.equals(t)
    ensure
      reads: match HTTP_HEAD_PARSER.request_line(buf, HTTP_REQUEST_WRITER.line_text(m, t, v).byte_length)
        case Ok(q) then q.method = m and q.target.equals(t) and q.version = v
        case Error(_) then False
      end
    end

  -- Stage C, the line break. In bytes that start with the head the writer writes for `req`,
  -- the parser's search for the first line break finds the end of the writer's request line.
  law line_end_found(req: HTTP_REQUEST, buf: BYTES)
    require
      sendable: HTTP_REQUEST_WRITER.sendable(req)
      prefix: buf.starts_with(HTTP_REQUEST_WRITER.head_text(req).to_utf8)
    do
      HTTP_WRITER_HEAD.head_line(req) and
      HTTP_REQUEST_WRITER.head_text(req).to_utf8.model = HTTP_REQUEST_WRITER.head_text(req).byte_model and
      HTTP_WIRE_PREFIX.crlf_found(buf, HTTP_REQUEST_WRITER.head_text(req).to_utf8, HTTP_HEAD_PARSER.crlf,
        HTTP_REQUEST_WRITER.line_text(req.method, req.target, req.version).byte_length)
    ensure
      found: buf.index_of(HTTP_HEAD_PARSER.crlf, 0).is_some and
        buf.index_of(HTTP_HEAD_PARSER.crlf, 0).get = HTTP_REQUEST_WRITER.line_text(req.method, req.target, req.version).byte_length
    end

  -- Stage C, the blank line. From the end of the request line, the parser's search for the
  -- blank line finds the writer's, the last four bytes of the head.
  law head_end_found(req: HTTP_REQUEST, buf: BYTES)
    require
      sendable: HTTP_REQUEST_WRITER.sendable(req)
      prefix: buf.starts_with(HTTP_REQUEST_WRITER.head_text(req).to_utf8)
    do
      HTTP_WRITER_HEAD.head_blank(req) and HTTP_WRITER_HEAD.head_apart(req) and
      HTTP_REQUEST_WRITER.head_text(req).to_utf8.model = HTTP_REQUEST_WRITER.head_text(req).byte_model and
      HTTP_WIRE_PREFIX.blank_found(buf, HTTP_REQUEST_WRITER.head_text(req).to_utf8, HTTP_HEAD_PARSER.blank_line,
        HTTP_REQUEST_WRITER.line_text(req.method, req.target, req.version).byte_length,
        HTTP_REQUEST_WRITER.head_text(req).byte_length - 4)
    ensure
      found: buf.index_of(HTTP_HEAD_PARSER.blank_line, HTTP_REQUEST_WRITER.line_text(req.method, req.target, req.version).byte_length).is_some and
        buf.index_of(HTTP_HEAD_PARSER.blank_line, HTTP_REQUEST_WRITER.line_text(req.method, req.target, req.version).byte_length).get =
          HTTP_REQUEST_WRITER.head_text(req).byte_length - 4
    end

  -- Stage B. A head `h` that declares the length of the body `b` that follows it, as the
  -- writer's does, gives back `b`, and nothing after it, whatever request the head read.
  law body_reads_back(st: HTTP_PARSER_STATE, req: HTTP_REQUEST, h: BYTES, b: BYTES, cl: OPTION[NAT])
    require
      head_fits: h.length <= st.request_line_limit + st.header_limit
      body_fits: b.length <= st.body_limit
      declared: match cl case Some(n) then n = b.length case None then b.length = 0 end
      safe_empty: req.method.is_safe implies b.length = 0
    do
      h.concat(b).length = h.length + b.length and
      BYTES.same_items(h.concat(b).slice(h.length, h.length + b.length).model, b.model)
    ensure
      reads: match HTTP_FRAMING.frame(st, h.concat(b), req, cl, False, h.length)
        case Complete(q, rest) then
          rest.length = 0 and q.body.model = b.model and q.method = req.method and
          q.target.equals(req.target) and q.version = req.version and
          q.request_header_count = req.request_header_count
        case _ then False
      end
    end

  -- Stage D, the fields. In bytes that start with the head the writer writes for `req`, the
  -- parser reads the field lines, from after the request line to the blank line that stage C
  -- finds, as the writer's fields, their names and values in order, then the `Content-Length`
  -- the writer adds, if any, first, as `HTTP_HEADERS.add` puts the last field first, with
  -- the length it declares, and no `Transfer-Encoding`. The parser holds 32 fields, so a
  -- request with more than 31 of its own does not read back.
  law fields_read_back(req: HTTP_REQUEST, buf: BYTES)
    require
      sendable: HTTP_REQUEST_WRITER.sendable(req)
      prefix: buf.starts_with(HTTP_REQUEST_WRITER.head_text(req).to_utf8)
      few: req.headers.fields.length <= 31
    do
      HTTP_HEAD_FIELD_BYTES.parts_hold(req, buf) and
      HTTP_REQUEST_WRITER.head_text(req).byte_length = HTTP_REQUEST_WRITER.head_text(req).byte_model.length and
      HTTP_REQUEST_WRITER.line_text(req.method, req.target, req.version).byte_length = HTTP_REQUEST_WRITER.line_text(req.method, req.target, req.version).byte_model.length and
      HTTP_FIELDS_CHAIN.chain(req, buf, HTTP_REQUEST_WRITER.line_text(req.method, req.target, req.version).byte_length + 2,
        HTTP_REQUEST_WRITER.line_text(req.method, req.target, req.version).byte_length + 2 + HTTP_REQUEST_WRITER.fields_text(req.headers.fields).byte_model.length, HTTP_REQUEST_WRITER.head_text(req).byte_length - 4)
    ensure
      ok: HTTP_READ_FIELD.outcome_ok(HTTP_HEAD_PARSER.fields(buf, HTTP_REQUEST_WRITER.line_text(req.method, req.target, req.version).byte_length + 2, HTTP_REQUEST_WRITER.head_text(req).byte_length - 4, HTTP_HEADERS.default_empty, None, False))
      names: HTTP_READ_FIELD.outcome_names(HTTP_HEAD_PARSER.fields(buf, HTTP_REQUEST_WRITER.line_text(req.method, req.target, req.version).byte_length + 2, HTTP_REQUEST_WRITER.head_text(req).byte_length - 4, HTTP_HEADERS.default_empty, None, False)) =
        (if HTTP_REQUEST_WRITER.needs_length(req) then
          HTTP_READ_FIELD.names_of(req.headers.fields).prepend(HTTP_REQUEST_WRITER.content_length_field.byte_model)
        else
          HTTP_READ_FIELD.names_of(req.headers.fields)
        end)
      values: HTTP_READ_FIELD.outcome_values(HTTP_HEAD_PARSER.fields(buf, HTTP_REQUEST_WRITER.line_text(req.method, req.target, req.version).byte_length + 2, HTTP_REQUEST_WRITER.head_text(req).byte_length - 4, HTTP_HEADERS.default_empty, None, False)) =
        (if HTTP_REQUEST_WRITER.needs_length(req) then
          HTTP_READ_FIELD.values_of(req.headers.fields).prepend(NUMBER_TEXT.nat_to_text(req.request_body_length).byte_model)
        else
          HTTP_READ_FIELD.values_of(req.headers.fields)
        end)
      length: HTTP_READ_FIELD.outcome_length(HTTP_HEAD_PARSER.fields(buf, HTTP_REQUEST_WRITER.line_text(req.method, req.target, req.version).byte_length + 2, HTTP_REQUEST_WRITER.head_text(req).byte_length - 4, HTTP_HEADERS.default_empty, None, False)) =
        (if HTTP_REQUEST_WRITER.needs_length(req) then Some(req.request_body_length) else None end)
      chunked: not HTTP_READ_FIELD.outcome_chunked(HTTP_HEAD_PARSER.fields(buf, HTTP_REQUEST_WRITER.line_text(req.method, req.target, req.version).byte_length + 2, HTTP_REQUEST_WRITER.head_text(req).byte_length - 4, HTTP_HEADERS.default_empty, None, False))
    end

end
