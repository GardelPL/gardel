-- Incremental HTTP/1.1 request parser (RFC 9112).
--
-- The parser state keeps every byte received. Each `feed` appends the new chunk and parses
-- the whole buffer again, so the answer depends on the bytes alone, never on where TCP cut
-- them. A request is complete when its framing says so: the head ends at the first blank
-- line, and the body is exactly `Content-Length` bytes long.
functions HTTP_PARSER

feature {ANY}

  -- Appends `chunk` to the bytes received and parses them.
  feed(state: HTTP_PARSER_STATE, chunk: BYTES): HTTP_PARSE_RESULT
    do
      if chunk.length = 0 and state.buffered_bytes = 0 then
        Failed(EmptyRequest)
      else
        if chunk.length > 1048576 then
          Failed(BodyTooLarge)
        else
          parse_buffer(state, state.bytes_received.concat(chunk))
        end
      end
    ensure
      valid_result: Result.is_complete or Result.is_need_more or Result.is_failed
      -- Nothing received is lost: a state that waits for more holds all of it, in order,
      -- under the same limits.
      keeps_bytes: match Result
        case NeedMore(s) then
          s.bytes_received.model = state.bytes_received.model.append(chunk.model) and
          s.request_line_limit = state.request_line_limit and
          s.header_limit = state.header_limit and
          s.body_limit = state.body_limit
        case _ then True
      end
      faithful: (chunk.length <= 1048576 and not (chunk.length = 0 and state.buffered_bytes = 0)) implies
        HTTP_FRAMING.faithful(state, state.bytes_received.concat(chunk), Result)
    end

  -- One-shot parse convenience over a fresh default parser state.
  parse(raw: BYTES): HTTP_PARSE_RESULT
    do
      feed(HTTP_PARSER_STATE.make_default, raw)
    ensure
      valid_result: Result.is_complete or Result.is_need_more or Result.is_failed
    end

  -- Parses `buf`, all the bytes received, under the limits of `state`.
  parse_buffer(state: HTTP_PARSER_STATE, buf: BYTES): HTTP_PARSE_RESULT
    do
      match buf.index_of(HTTP_HEAD_PARSER.crlf, 0)
        case None then
          if buf.length > state.request_line_limit then
            Failed(RequestLineTooLong)
          else
            NeedMore(state.with_received(buf))
          end
        case Some(le) then
          if le > state.request_line_limit then
            Failed(RequestLineTooLong)
          else
            parse_head(state, buf, le)
          end
      end
    ensure
      sound: HTTP_FRAMING.faithful(state, buf, Result)
    end

  -- The request line ends at `le`. Looks for the blank line that ends the head.
  parse_head(state: HTTP_PARSER_STATE, buf: BYTES, le: NAT): HTTP_PARSE_RESULT
    require
      line_fits: le <= state.request_line_limit
      in_buf: le <= buf.length
    do
      match buf.index_of(HTTP_HEAD_PARSER.blank_line, le)
        case None then
          if buf.length > state.request_line_limit + state.header_limit then
            Failed(HeaderTooLarge)
          else
            NeedMore(state.with_received(buf))
          end
        case Some(he) then
          if he + 4 > state.request_line_limit + state.header_limit or he + 4 > buf.length then
            Failed(HeaderTooLarge)
          else
            match HTTP_HEAD_PARSER.request_line(buf, le)
              case Error(e) then
                Failed(e)
              case Ok(line) then
                match HTTP_HEAD_PARSER.parse_fields(buf, line, le + 2, he, HTTP_HEADERS.default_empty, None, False)
                  case Error(e) then
                    Failed(e)
                  case Ok(head) then
                    match head
                      case ParsedHead(req, cl, te) then HTTP_FRAMING.frame(state, buf, req, cl, te, he + 4)
                    end
                end
            end
          end
      end
    ensure
      sound: HTTP_FRAMING.faithful(state, buf, Result)
    end

end
