-- The bytes of a request received so far, and the limits it must stay within.
module HTTP_PARSER_STATE

representation {NONE}
  received: BYTES
  max_request_line: NAT
  max_header_bytes: NAT
  max_body_bytes: NAT

invariant
  req_line_limit_positive: max_request_line >= 16 and max_request_line <= 2048
  header_limit_positive: max_header_bytes >= 64 and max_header_bytes <= 8192
  body_limit_bounded: max_body_bytes <= 65536
  received_within_bounds: received.length <= max_request_line + max_header_bytes + max_body_bytes

create {ANY}

  make_default: HTTP_PARSER_STATE
    do
      { received = BYTES.empty,
        max_request_line = 512,
        max_header_bytes = 4096,
        max_body_bytes = 4096 }
    ensure
      empty_buf: Result.buffered_bytes = 0
      none_yet: Result.bytes_received.model = LIST.empty
      req_line_512: Result.request_line_limit = 512
      hdr_4096: Result.header_limit = 4096
      body_4096: Result.body_limit = 4096
      not_partial: not Result.is_waiting_for_more
    end

  make_with_limits(req_lim: NAT, hdr_lim: NAT, body_lim: NAT): HTTP_PARSER_STATE
    require
      req_ok: req_lim >= 16 and req_lim <= 2048
      hdr_ok: hdr_lim >= 64 and hdr_lim <= 8192
      body_ok: body_lim <= 65536
    do
      { received = BYTES.empty,
        max_request_line = req_lim,
        max_header_bytes = hdr_lim,
        max_body_bytes = body_lim }
    ensure
      empty_buf: Result.buffered_bytes = 0
      none_yet: Result.bytes_received.model = LIST.empty
      req_set: Result.request_line_limit = req_lim
      hdr_set: Result.header_limit = hdr_lim
      body_set: Result.body_limit = body_lim
    end

feature {ANY}

  -- Every byte received so far, in order.
  bytes_received: BYTES
    do
      Current.received
    ensure
      within_max: Result.length <= Current.max_total_bytes
    end

  buffered_bytes: NAT
    do
      Current.received.length
    ensure
      def: Result = Current.bytes_received.length
      within_max: Result <= Current.max_total_bytes
    end

  request_line_limit: NAT
    do
      Current.max_request_line
    ensure
      in_range: Result >= 16 and Result <= 2048
    end

  header_limit: NAT
    do
      Current.max_header_bytes
    ensure
      in_range: Result >= 64 and Result <= 8192
    end

  body_limit: NAT
    do
      Current.max_body_bytes
    ensure
      bounded: Result <= 65536
    end

  max_total_bytes: NAT
    do
      Current.max_request_line + Current.max_header_bytes + Current.max_body_bytes
    ensure
      def: Result = Current.request_line_limit + Current.header_limit + Current.body_limit
      bounded: Result <= 75776
    end

  is_waiting_for_more: BOOL
    do
      Current.received.length > 0
    ensure
      def: Result = (Current.buffered_bytes > 0)
    end

  -- The same limits, holding `bs` as the bytes received.
  with_received(bs: BYTES): HTTP_PARSER_STATE
    require
      fits: bs.length <= Current.max_total_bytes
    do
      { Current with received = bs }
    ensure
      bytes_set: Result.bytes_received.model = bs.model
      req_same: Result.request_line_limit = Current.request_line_limit
      hdr_same: Result.header_limit = Current.header_limit
      body_same: Result.body_limit = Current.body_limit
    end

end
