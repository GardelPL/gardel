-- Exhaustive routing outcome (M3).
module ROUTE_RESULT satisfies CANONICAL_EQ

representation {ANY}
  | Matched(endpoint_id: NAT, param_id: OPTION[NAT])
  | MethodNotAllowed
  | NotFound

feature {ANY}

  equals(other: ROUTE_RESULT): BOOL
    do
      Current = other
    ensure
      def: Result = (Current = other)
    end

  is_matched: BOOL
    do
      match Current
        case Matched(_, _) then True
        case _             then False
      end
    ensure
      def: Result = (match Current case Matched(_, _) then True case _ then False end)
    end

  is_method_not_allowed: BOOL
    do
      match Current
        case MethodNotAllowed then True
        case _                then False
      end
    ensure
      def: Result = (Current = MethodNotAllowed)
    end

  is_not_found: BOOL
    do
      match Current
        case NotFound then True
        case _        then False
      end
    ensure
      def: Result = (Current = NotFound)
    end

specify {CANONICAL_EQ}

  law agrees_with_structural(a: ROUTE_RESULT, b: ROUTE_RESULT)
    ensure
      sound: a.equals(b) = (a = b)
    end

specify {EQ}

  law reflexive(a: ROUTE_RESULT)
    ensure
      refl: a.equals(a)
    end

  law symmetric(a: ROUTE_RESULT, b: ROUTE_RESULT)
    require
      ab: a.equals(b)
    ensure
      ba: b.equals(a)
    end

  law transitive(a: ROUTE_RESULT, b: ROUTE_RESULT, c: ROUTE_RESULT)
    require
      ab: a.equals(b)
      bc: b.equals(c)
    ensure
      ac: a.equals(c)
    end

specify {ANY}

  law route_outcome_partition(r: ROUTE_RESULT)
    ensure
      trichotomy: r.is_matched or r.is_method_not_allowed or r.is_not_found
      disjoint_1: not (r.is_matched and r.is_method_not_allowed)
      disjoint_2: not (r.is_matched and r.is_not_found)
      disjoint_3: not (r.is_method_not_allowed and r.is_not_found)
    end

end

