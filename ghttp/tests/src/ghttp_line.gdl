-- One line of `cases.txt`, checked: which kind of case it is, and whether it holds.
--
-- In a module of its own, apart from `GHTTP_TEXT`, whose routines it calls: a proof assumes
-- the facts of every string literal its module's routines can reach, which for `check_line`
-- in `GHTTP_TEXT` was all 51 of them, and took nearly all the solver's resources. Here it
-- assumes the nine it names.
functions GHTTP_LINE

feature {ANY}

  -- 0 if a line of `cases.txt` holds, or is a comment, else 1 when the whole request gives
  -- something else, 2 when a cut of it does, 3 when a request it accepts, written without its
  -- framing, does not read back as itself, 4 when a `write` line does not hold, and 6, 7 or 8
  -- when an `exchange`, `again` or `cap` line does not.
  check_line(line: STRING): NAT
    do
      if line.code_point_count = 0 or line.starts_with("#") then
        0
      else if line.starts_with("exchange ") then
        GHTTP_TEXT.check_exchange(line.slice(9, line.code_point_count), False)
      else if line.starts_with("exchange-closed ") then
        GHTTP_TEXT.check_exchange(line.slice(16, line.code_point_count), True)
      else if line.starts_with("again ") then
        GHTTP_TEXT.check_again(line.slice(6, line.code_point_count))
      else if line.starts_with("cap ") then
        GHTTP_TEXT.check_cap(line.slice(4, line.code_point_count))
      else if line.starts_with("response ") then
        GHTTP_TEXT.check_response(line.slice(9, line.code_point_count), False)
      else if line.starts_with("closed ") then
        GHTTP_TEXT.check_response(line.slice(7, line.code_point_count), True)
      else if line.starts_with("write ") then
        match line.find(" => ", 0)
          case None then
            4
          case Some(i) then
            if i < 6 or i + 4 > line.code_point_count then
              4
            else
              GHTTP_TEXT.check_write(GHTTP_TEXT.unescape(line.slice(6, i).to_utf8, 0, BYTES_BUILDER.empty),
                GHTTP_TEXT.unescape(line.slice(i + 4, line.code_point_count).to_utf8, 0, BYTES_BUILDER.empty))
            end
        end
      else
        match line.find(" => ", 0)
          case None then
            1
          case Some(i) then
            if i + 4 > line.code_point_count then
              1
            else
              let raw = GHTTP_TEXT.unescape(line.slice(0, i).to_utf8, 0, BYTES_BUILDER.empty)
              let expected = line.slice(i + 4, line.code_point_count)
              let parsed = HTTP_PARSER.parse(raw)
              let whole = GHTTP_TEXT.describe(parsed)
              if not whole.equals(expected) then
                1
              else if raw.length > 0 and GHTTP_TEXT.first_bad_split(raw, whole, 1) != 0 then
                2
              else
                match parsed
                  case Complete(q, _) then
                    if HTTP_REQUEST_WRITER.sendable(GHTTP_TEXT.rewritten(q)) and not GHTTP_TEXT.reads_back(GHTTP_TEXT.rewritten(q)) then 3 else 0 end
                  case _ then
                    0
                end
              end end
            end
        end
      end end end end end end end end
    end

end
