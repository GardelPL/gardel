-- Sorting lists by an order (Task H.3).
--
-- `sort` is a merge sort, proven to give a `sorted` list of the same length that holds each
-- value as many times as its argument (`count`). `sorted` asks only that each item be at
-- most the next by `less_or_equal`, which `merge` keeps with no premise on the order.
--
-- The routines that run are loops (`take_onto`, `merge_onto` and `LIST_OPS.reverse_onto`),
-- as only a self tail call is a loop in C. Each is proven equal to the plain recursive
-- definition (`merged`, `LIST_OPS.take`) that the proofs reason about.
module SORTING[K: ORD]

specify {ANY}

  -- How many items of `xs` are `x` itself. A contract may compare with `=` on any type, so
  -- this counts values, even for a key whose `equals` is not `=`.
  count(xs: LIST[K], x: K): NAT
    variant
      xs.length
    do
      if xs.length = 0 then
        0
      else if xs.head = x then
        SORTING.count(xs.tail, x) + 1
      else
        SORTING.count(xs.tail, x)
      end end
    ensure
      at_most: Result <= xs.length
      empty_case: xs.length = 0 implies Result = 0
      same_case: xs.length > 0 and xs.head = x implies Result = SORTING.count(xs.tail, x) + 1
      other_case: xs.length > 0 and not (xs.head = x) implies Result = SORTING.count(xs.tail, x)
    end

  -- The merge that proofs reason about.
  merged(xs: LIST[K], ys: LIST[K]): LIST[K]
    variant
      xs.length + ys.length
    do
      if xs.length = 0 then
        ys
      else if ys.length = 0 then
        xs
      else if xs.head.less_or_equal(ys.head) then
        SORTING.merged(xs.tail, ys).prepend(xs.head)
      else
        SORTING.merged(xs, ys.tail).prepend(ys.head)
      end end end
    end

  -- In a sorted list the first item is at most every item. `ORD` alone does not say that
  -- `equals` and `less_than` agree, so this needs `equals` to be `=` (decision 5), as it is
  -- for every `CANONICAL_EQ` key.
  law first_least(xs: LIST[K], j: NAT)
    require
      ordered: SORTING.sorted(xs)
      inside: j < xs.length
      agrees: forall a: K. forall b: K. a.equals(b) = (a = b)
    do
      SORTING.least_fact(xs, j)
    ensure
      least: xs.head.less_or_equal(LIST_OPS.at(xs, j))
    end

create {ANY}

  -- Each item is at most the next.
  sorted(xs: LIST[K]): BOOL
    variant
      xs.length
    do
      if xs.length <= 1 then
        True
      else
        xs.head.less_or_equal(xs.tail.head) and SORTING.sorted(xs.tail)
      end
    end

  -- The items of `xs` and `ys`, in order when both are.
  merge(xs: LIST[K], ys: LIST[K]): LIST[K]
    do
      check
        onto: SORTING.merge_onto(xs, ys, LIST.empty) = LIST_OPS.reverse_onto(SORTING.merged(xs, ys), LIST.empty)
        back: SORTING.back_fact(SORTING.merged(xs, ys), LIST.empty, LIST.empty)
        counts: SORTING.merged_fact(xs, ys)
        ordered: SORTING.merged_sorted_fact(xs, ys)
      end
      LIST_OPS.reverse_onto(SORTING.merge_onto(xs, ys, LIST.empty), LIST.empty)
    ensure
      same: Result = SORTING.merged(xs, ys)
      same_length: Result.length = xs.length + ys.length
      ordered: SORTING.sorted(xs) and SORTING.sorted(ys) implies SORTING.sorted(Result)
      permutation: forall x: K. SORTING.count(Result, x) = SORTING.count(xs, x) + SORTING.count(ys, x)
    end

  -- The items of `xs` in order: a merge sort.
  sort(xs: LIST[K]): LIST[K]
    variant
      xs.length
    do
      if xs.length <= 1 then
        xs
      else
        let h = xs.length / 2
        let front = LIST_OPS.reverse_onto(SORTING.take_onto(xs, h, LIST.empty), LIST.empty)
        let back = LIST_OPS.drop(xs, h)
        check
          onto: SORTING.take_onto(xs, h, LIST.empty) = LIST_OPS.reverse_onto(LIST_OPS.take(xs, h), LIST.empty)
          twice: SORTING.back_fact(LIST_OPS.take(xs, h), LIST.empty, LIST.empty)
          front_is: front = LIST_OPS.take(xs, h)
          whole: LIST_OPS.take_drop(xs, h)
          counts: SORTING.count_append_fact(LIST_OPS.take(xs, h), LIST_OPS.drop(xs, h))
        end
        let a = SORTING.sort(front)
        let b = SORTING.sort(back)
        SORTING.merge(a, b)
      end
    ensure
      ordered: SORTING.sorted(Result)
      same_length: Result.length = xs.length
      permutation: forall x: K. SORTING.count(Result, x) = SORTING.count(xs, x)
    end

  -- The items of `a` in order: a merge sort on arrays, with the contract of `sort`. The
  -- halves are copied out with `slice` and sorted as parallel tasks, then merged into a new
  -- array that the merge changes in place. Like `sort`, it is stable.
  sort_array(a: ARRAY[K]): ARRAY[K]
    variant
      a.length
    do
      if a.length <= 1 then
        a
      else
        let n = a.length
        let h = n / 2
        check
          front: LIST_OPS.drop(a.to_list, 0) = a.to_list
          back: LIST_OPS.take(LIST_OPS.drop(a.to_list, h), n - h) = LIST_OPS.drop(a.to_list, h)
          whole: LIST_OPS.take_drop(a.to_list, h)
          counts: SORTING.count_append_fact(LIST_OPS.take(a.to_list, h), LIST_OPS.drop(a.to_list, h))
        end
        let x = SORTING.sort_array(a.slice(0, h))
        let y = SORTING.sort_array(a.slice(h, n))
        SORTING.merge_arrays(x, y)
      end
    ensure
      ordered: SORTING.sorted(Result.to_list)
      same_length: Result.length = a.length
      permutation: forall x: K. SORTING.count(Result.to_list, x) = SORTING.count(a.to_list, x)
    end

  -- The first position in sorted `a` whose item is not below `k`: every item before it is
  -- below `k`, and none after it is. It is where `k` goes to keep `a` sorted. As for
  -- `first_least`, `equals` must be `=`.
  lower_bound(a: ARRAY[K], k: K): NAT
    require
      ordered: SORTING.sorted(a.to_list)
      agrees: forall p: K. forall q: K. p.equals(q) = (p = q)
    do
      SORTING.bound_from(a, k, 0, a.length)
    ensure
      inside: Result <= a.length
      below: forall i: NAT. i < Result implies a.at(i).less_than(k)
      not_below: forall i: NAT. (Result <= i and i < a.length) implies not a.at(i).less_than(k)
    end

  -- A position of `k` in sorted `a`, or `None` when no item is `k`: a binary search.
  binary_search(a: ARRAY[K], k: K): OPTION[NAT]
    require
      ordered: SORTING.sorted(a.to_list)
      agrees: forall p: K. forall q: K. p.equals(q) = (p = q)
    do
      let i = SORTING.lower_bound(a, k)
      if i = a.length then
        None
      else if a.at(i).equals(k) then
        Some(i)
      else
        check
          greater: k.less_than(a.at(i))
          above: SORTING.above_fact(a.to_list, i, k)
        end
        None
      end end
    ensure
      found: Result.is_some implies (Result.get < a.length and a.at(Result.get) = k)
      absent: Result.is_none implies (forall p: NAT. p < a.length implies a.at(p) != k)
    end

create {NONE}

  least_fact(xs: LIST[K], j: NAT): BOOL
    require
      ordered: SORTING.sorted(xs)
      inside: j < xs.length
      agrees: forall a: K. forall b: K. a.equals(b) = (a = b)
    variant
      j
    do
      if j = 0 then
        xs.head.equals(xs.head)
      else
        check
          cons: xs.tail.prepend(xs.head) = xs
          step: SORTING.least_fact(xs.tail, j - 1)
        end
        True
      end
    ensure
      holds: Result
      least: xs.head.less_or_equal(LIST_OPS.at(xs, j))
    end

  -- The first `n` items of `xs`, reversed in front of `acc`, as a loop.
  take_onto(xs: LIST[K], n: NAT, acc: LIST[K]): LIST[K]
    variant
      n
    do
      if n = 0 or xs.length = 0 then
        acc
      else
        SORTING.take_onto(xs.tail, n - 1, acc.prepend(xs.head))
      end
    ensure
      same: Result = LIST_OPS.reverse_onto(LIST_OPS.take(xs, n), acc)
    end

  count_append_fact(xs: LIST[K], ys: LIST[K]): BOOL
    variant
      xs.length
    do
      if xs.length = 0 then
        True
      else
        check
          split: xs.append(ys) = xs.tail.append(ys).prepend(xs.head)
          step: SORTING.count_append_fact(xs.tail, ys)
        end
        True
      end
    ensure
      holds: Result
      adds: forall x: K. SORTING.count(xs.append(ys), x) = SORTING.count(xs, x) + SORTING.count(ys, x)
    end

  merged_fact(xs: LIST[K], ys: LIST[K]): BOOL
    variant
      xs.length + ys.length
    do
      if xs.length = 0 or ys.length = 0 then
        True
      else if xs.head.less_or_equal(ys.head) then
        SORTING.merged_fact(xs.tail, ys)
      else
        SORTING.merged_fact(xs, ys.tail)
      end end
    ensure
      holds: Result
      same_length: SORTING.merged(xs, ys).length = xs.length + ys.length
      adds: forall x: K. SORTING.count(SORTING.merged(xs, ys), x) = SORTING.count(xs, x) + SORTING.count(ys, x)
    end

  merged_sorted_fact(xs: LIST[K], ys: LIST[K]): BOOL
    variant
      xs.length + ys.length
    do
      if xs.length = 0 or ys.length = 0 then
        True
      else if xs.head.less_or_equal(ys.head) then
        SORTING.merged_sorted_fact(xs.tail, ys)
      else
        check
          other: ys.head.less_or_equal(xs.head)
        end
        SORTING.merged_sorted_fact(xs, ys.tail)
      end end
    ensure
      holds: Result
      ordered: SORTING.sorted(xs) and SORTING.sorted(ys) implies SORTING.sorted(SORTING.merged(xs, ys))
      first: xs.length > 0 and ys.length > 0 implies
        (SORTING.merged(xs, ys).head = xs.head or SORTING.merged(xs, ys).head = ys.head)
    end

  -- Reversing twice: `xs` reversed onto `acc`, reversed onto `ys`, is `acc` reversed onto
  -- `xs` then `ys`.
  back_fact(xs: LIST[K], acc: LIST[K], ys: LIST[K]): BOOL
    variant
      xs.length
    do
      if xs.length = 0 then
        True
      else
        check
          cons: xs.tail.prepend(xs.head) = xs
          split: xs.append(ys) = xs.tail.append(ys).prepend(xs.head)
          step: SORTING.back_fact(xs.tail, acc.prepend(xs.head), ys)
        end
        True
      end
    ensure
      holds: Result
      back: LIST_OPS.reverse_onto(LIST_OPS.reverse_onto(xs, acc), ys) = LIST_OPS.reverse_onto(acc, xs.append(ys))
    end

  -- `merged(xs, ys)` reversed in front of `acc`, as a loop.
  merge_onto(xs: LIST[K], ys: LIST[K], acc: LIST[K]): LIST[K]
    variant
      xs.length + ys.length
    do
      if xs.length = 0 then
        LIST_OPS.reverse_onto(ys, acc)
      else if ys.length = 0 then
        LIST_OPS.reverse_onto(xs, acc)
      else if xs.head.less_or_equal(ys.head) then
        SORTING.merge_onto(xs.tail, ys, acc.prepend(xs.head))
      else
        SORTING.merge_onto(xs, ys.tail, acc.prepend(ys.head))
      end end end
    ensure
      same: Result = LIST_OPS.reverse_onto(SORTING.merged(xs, ys), acc)
    end

  -- `merged(x, y)` as a new array. In C the merge writes into the array it makes, in place.
  merge_arrays(x: ARRAY[K], y: ARRAY[K]): ARRAY[K]
    require
      fits: x.length + y.length <= 18446744073709551615
    do
      if x.length = 0 then
        y
      else
        let out = ARRAY.make(x.length + y.length, x.at(0))
        check
          start: LIST_OPS.take(out.to_list, 0).append(SORTING.merged(LIST_OPS.drop(x.to_list, 0), LIST_OPS.drop(y.to_list, 0))) = SORTING.merged(x.to_list, y.to_list)
        end
        SORTING.merge_into(x, y, out, 0, 0)
      end
    ensure
      same: Result.to_list = SORTING.merged(x.to_list, y.to_list)
      same_length: Result.length = x.length + y.length
      counts: SORTING.merged_fact(x.to_list, y.to_list)
      sorts: SORTING.merged_sorted_fact(x.to_list, y.to_list)
    end

  -- The merge of what is left of `x` from `i` and of `y` from `j`, written into `out` from
  -- `i + j`, where the merge so far is.
  merge_into(x: ARRAY[K], y: ARRAY[K], out: ARRAY[K], i: NAT, j: NAT): ARRAY[K]
    require
      x_inside: i <= x.length
      y_inside: j <= y.length
      size: out.length = x.length + y.length
      fits: x.length + y.length <= 18446744073709551615
      so_far: LIST_OPS.take(out.to_list, i + j).append(SORTING.merged(LIST_OPS.drop(x.to_list, i), LIST_OPS.drop(y.to_list, j))) = SORTING.merged(x.to_list, y.to_list)
    variant
      (x.length - i) + (y.length - j)
    do
      if i = x.length and j = y.length then
        check
          all: LIST_OPS.take(out.to_list, i + j) = out.to_list
        end
        out
      else if j = y.length then
        check
          step: LIST_OPS.drop_step(x.to_list, i)
          one: SORTING.merged(LIST_OPS.drop(x.to_list, i), LIST_OPS.drop(y.to_list, j)) = SORTING.merged(LIST_OPS.drop(x.to_list, i + 1), LIST_OPS.drop(y.to_list, j)).prepend(x.at(i))
          grows: LIST_OPS.take_update(out.to_list, i + j, x.at(i))
        end
        SORTING.merge_into(x, y, out.set(i + j, x.at(i)), i + 1, j)
      else if i = x.length then
        check
          step: LIST_OPS.drop_step(y.to_list, j)
          one: SORTING.merged(LIST_OPS.drop(x.to_list, i), LIST_OPS.drop(y.to_list, j)) = SORTING.merged(LIST_OPS.drop(x.to_list, i), LIST_OPS.drop(y.to_list, j + 1)).prepend(y.at(j))
          grows: LIST_OPS.take_update(out.to_list, i + j, y.at(j))
        end
        SORTING.merge_into(x, y, out.set(i + j, y.at(j)), i, j + 1)
      else if x.at(i).less_or_equal(y.at(j)) then
        check
          x_step: LIST_OPS.drop_step(x.to_list, i)
          y_step: LIST_OPS.drop_step(y.to_list, j)
          one: SORTING.merged(LIST_OPS.drop(x.to_list, i), LIST_OPS.drop(y.to_list, j)) = SORTING.merged(LIST_OPS.drop(x.to_list, i + 1), LIST_OPS.drop(y.to_list, j)).prepend(x.at(i))
          grows: LIST_OPS.take_update(out.to_list, i + j, x.at(i))
        end
        SORTING.merge_into(x, y, out.set(i + j, x.at(i)), i + 1, j)
      else
        check
          x_step: LIST_OPS.drop_step(x.to_list, i)
          y_step: LIST_OPS.drop_step(y.to_list, j)
          one: SORTING.merged(LIST_OPS.drop(x.to_list, i), LIST_OPS.drop(y.to_list, j)) = SORTING.merged(LIST_OPS.drop(x.to_list, i), LIST_OPS.drop(y.to_list, j + 1)).prepend(y.at(j))
          grows: LIST_OPS.take_update(out.to_list, i + j, y.at(j))
        end
        SORTING.merge_into(x, y, out.set(i + j, y.at(j)), i, j + 1)
      end end end end
    ensure
      same: Result.to_list = SORTING.merged(x.to_list, y.to_list)
      same_length: Result.length = x.length + y.length
    end

  -- The binary search of `lower_bound` in `lo` to `hi`. What it says of the items outside is
  -- the caller's: a `forall` in a `require` would guard this routine's contract, and the
  -- solver seldom proves such a guard.
  bound_from(a: ARRAY[K], k: K, lo: NAT, hi: NAT): NAT
    require
      ordered: SORTING.sorted(a.to_list)
      agrees: forall p: K. forall q: K. p.equals(q) = (p = q)
      window: lo <= hi
      inside: hi <= a.length
    variant
      hi - lo
    do
      if lo = hi then
        lo
      else
        let mid = lo + (hi - lo) / 2
        if a.at(mid).less_than(k) then
          check
            left: SORTING.below_fact(a.to_list, mid, k)
          end
          SORTING.bound_from(a, k, mid + 1, hi)
        else
          check
            right: SORTING.not_below_fact(a.to_list, mid, k)
          end
          SORTING.bound_from(a, k, lo, mid)
        end
      end
    ensure
      inside: lo <= Result and Result <= hi
      below: forall i: NAT. (lo <= i and i < Result) implies a.at(i).less_than(k)
      not_below: forall i: NAT. (Result <= i and i < hi) implies not a.at(i).less_than(k)
    end

  -- Each item of a sorted list is at most the next.
  neighbour_fact(xs: LIST[K], j: NAT): BOOL
    require
      ordered: SORTING.sorted(xs)
      inside: j + 1 < xs.length
    variant
      j
    do
      if j = 0 then
        True
      else
        check
          tail_ordered: SORTING.sorted(xs.tail)
          step: SORTING.neighbour_fact(xs.tail, j - 1)
        end
        True
      end
    ensure
      holds: Result
      next: LIST_OPS.at(xs, j).less_or_equal(LIST_OPS.at(xs, j + 1))
    end

  -- In a sorted list, every item up to one below `k` is below `k`.
  below_fact(xs: LIST[K], j: NAT, k: K): BOOL
    require
      ordered: SORTING.sorted(xs)
      agrees: forall p: K. forall q: K. p.equals(q) = (p = q)
      inside: j < xs.length
      below: LIST_OPS.at(xs, j).less_than(k)
    variant
      j
    do
      if j = 0 then
        True
      else
        check
          next: SORTING.neighbour_fact(xs, j - 1)
          before: LIST_OPS.at(xs, j - 1).less_than(k)
          step: SORTING.below_fact(xs, j - 1, k)
        end
        True
      end
    ensure
      holds: Result
      all_below: forall i: NAT. i <= j implies LIST_OPS.at(xs, i).less_than(k)
    end

  -- In a sorted list, no item from one not below `k` on is below `k`.
  not_below_fact(xs: LIST[K], j: NAT, k: K): BOOL
    require
      ordered: SORTING.sorted(xs)
      agrees: forall p: K. forall q: K. p.equals(q) = (p = q)
      inside: j < xs.length
      small: j < 18446744073709551615
      not_below: not LIST_OPS.at(xs, j).less_than(k)
    variant
      xs.length - j
    do
      if xs.length - j = 1 then
        True
      else
        check
          next: SORTING.neighbour_fact(xs, j)
          after: not LIST_OPS.at(xs, j + 1).less_than(k)
          step: SORTING.not_below_fact(xs, j + 1, k)
        end
        True
      end
    ensure
      holds: Result
      none_below: forall i: NAT. (j <= i and i < xs.length) implies not LIST_OPS.at(xs, i).less_than(k)
    end

  -- In a sorted list, every item from one above `k` on is above `k`.
  above_fact(xs: LIST[K], j: NAT, k: K): BOOL
    require
      ordered: SORTING.sorted(xs)
      agrees: forall p: K. forall q: K. p.equals(q) = (p = q)
      inside: j < xs.length
      small: j < 18446744073709551615
      above: k.less_than(LIST_OPS.at(xs, j))
    variant
      xs.length - j
    do
      if xs.length - j = 1 then
        True
      else
        check
          next: SORTING.neighbour_fact(xs, j)
          after: k.less_than(LIST_OPS.at(xs, j + 1))
          step: SORTING.above_fact(xs, j + 1, k)
        end
        True
      end
    ensure
      holds: Result
      all_above: forall i: NAT. (j <= i and i < xs.length) implies k.less_than(LIST_OPS.at(xs, i))
    end

end
