-- A finite map from keys to values (Task F.3).
--
-- A client sees `get`, `put`, `remove`, `size`, `keys`, `values` and `fold`, and the laws
-- below, which state what `get` says after each change. Keys are compared with `K`'s
-- `equals` and ordered by its `less_than`.
--
-- The representation is hidden: the keys in ascending order and their values beside them
-- (decision 4 of the libraries plan). Each operation walks the list, so `get`, `put` and
-- `remove` take time linear in the size. A balanced tree can replace the lists without a
-- change to any contract.
--
-- `ORD` does not promise that `less_than` agrees with `equals`. So `remove` drops every key
-- equal to the one given, and the laws rest on the `EQ` and `ORD` laws alone.
module MAP[K: ORD, V]

representation {NONE}
  ks: LIST[K]
  vs: LIST[V]

invariant
  same_length: ks.length = vs.length
  sorted: KEY_ORDER.ascending(ks)

create {ANY}

  empty: MAP[K, V]
    do
      { ks = LIST.empty, vs = LIST.empty }
    ensure
      no_keys: Result.size = 0
    end

create {NONE}

  -- The value beside the first key of `xs` equal to `k`.
  find(xs: LIST[K], ys: LIST[V], k: K): OPTION[V]
    variant
      xs.length
    do
      if xs.length = 0 or ys.length = 0 then
        None
      else if xs.head.equals(k) then
        Some(ys.head)
      else
        MAP.find(xs.tail, ys.tail, k)
      end end
    end

  -- `ys` changed as `KEY_ORDER.put_keys(xs, k)` changes `xs`, with `v` beside `k`.
  put_values(xs: LIST[K], ys: LIST[V], k: K, v: V): LIST[V]
    variant
      xs.length
    do
      if xs.length = 0 or ys.length = 0 then
        LIST.empty.prepend(v)
      else if xs.head.equals(k) then
        ys.tail.prepend(v)
      else if k.less_than(xs.head) then
        ys.prepend(v)
      else
        MAP.put_values(xs.tail, ys.tail, k, v).prepend(ys.head)
      end end end
    end

  -- `ys` changed as `KEY_ORDER.remove_keys(xs, k)` changes `xs`.
  remove_values(xs: LIST[K], ys: LIST[V], k: K): LIST[V]
    variant
      xs.length
    do
      if xs.length = 0 or ys.length = 0 then
        ys
      else if xs.head.equals(k) then
        MAP.remove_values(xs.tail, ys.tail, k)
      else
        MAP.remove_values(xs.tail, ys.tail, k).prepend(ys.head)
      end end
    end

  fold_entries[B](xs: LIST[K], ys: LIST[V], f: (acc: B, k: K, v: V) -> B, acc: B): B
    variant
      xs.length
    do
      if xs.length = 0 or ys.length = 0 then
        acc
      else
        MAP.fold_entries(xs.tail, ys.tail, f, f(acc, xs.head, ys.head))
      end
    end

  -- The keys of the entries `p` holds for, and their values.
  kept_keys(xs: LIST[K], ys: LIST[V], p: (k: K, v: V) -> BOOL): LIST[K]
    variant
      xs.length
    do
      if xs.length = 0 or ys.length = 0 then
        LIST.empty
      else if p(xs.head, ys.head) then
        MAP.kept_keys(xs.tail, ys.tail, p).prepend(xs.head)
      else
        MAP.kept_keys(xs.tail, ys.tail, p)
      end end
    end

  kept_values(xs: LIST[K], ys: LIST[V], p: (k: K, v: V) -> BOOL): LIST[V]
    variant
      xs.length
    do
      if xs.length = 0 or ys.length = 0 then
        LIST.empty
      else if p(xs.head, ys.head) then
        MAP.kept_values(xs.tail, ys.tail, p).prepend(ys.head)
      else
        MAP.kept_values(xs.tail, ys.tail, p)
      end end
    end

  -- `f` of each entry.
  mapped_values[W](xs: LIST[K], ys: LIST[V], f: (k: K, v: V) -> W): LIST[W]
    variant
      xs.length
    do
      if xs.length = 0 or ys.length = 0 then
        LIST.empty
      else
        MAP.mapped_values(xs.tail, ys.tail, f).prepend(f(xs.head, ys.head))
      end
    end

  -- Lemmas. Each is proven by induction on `xs`, and holds whenever its `require` does.

  put_lengths(xs: LIST[K], ys: LIST[V], k: K, v: V): BOOL
    require
      same: xs.length = ys.length
    variant
      xs.length
    do
      if xs.length = 0 or xs.head.equals(k) or k.less_than(xs.head) then
        True
      else
        MAP.put_lengths(xs.tail, ys.tail, k, v)
      end
    ensure
      holds: Result
      same: MAP.put_values(xs, ys, k, v).length = KEY_ORDER.put_keys(xs, k).length
    end

  remove_lengths(xs: LIST[K], ys: LIST[V], k: K): BOOL
    require
      same: xs.length = ys.length
    variant
      xs.length
    do
      if xs.length = 0 then True else MAP.remove_lengths(xs.tail, ys.tail, k) end
    ensure
      holds: Result
      same: MAP.remove_values(xs, ys, k).length = KEY_ORDER.remove_keys(xs, k).length
    end

  find_put_same(xs: LIST[K], ys: LIST[V], k: K, v: V): BOOL
    require
      same: xs.length = ys.length
    variant
      xs.length
    do
      if xs.length = 0 or xs.head.equals(k) or k.less_than(xs.head) then
        True
      else
        MAP.find_put_same(xs.tail, ys.tail, k, v)
      end
    ensure
      holds: Result
      found: MAP.find(KEY_ORDER.put_keys(xs, k), MAP.put_values(xs, ys, k, v), k) = Some(v)
    end

  find_put_other(xs: LIST[K], ys: LIST[V], k: K, v: V, j: K): BOOL
    require
      same: xs.length = ys.length
      other: not j.equals(k)
    variant
      xs.length
    do
      if xs.length = 0 or xs.head.equals(k) or k.less_than(xs.head) then
        True
      else
        MAP.find_put_other(xs.tail, ys.tail, k, v, j)
      end
    ensure
      holds: Result
      unchanged: MAP.find(KEY_ORDER.put_keys(xs, k), MAP.put_values(xs, ys, k, v), j) = MAP.find(xs, ys, j)
    end

  find_remove_same(xs: LIST[K], ys: LIST[V], k: K): BOOL
    require
      same: xs.length = ys.length
    variant
      xs.length
    do
      if xs.length = 0 then True else MAP.find_remove_same(xs.tail, ys.tail, k) end
    ensure
      holds: Result
      gone: MAP.find(KEY_ORDER.remove_keys(xs, k), MAP.remove_values(xs, ys, k), k) = None
    end

  find_remove_other(xs: LIST[K], ys: LIST[V], k: K, j: K): BOOL
    require
      same: xs.length = ys.length
      other: not j.equals(k)
    variant
      xs.length
    do
      if xs.length = 0 then True else MAP.find_remove_other(xs.tail, ys.tail, k, j) end
    ensure
      holds: Result
      unchanged: MAP.find(KEY_ORDER.remove_keys(xs, k), MAP.remove_values(xs, ys, k), j) = MAP.find(xs, ys, j)
    end

  -- What `put` and `remove` do to the number of keys. When no key equals `k`, `put` adds
  -- one and `remove` none, whatever the order. When one does, `put` adds none and `remove`
  -- takes one away only if `equals` is `=`: `ORD` alone lets a key equal to `k` sit above a
  -- key that `k` is below.

  put_grows(xs: LIST[K], ys: LIST[V], k: K): BOOL
    require
      same: xs.length = ys.length
      absent: MAP.find(xs, ys, k).is_none
    variant
      xs.length
    do
      if xs.length = 0 or k.less_than(xs.head) then True else MAP.put_grows(xs.tail, ys.tail, k) end
    ensure
      holds: Result
      grows: KEY_ORDER.put_keys(xs, k).length = xs.length + 1
    end

  put_at_most(xs: LIST[K], k: K): BOOL
    variant
      xs.length
    do
      if xs.length = 0 or xs.head.equals(k) or k.less_than(xs.head) then True else MAP.put_at_most(xs.tail, k) end
    ensure
      holds: Result
      at_most: KEY_ORDER.put_keys(xs, k).length <= xs.length + 1
    end

  -- A key found above `lo` is above it.
  found_above(lo: K, xs: LIST[K], ys: LIST[V], k: K): BOOL
    require
      same: xs.length = ys.length
      above: KEY_ORDER.above(lo, xs)
      found: MAP.find(xs, ys, k).is_some
      agrees: forall p: K. forall q: K. p.equals(q) = (p = q)
    variant
      xs.length
    do
      if xs.head.equals(k) then True else MAP.found_above(lo, xs.tail, ys.tail, k) end
    ensure
      holds: Result
      below: lo.less_than(k)
    end

  -- No key above `lo` is `lo`.
  above_misses(lo: K, xs: LIST[K], ys: LIST[V]): BOOL
    require
      same: xs.length = ys.length
      above: KEY_ORDER.above(lo, xs)
      agrees: forall p: K. forall q: K. p.equals(q) = (p = q)
    variant
      xs.length
    do
      if xs.length = 0 then True else MAP.above_misses(lo, xs.tail, ys.tail) end
    ensure
      holds: Result
      missing: MAP.find(xs, ys, lo).is_none
    end

  put_keeps(xs: LIST[K], ys: LIST[V], k: K): BOOL
    require
      same: xs.length = ys.length
      sorted: KEY_ORDER.ascending(xs)
      found: MAP.find(xs, ys, k).is_some
      agrees: forall p: K. forall q: K. p.equals(q) = (p = q)
    variant
      xs.length
    do
      if xs.head.equals(k) then
        True
      else
        check
          above: MAP.found_above(xs.head, xs.tail, ys.tail, k)
        end
        MAP.put_keeps(xs.tail, ys.tail, k)
      end
    ensure
      holds: Result
      kept: KEY_ORDER.put_keys(xs, k).length = xs.length
    end

  remove_absent(xs: LIST[K], ys: LIST[V], k: K): BOOL
    require
      same: xs.length = ys.length
      absent: MAP.find(xs, ys, k).is_none
    variant
      xs.length
    do
      if xs.length = 0 then True else MAP.remove_absent(xs.tail, ys.tail, k) end
    ensure
      holds: Result
      kept: KEY_ORDER.remove_keys(xs, k).length = xs.length
    end

  remove_at_most(xs: LIST[K], k: K): BOOL
    variant
      xs.length
    do
      if xs.length = 0 then True else MAP.remove_at_most(xs.tail, k) end
    ensure
      holds: Result
      at_most: KEY_ORDER.remove_keys(xs, k).length <= xs.length
    end

  remove_shrinks(xs: LIST[K], ys: LIST[V], k: K): BOOL
    require
      same: xs.length = ys.length
      sorted: KEY_ORDER.ascending(xs)
      found: MAP.find(xs, ys, k).is_some
      agrees: forall p: K. forall q: K. p.equals(q) = (p = q)
    variant
      xs.length
    do
      if xs.head.equals(k) then
        check
          is_k: xs.head = k
          rest: MAP.above_misses(xs.head, xs.tail, ys.tail)
          none: MAP.remove_absent(xs.tail, ys.tail, k)
        end
        True
      else
        MAP.remove_shrinks(xs.tail, ys.tail, k)
      end
    ensure
      holds: Result
      shrinks: KEY_ORDER.remove_keys(xs, k).length + 1 = xs.length
    end

  -- A new key above every key goes last, so a fold meets it last.
  fold_put_last_fact[B](xs: LIST[K], ys: LIST[V], k: K, v: V, f: (acc: B, k: K, v: V) -> B, acc: B): BOOL
    require
      same: xs.length = ys.length
      sorted: KEY_ORDER.ascending(xs)
      absent: MAP.find(xs, ys, k).is_none
      last: xs.length = 0 or LIST_OPS.at(xs, xs.length - 1).less_than(k)
    variant
      xs.length
    do
      if xs.length = 0 then
        True
      else if xs.length = 1 then
        check
          keys: KEY_ORDER.put_keys(xs, k) = KEY_ORDER.put_keys(xs.tail, k).prepend(xs.head)
          values: MAP.put_values(xs, ys, k, v) = MAP.put_values(xs.tail, ys.tail, k, v).prepend(ys.head)
          rest: MAP.fold_put_last_fact(xs.tail, ys.tail, k, v, f, f(acc, xs.head, ys.head))
        end
        True
      else
        check
          head: KEY_ORDER.above_at(xs.head, xs.tail, xs.length - 2)
          same_last: LIST_OPS.at(xs, xs.length - 1) = LIST_OPS.at(xs.tail, xs.length - 2)
          below: xs.head.less_than(k)
          keys: KEY_ORDER.put_keys(xs, k) = KEY_ORDER.put_keys(xs.tail, k).prepend(xs.head)
          values: MAP.put_values(xs, ys, k, v) = MAP.put_values(xs.tail, ys.tail, k, v).prepend(ys.head)
          rest: MAP.fold_put_last_fact(xs.tail, ys.tail, k, v, f, f(acc, xs.head, ys.head))
        end
        True
      end end
    ensure
      holds: Result
      last: MAP.fold_entries(KEY_ORDER.put_keys(xs, k), MAP.put_values(xs, ys, k, v), f, acc) = f(MAP.fold_entries(xs, ys, f, acc), k, v)
    end

  -- A new key above every key becomes the last key.
  put_last_key(xs: LIST[K], ys: LIST[V], k: K): BOOL
    require
      same: xs.length = ys.length
      sorted: KEY_ORDER.ascending(xs)
      absent: MAP.find(xs, ys, k).is_none
      last: xs.length = 0 or LIST_OPS.at(xs, xs.length - 1).less_than(k)
    variant
      xs.length
    do
      if xs.length = 0 then
        True
      else if xs.length = 1 then
        check
          keys: KEY_ORDER.put_keys(xs, k) = KEY_ORDER.put_keys(xs.tail, k).prepend(xs.head)
          rest: MAP.put_last_key(xs.tail, ys.tail, k)
        end
        True
      else
        check
          head: KEY_ORDER.above_at(xs.head, xs.tail, xs.length - 2)
          same_last: LIST_OPS.at(xs, xs.length - 1) = LIST_OPS.at(xs.tail, xs.length - 2)
          below: xs.head.less_than(k)
          keys: KEY_ORDER.put_keys(xs, k) = KEY_ORDER.put_keys(xs.tail, k).prepend(xs.head)
          rest: MAP.put_last_key(xs.tail, ys.tail, k)
        end
        True
      end end
    ensure
      holds: Result
      grows: KEY_ORDER.put_keys(xs, k).length = xs.length + 1
      last_key: LIST_OPS.at(KEY_ORDER.put_keys(xs, k), xs.length) = k
    end

  -- What `filter` and `map` do.

  filter_lengths(xs: LIST[K], ys: LIST[V], p: (k: K, v: V) -> BOOL): BOOL
    require
      same: xs.length = ys.length
    variant
      xs.length
    do
      if xs.length = 0 then True else MAP.filter_lengths(xs.tail, ys.tail, p) end
    ensure
      holds: Result
      same: MAP.kept_values(xs, ys, p).length = MAP.kept_keys(xs, ys, p).length
      not_more: MAP.kept_keys(xs, ys, p).length <= xs.length
    end

  above_filter(lo: K, xs: LIST[K], ys: LIST[V], p: (k: K, v: V) -> BOOL): BOOL
    require
      same: xs.length = ys.length
      above: KEY_ORDER.above(lo, xs)
    variant
      xs.length
    do
      if xs.length = 0 then True else MAP.above_filter(lo, xs.tail, ys.tail, p) end
    ensure
      holds: Result
      kept: KEY_ORDER.above(lo, MAP.kept_keys(xs, ys, p))
    end

  ascending_filter(xs: LIST[K], ys: LIST[V], p: (k: K, v: V) -> BOOL): BOOL
    require
      same: xs.length = ys.length
      sorted: KEY_ORDER.ascending(xs)
    variant
      xs.length
    do
      if xs.length = 0 then
        True
      else
        MAP.above_filter(xs.head, xs.tail, ys.tail, p) and MAP.ascending_filter(xs.tail, ys.tail, p)
      end
    ensure
      holds: Result
      kept: KEY_ORDER.ascending(MAP.kept_keys(xs, ys, p))
    end

  find_filter_absent(xs: LIST[K], ys: LIST[V], p: (k: K, v: V) -> BOOL, k: K): BOOL
    require
      same: xs.length = ys.length
      absent: MAP.find(xs, ys, k).is_none
    variant
      xs.length
    do
      if xs.length = 0 then True else MAP.find_filter_absent(xs.tail, ys.tail, p, k) end
    ensure
      holds: Result
      absent: MAP.find(MAP.kept_keys(xs, ys, p), MAP.kept_values(xs, ys, p), k) = None
    end

  find_filter_kept(xs: LIST[K], ys: LIST[V], p: (k: K, v: V) -> BOOL, k: K): BOOL
    require
      same: xs.length = ys.length
      found: MAP.find(xs, ys, k).is_some
      holds_for: p(k, MAP.find(xs, ys, k).get)
      respects: forall j: K. forall v: V. j.equals(k) implies p(j, v) = p(k, v)
    variant
      xs.length
    do
      if xs.head.equals(k) then True else MAP.find_filter_kept(xs.tail, ys.tail, p, k) end
    ensure
      holds: Result
      same: MAP.find(MAP.kept_keys(xs, ys, p), MAP.kept_values(xs, ys, p), k) = MAP.find(xs, ys, k)
    end

  find_filter_holds(xs: LIST[K], ys: LIST[V], p: (k: K, v: V) -> BOOL, k: K): BOOL
    require
      same: xs.length = ys.length
      found: MAP.find(MAP.kept_keys(xs, ys, p), MAP.kept_values(xs, ys, p), k).is_some
      respects: forall j: K. forall v: V. j.equals(k) implies p(j, v) = p(k, v)
    variant
      xs.length
    do
      if xs.length = 0 then
        True
      else if p(xs.head, ys.head) and xs.head.equals(k) then
        True
      else
        MAP.find_filter_holds(xs.tail, ys.tail, p, k)
      end end
    ensure
      holds: Result
      holds_for: p(k, MAP.find(MAP.kept_keys(xs, ys, p), MAP.kept_values(xs, ys, p), k).get)
    end

  find_filter_dropped(xs: LIST[K], ys: LIST[V], p: (k: K, v: V) -> BOOL, k: K): BOOL
    require
      same: xs.length = ys.length
      sorted: KEY_ORDER.ascending(xs)
      found: MAP.find(xs, ys, k).is_some
      not_for: not p(k, MAP.find(xs, ys, k).get)
      agrees: forall a: K. forall b: K. a.equals(b) = (a = b)
    variant
      xs.length
    do
      if xs.head.equals(k) then
        check
          is_k: xs.head = k
          rest: MAP.above_misses(xs.head, xs.tail, ys.tail)
          none: MAP.find_filter_absent(xs.tail, ys.tail, p, k)
        end
        True
      else
        MAP.find_filter_dropped(xs.tail, ys.tail, p, k)
      end
    ensure
      holds: Result
      gone: MAP.find(MAP.kept_keys(xs, ys, p), MAP.kept_values(xs, ys, p), k) = None
    end

  filter_parts(xs: LIST[K], ys: LIST[V], p: (k: K, v: V) -> BOOL, q: (k: K, v: V) -> BOOL): BOOL
    require
      same: xs.length = ys.length
      opposite: forall k: K. forall v: V. q(k, v) = (not p(k, v))
    variant
      xs.length
    do
      if xs.length = 0 then True else MAP.filter_parts(xs.tail, ys.tail, p, q) end
    ensure
      holds: Result
      all: MAP.kept_keys(xs, ys, p).length + MAP.kept_keys(xs, ys, q).length = xs.length
    end

  map_lengths[W](xs: LIST[K], ys: LIST[V], f: (k: K, v: V) -> W): BOOL
    require
      same: xs.length = ys.length
    variant
      xs.length
    do
      if xs.length = 0 then True else MAP.map_lengths(xs.tail, ys.tail, f) end
    ensure
      holds: Result
      same: MAP.mapped_values(xs, ys, f).length = xs.length
    end

  find_map[W](xs: LIST[K], ys: LIST[V], f: (k: K, v: V) -> W, k: K): BOOL
    require
      same: xs.length = ys.length
      respects: forall j: K. forall v: V. j.equals(k) implies f(j, v) = f(k, v)
    variant
      xs.length
    do
      if xs.length = 0 then True else if xs.head.equals(k) then True else MAP.find_map(xs.tail, ys.tail, f, k) end end
    ensure
      holds: Result
      mapped: MAP.find(xs, MAP.mapped_values(xs, ys, f), k) =
        (match MAP.find(xs, ys, k) case Some(v) then Some(f(k, v)) case None then None end)
    end

  -- The keys and values by their places.

  key_present(xs: LIST[K], ys: LIST[V], i: NAT): BOOL
    require
      same: xs.length = ys.length
      inside: i < xs.length
    variant
      i
    do
      if i = 0 then True else MAP.key_present(xs.tail, ys.tail, i - 1) end
    ensure
      holds: Result
      found: MAP.find(xs, ys, LIST_OPS.at(xs, i)).is_some
    end

  value_there(xs: LIST[K], ys: LIST[V], i: NAT): BOOL
    require
      same: xs.length = ys.length
      sorted: KEY_ORDER.ascending(xs)
      inside: i < xs.length
      agrees: forall a: K. forall b: K. a.equals(b) = (a = b)
    variant
      i
    do
      if i = 0 then
        True
      else
        check
          below: KEY_ORDER.above_at(xs.head, xs.tail, i - 1)
        end
        MAP.value_there(xs.tail, ys.tail, i - 1)
      end
    ensure
      holds: Result
      found: MAP.find(xs, ys, LIST_OPS.at(xs, i)) = Some(LIST_OPS.at(ys, i))
    end

feature {ANY}

  -- How many keys the map holds.
  size: NAT
    do
      Current.ks.length
    end

  -- The value of `k`, or `None` when the map has no key equal to `k`.
  get(k: K): OPTION[V]
    do
      MAP.find(Current.ks, Current.vs, k)
    end

  has(k: K): BOOL
    do
      Current.get(k).is_some
    ensure
      def: Result = Current.get(k).is_some
    end

  -- The map with `v` as the value of `k`, in place of any value it had.
  put(k: K, v: V): MAP[K, V]
    do
      check
        lengths: MAP.put_lengths(Current.ks, Current.vs, k, v)
        sorted: KEY_ORDER.ascending_put(Current.ks, k)
      end
      { ks = KEY_ORDER.put_keys(Current.ks, k), vs = MAP.put_values(Current.ks, Current.vs, k, v) }
    end

  -- The map with no key equal to `k`.
  remove(k: K): MAP[K, V]
    do
      check
        lengths: MAP.remove_lengths(Current.ks, Current.vs, k)
        sorted: KEY_ORDER.ascending_remove(Current.ks, k)
      end
      { ks = KEY_ORDER.remove_keys(Current.ks, k), vs = MAP.remove_values(Current.ks, Current.vs, k) }
    end

  -- The entries `p` holds for.
  filter(p: (k: K, v: V) -> BOOL): MAP[K, V]
    do
      check
        lengths: MAP.filter_lengths(Current.ks, Current.vs, p)
        sorted: MAP.ascending_filter(Current.ks, Current.vs, p)
      end
      { ks = MAP.kept_keys(Current.ks, Current.vs, p), vs = MAP.kept_values(Current.ks, Current.vs, p) }
    ensure
      not_more: Result.size <= Current.size
    end

  -- The map with `f` of each key and its value as the key's value.
  map[W](f: (k: K, v: V) -> W): MAP[K, W]
    do
      check
        lengths: MAP.map_lengths(Current.ks, Current.vs, f)
      end
      { ks = Current.ks, vs = MAP.mapped_values(Current.ks, Current.vs, f) }
    ensure
      same_size: Result.size = Current.size
      same_keys: Result.keys = Current.keys
    end

  -- `f` applied to each key and its value, in ascending order of keys, starting from `init`.
  fold[B](init: B, f: (acc: B, k: K, v: V) -> B): B
    do
      MAP.fold_entries(Current.ks, Current.vs, f, init)
    ensure
      empty_case: Current.size = 0 implies Result = init
    end

  -- The keys, in ascending order.
  keys: LIST[K]
    do
      Current.ks
    ensure
      sorted: KEY_ORDER.ascending(Result)
      counted: Result.length = Current.size
    end

  -- The values, in the order of their keys.
  values: LIST[V]
    do
      Current.vs
    ensure
      counted: Result.length = Current.size
    end

specify {ANY}

  -- What `get` says after each change. With these a client proves facts about a map
  -- without seeing how it is kept.

  law get_empty(m: MAP[K, V], k: K)
    require
      no_keys: m.size = 0
    trigger
      m.get(k)
    ensure
      nothing: m.get(k) = None
    end

  law get_put_same(m: MAP[K, V], k: K, v: V)
    trigger
      m.put(k, v).get(k)
    do
      MAP.find_put_same(m.ks, m.vs, k, v)
    ensure
      found: m.put(k, v).get(k) = Some(v)
    end

  law get_put_other(m: MAP[K, V], k: K, v: V, j: K)
    require
      other: not j.equals(k)
    trigger
      m.put(k, v).get(j)
    do
      MAP.find_put_other(m.ks, m.vs, k, v, j)
    ensure
      unchanged: m.put(k, v).get(j) = m.get(j)
    end

  law get_remove_same(m: MAP[K, V], k: K)
    trigger
      m.remove(k).get(k)
    do
      MAP.find_remove_same(m.ks, m.vs, k)
    ensure
      gone: m.remove(k).get(k) = None
    end

  law get_remove_other(m: MAP[K, V], k: K, j: K)
    require
      other: not j.equals(k)
    trigger
      m.remove(k).get(j)
    do
      MAP.find_remove_other(m.ks, m.vs, k, j)
    ensure
      unchanged: m.remove(k).get(j) = m.get(j)
    end

  -- What `get` says after `filter`. The key `p` sees is the one kept, which is equal to `k`:
  -- `respects` says that `p` cannot tell the two apart, as when it looks at the value alone.
  -- That an entry `p` does not hold for is gone needs `agrees`.

  law get_filter_absent(m: MAP[K, V], p: (k: K, v: V) -> BOOL, k: K)
    require
      absent: not m.has(k)
    trigger
      m.filter(p).get(k)
    do
      MAP.find_filter_absent(m.ks, m.vs, p, k)
    ensure
      absent: m.filter(p).get(k) = None
    end

  law get_filter_kept(m: MAP[K, V], p: (k: K, v: V) -> BOOL, k: K)
    require
      present: m.has(k)
      holds_for: p(k, m.get(k).get)
      respects: forall j: K. forall v: V. j.equals(k) implies p(j, v) = p(k, v)
    trigger
      m.filter(p).get(k)
    do
      MAP.find_filter_kept(m.ks, m.vs, p, k)
    ensure
      same: m.filter(p).get(k) = m.get(k)
    end

  law get_filter_holds(m: MAP[K, V], p: (k: K, v: V) -> BOOL, k: K)
    require
      present: m.filter(p).has(k)
      respects: forall j: K. forall v: V. j.equals(k) implies p(j, v) = p(k, v)
    trigger
      m.filter(p).get(k)
    do
      MAP.find_filter_holds(m.ks, m.vs, p, k)
    ensure
      holds_for: p(k, m.filter(p).get(k).get)
    end

  law get_filter_dropped(m: MAP[K, V], p: (k: K, v: V) -> BOOL, k: K)
    require
      present: m.has(k)
      not_for: not p(k, m.get(k).get)
      agrees: forall a: K. forall b: K. a.equals(b) = (a = b)
    trigger
      m.filter(p).get(k)
    do
      MAP.find_filter_dropped(m.ks, m.vs, p, k)
    ensure
      gone: m.filter(p).get(k) = None
    end

  -- Every entry is in one of two filters, and in no more than one, when one holds where the
  -- other does not.
  law size_filter_parts(m: MAP[K, V], p: (k: K, v: V) -> BOOL, q: (k: K, v: V) -> BOOL)
    require
      opposite: forall k: K. forall v: V. q(k, v) = (not p(k, v))
    trigger
      m.filter(p).size, m.filter(q).size
    do
      MAP.filter_parts(m.ks, m.vs, p, q)
    ensure
      all: m.filter(p).size + m.filter(q).size = m.size
    end

  law get_map[W](m: MAP[K, V], f: (k: K, v: V) -> W, k: K)
    require
      respects: forall j: K. forall v: V. j.equals(k) implies f(j, v) = f(k, v)
    trigger
      m.map(f).get(k)
    do
      MAP.find_map(m.ks, m.vs, f, k)
    ensure
      mapped: m.map(f).get(k) = (match m.get(k) case Some(v) then Some(f(k, v)) case None then None end)
    end

  -- The keys ascend: one at a lower place is below one at a higher place, so no key
  -- appears twice.
  law keys_ascending(m: MAP[K, V], i: NAT, j: NAT)
    require
      ordered: i < j
      inside: j < m.size
    trigger
      LIST_OPS.at(m.keys, i), LIST_OPS.at(m.keys, j)
    do
      KEY_ORDER.ascending_at(m.keys, i, j)
    ensure
      below: LIST_OPS.at(m.keys, i).less_than(LIST_OPS.at(m.keys, j))
    end

  -- The map has each key of `keys`, and its value is at the same place of `values`.

  law keys_present(m: MAP[K, V], i: NAT)
    require
      inside: i < m.size
    trigger
      LIST_OPS.at(m.keys, i)
    do
      MAP.key_present(m.ks, m.vs, i)
    ensure
      present: m.has(LIST_OPS.at(m.keys, i))
    end

  law values_at(m: MAP[K, V], i: NAT)
    require
      inside: i < m.size
      agrees: forall a: K. forall b: K. a.equals(b) = (a = b)
    trigger
      LIST_OPS.at(m.values, i)
    do
      MAP.value_there(m.ks, m.vs, i)
    ensure
      found: m.get(LIST_OPS.at(m.keys, i)) = Some(LIST_OPS.at(m.values, i))
    end

  -- How many keys after each change. The exact counts when `k` is there need `equals` to be
  -- `=`, which a client states as `agrees`, as `SORTING.first_least` does.

  law size_put_new(m: MAP[K, V], k: K, v: V)
    require
      absent: not m.has(k)
    trigger
      m.put(k, v).size
    do
      MAP.put_grows(m.ks, m.vs, k)
    ensure
      grows: m.put(k, v).size = m.size + 1
    end

  law size_put_at_most(m: MAP[K, V], k: K, v: V)
    trigger
      m.put(k, v).size
    do
      MAP.put_at_most(m.ks, k)
    ensure
      at_most: m.put(k, v).size <= m.size + 1
    end

  law size_put_present(m: MAP[K, V], k: K, v: V)
    require
      present: m.has(k)
      agrees: forall p: K. forall q: K. p.equals(q) = (p = q)
    trigger
      m.put(k, v).size
    do
      MAP.put_keeps(m.ks, m.vs, k)
    ensure
      same: m.put(k, v).size = m.size
    end

  law size_remove_absent(m: MAP[K, V], k: K)
    require
      absent: not m.has(k)
    trigger
      m.remove(k).size
    do
      MAP.remove_absent(m.ks, m.vs, k)
    ensure
      same: m.remove(k).size = m.size
    end

  law size_remove_at_most(m: MAP[K, V], k: K)
    trigger
      m.remove(k).size
    do
      MAP.remove_at_most(m.ks, k)
    ensure
      at_most: m.remove(k).size <= m.size
    end

  law size_remove_present(m: MAP[K, V], k: K)
    require
      present: m.has(k)
      agrees: forall p: K. forall q: K. p.equals(q) = (p = q)
    trigger
      m.remove(k).size
    do
      MAP.remove_shrinks(m.ks, m.vs, k)
    ensure
      shrinks: m.remove(k).size + 1 = m.size
    end

  -- A fold meets the keys in ascending order, so a new key above every key is met last.
  law fold_put_last[B](m: MAP[K, V], k: K, v: V, init: B, f: (acc: B, k: K, v: V) -> B)
    require
      absent: not m.has(k)
      last: m.size = 0 or LIST_OPS.at(m.keys, m.size - 1).less_than(k)
    trigger
      m.put(k, v).fold(init, f)
    do
      MAP.fold_put_last_fact(m.ks, m.vs, k, v, f, init)
    ensure
      last: m.put(k, v).fold(init, f) = f(m.fold(init, f), k, v)
    end

  law keys_put_last(m: MAP[K, V], k: K, v: V)
    require
      absent: not m.has(k)
      last: m.size = 0 or LIST_OPS.at(m.keys, m.size - 1).less_than(k)
    trigger
      m.put(k, v).keys
    do
      MAP.put_last_key(m.ks, m.vs, k)
    ensure
      grows: m.put(k, v).size = m.size + 1
      last_key: LIST_OPS.at(m.put(k, v).keys, m.size) = k
    end

end
