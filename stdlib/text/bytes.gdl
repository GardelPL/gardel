module BYTES satisfies EQ

representation {NONE}
  items: LIST[U64]
  size: NAT

create {ANY}

  all_octets(bs: LIST[U64]): BOOL
    variant
      bs.length
    do
      if bs.length = 0 then
        True
      else
        bs.head < 256 and all_octets(bs.tail)
      end
    end

  -- RFC 3629 well-formedness of an octet sequence (Unicode Table 3-7): shortest form only,
  -- no surrogates (U+D800..U+DFFF), nothing above U+10FFFF.
  valid_utf8(bs: LIST[U64]): BOOL
    variant
      bs.length
    do
      if bs.length = 0 then
        True
      else
        if bs.head < 128 then
          valid_utf8(bs.tail)
        else
          if bs.head >= 194 and bs.head <= 223 then
            if bs.length >= 2 then
              (bs.tail.head >= 128 and bs.tail.head <= 191) and
              valid_utf8(bs.tail.tail)
            else
              False
            end
          else
            if bs.head >= 224 and bs.head <= 239 then
              if bs.length >= 3 then
                (if bs.head = 224 then (bs.tail.head >= 160 and bs.tail.head <= 191)
                 else if bs.head = 237 then (bs.tail.head >= 128 and bs.tail.head <= 159)
                 else (bs.tail.head >= 128 and bs.tail.head <= 191) end end) and
                (bs.tail.tail.head >= 128 and bs.tail.tail.head <= 191) and
                valid_utf8(bs.tail.tail.tail)
              else
                False
              end
            else
              if bs.head >= 240 and bs.head <= 244 then
                if bs.length >= 4 then
                  (if bs.head = 240 then (bs.tail.head >= 144 and bs.tail.head <= 191)
                   else if bs.head = 244 then (bs.tail.head >= 128 and bs.tail.head <= 143)
                   else (bs.tail.head >= 128 and bs.tail.head <= 191) end end) and
                  (bs.tail.tail.head >= 128 and bs.tail.tail.head <= 191) and
                  (bs.tail.tail.tail.head >= 128 and bs.tail.tail.tail.head <= 191) and
                  valid_utf8(bs.tail.tail.tail.tail)
                else
                  False
                end
              else
                False
              end
            end
          end
        end
      end
    ensure
      empty_valid: (bs.length = 0) implies Result
    end
  decode_utf8(bs: LIST[U64]): LIST[CHAR]
    require
      valid: valid_utf8(bs)
    variant
      bs.length
    do
      if bs.length = 0 then
        LIST.empty
      else
        if bs.head < 128 then
          decode_utf8(bs.tail).prepend(CHAR.from_scalar(bs.head))
        else
          if bs.head <= 223 then
            decode_utf8(bs.tail.tail).prepend(CHAR.from_scalar((bs.head - 192) * 64 + (bs.tail.head - 128)))
          else
            if bs.head <= 239 then
              decode_utf8(bs.tail.tail.tail).prepend(CHAR.from_scalar((bs.head - 224) * 4096 + (bs.tail.head - 128) * 64 + (bs.tail.tail.head - 128)))
            else
              decode_utf8(bs.tail.tail.tail.tail).prepend(CHAR.from_scalar((bs.head - 240) * 262144 + (bs.tail.head - 128) * 4096 + (bs.tail.tail.head - 128) * 64 + (bs.tail.tail.tail.head - 128)))
            end
          end
        end
      end
    ensure
      length_bounded: Result.length <= bs.length
      empty_iff: (Result.length = 0) = (bs.length = 0)
    end

  empty: BYTES
    do
      { items = LIST.empty, size = 0 }
    ensure
      empty_len: Result.length = 0
      empty_model: Result.model = LIST.empty
    end

  from_list(xs: LIST[U64]): BYTES
    require
      octets: all_octets(xs)
      fits: xs.length <= 18446744073709551615
    do
      { items = xs, size = xs.length }
    ensure
      len: Result.length = xs.length
      model_eq: Result.model = xs
    end

  -- The byte offset of the scalar at index `i`.
  utf8_offset(bs: LIST[U64], i: NAT): NAT
    require
      valid: valid_utf8(bs)
      in_bounds: i <= decode_utf8(bs).length
      fits: bs.length <= 18446744073709551615
    variant
      bs.length
    do
      if i = 0 then
        0
      else
        if bs.head < 128 then
          utf8_offset(bs.tail, i - 1) + 1
        else
          if bs.head <= 223 then
            utf8_offset(bs.tail.tail, i - 1) + 2
          else
            if bs.head <= 239 then
              utf8_offset(bs.tail.tail.tail, i - 1) + 3
            else
              utf8_offset(bs.tail.tail.tail.tail, i - 1) + 4
            end
          end
        end
      end
    ensure
      inside: Result <= bs.length
      -- Each step, stated as a contract: a contract holds at every fuel, while unfolding the
      -- body needs this precondition one fuel lower, where `decode_utf8` is unknown.
      at_start: i = 0 implies Result = 0
      step_1: (i > 0 and bs.head < 128) implies Result = utf8_offset(bs.tail, i - 1) + 1
      step_2: (i > 0 and bs.head >= 128 and bs.head <= 223) implies
        Result = utf8_offset(bs.tail.tail, i - 1) + 2
      step_3: (i > 0 and bs.head > 223 and bs.head <= 239) implies
        Result = utf8_offset(bs.tail.tail.tail, i - 1) + 3
      step_4: (i > 0 and bs.head > 239) implies
        Result = utf8_offset(bs.tail.tail.tail.tail, i - 1) + 4
    end

  -- Byte order: the first byte that differs decides, and a prefix comes first. On well-formed
  -- UTF-8 this is also the order of code points (decision 3). It is a key order, not a
  -- collation.
  list_less(xs: LIST[U64], ys: LIST[U64]): BOOL
    variant
      xs.length
    do
      if ys.length = 0 then
        False
      else
        if xs.length = 0 then
          True
        else
          if xs.head < ys.head then
            True
          else
            if xs.head > ys.head then
              False
            else
              list_less(xs.tail, ys.tail)
            end
          end
        end
      end
    end

  -- The first `n` elements and what follows them. These are what a slice means. They are
  -- generic because `STRING` states the same thing over `chars`.
  list_take[A](xs: LIST[A], n: NAT): LIST[A]
    require
      fits: n <= xs.length
    variant
      n
    do
      if n = 0 then
        LIST.empty
      else
        list_take(xs.tail, n - 1).prepend(xs.head)
      end
    ensure
      len: Result.length = n
    end

  list_drop[A](xs: LIST[A], n: NAT): LIST[A]
    require
      fits: n <= xs.length
    variant
      n
    do
      if n = 0 then
        xs
      else
        list_drop(xs.tail, n - 1)
      end
    ensure
      len: Result.length = xs.length - n
    end

create {NONE}

  -- `utf8_step_2` as a routine: inside this module a law is not an axiom, a contract is.
  -- There is no `step_1`: its byte has no lower bound in the model, which the U64 parameter
  -- would need, so the one-byte step is stated in place.
  step_2(b0: U64, b1: U64, xs: LIST[U64]): BOOL
    require
      lead: b0 >= 194 and b0 <= 223
      cont: b1 >= 128 and b1 <= 191
      xs_valid: valid_utf8(xs)
    do
      True
    ensure
      holds: Result
      step_valid: valid_utf8(xs.prepend(b1).prepend(b0))
      step_decode: decode_utf8(xs.prepend(b1).prepend(b0)) = decode_utf8(xs).prepend(CHAR.from_scalar((b0 - 192) * 64 + (b1 - 128)))
    end

  -- `utf8_step_3` as a routine: inside this module a law is not an axiom, a contract is.
  step_3(b0: U64, b1: U64, b2: U64, xs: LIST[U64]): BOOL
    require
      lead: b0 >= 224 and b0 <= 239
      cont1: if b0 = 224 then (b1 >= 160 and b1 <= 191)
             else if b0 = 237 then (b1 >= 128 and b1 <= 159)
             else (b1 >= 128 and b1 <= 191) end end
      cont2: b2 >= 128 and b2 <= 191
      xs_valid: valid_utf8(xs)
    do
      True
    ensure
      holds: Result
      step_valid: valid_utf8(xs.prepend(b2).prepend(b1).prepend(b0))
      step_decode: decode_utf8(xs.prepend(b2).prepend(b1).prepend(b0)) = decode_utf8(xs).prepend(CHAR.from_scalar((b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128)))
    end

  -- `utf8_step_4` as a routine: inside this module a law is not an axiom, a contract is.
  step_4(b0: U64, b1: U64, b2: U64, b3: U64, xs: LIST[U64]): BOOL
    require
      lead: b0 >= 240 and b0 <= 244
      cont1: if b0 = 240 then (b1 >= 144 and b1 <= 191)
             else if b0 = 244 then (b1 >= 128 and b1 <= 143)
             else (b1 >= 128 and b1 <= 191) end end
      cont2: b2 >= 128 and b2 <= 191
      cont3: b3 >= 128 and b3 <= 191
      xs_valid: valid_utf8(xs)
    do
      True
    ensure
      holds: Result
      step_valid: valid_utf8(xs.prepend(b3).prepend(b2).prepend(b1).prepend(b0))
      step_decode: decode_utf8(xs.prepend(b3).prepend(b2).prepend(b1).prepend(b0)) = decode_utf8(xs).prepend(CHAR.from_scalar((b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128)))
    end

  -- Ghost: a module's own laws are not axioms inside it, so what `concat` and `slice` need
  -- about their octets is the contract of these routines. C uses a primitive for both.
  octets_append(xs: LIST[U64], ys: LIST[U64]): LIST[U64]
    require
      xs_octets: all_octets(xs)
      ys_octets: all_octets(ys)
    variant
      xs.length
    do
      if xs.length = 0 then
        ys
      else
        octets_append(xs.tail, ys).prepend(xs.head)
      end
    ensure
      same: Result = xs.append(ys)
      octets: all_octets(Result)
    end

  octets_take(xs: LIST[U64], n: NAT): LIST[U64]
    require
      xs_octets: all_octets(xs)
      fits: n <= xs.length
    variant
      n
    do
      if n = 0 then
        LIST.empty
      else
        octets_take(xs.tail, n - 1).prepend(xs.head)
      end
    ensure
      same: Result = list_take(xs, n)
      octets: all_octets(Result)
    end

  octets_drop(xs: LIST[U64], n: NAT): LIST[U64]
    require
      xs_octets: all_octets(xs)
      fits: n <= xs.length
    variant
      n
    do
      if n = 0 then
        xs
      else
        octets_drop(xs.tail, n - 1)
      end
    ensure
      same: Result = list_drop(xs, n)
      octets: all_octets(Result)
    end

  get_byte(bs: LIST[U64], i: NAT): U64
    require
      octets: all_octets(bs)
      in_bounds: i < bs.length
    variant
      i
    do
      if i = 0 then
        bs.head
      else
        get_byte(bs.tail, i - 1)
      end
    ensure
      is_octet: Result < 256
      matches_ops: Result = LIST_OPS.at(bs, i)
    end

specify {ANY}

  model: LIST[U64]
    do
      Current.items
    end

  -- Every well-formed UTF-8 sequence consists of octets. The proof steps walk back from
  -- the induction hypothesis one byte at a time (each step is a single unfolding).
  law utf8_octets(xs: LIST[U64])
    require
      xs_valid: valid_utf8(xs)
    trigger
      valid_utf8(xs)
    variant
      xs.length
    do
      if xs.length = 0 then
        True
      else
        if xs.head < 128 then
          utf8_octets(xs.tail)
        else
          if xs.head <= 223 then
            utf8_octets(xs.tail.tail) and
            all_octets(xs.tail)
          else
            if xs.head <= 239 then
              utf8_octets(xs.tail.tail.tail) and
              all_octets(xs.tail.tail) and
              all_octets(xs.tail)
            else
              utf8_octets(xs.tail.tail.tail.tail) and
              all_octets(xs.tail.tail.tail) and
              all_octets(xs.tail.tail) and
              all_octets(xs.tail)
            end
          end
        end
      end
    ensure
      octets: all_octets(xs)
    end

  -- UTF-8 is closed under concatenation and decoding distributes over it.
  law utf8_append(xs: LIST[U64], ys: LIST[U64])
    require
      xs_valid: valid_utf8(xs)
      ys_valid: valid_utf8(ys)
    trigger
      xs.append(ys)
    variant
      xs.length
    do
      if xs.length = 0 then
        True
      else
        if xs.head < 128 then
          utf8_append(xs.tail, ys)
        else
          if xs.head <= 223 then
            utf8_append(xs.tail.tail, ys)
          else
            if xs.head <= 239 then
              utf8_append(xs.tail.tail.tail, ys)
            else
              utf8_append(xs.tail.tail.tail.tail, ys)
            end
          end
        end
      end
    ensure
      append_valid: valid_utf8(xs.append(ys))
      chars_append: decode_utf8(xs.append(ys)) = decode_utf8(xs).append(decode_utf8(ys))
    end

  -- Decoding is injective on well-formed sequences: the shortest-form rules make the
  -- encoding of every scalar unique.
  law decode_injective(xs: LIST[U64], ys: LIST[U64])
    require
      xs_valid: valid_utf8(xs)
      ys_valid: valid_utf8(ys)
      same_chars: decode_utf8(xs) = decode_utf8(ys)
    trigger
      decode_utf8(xs), decode_utf8(ys)
    variant
      xs.length
    do
      if xs.length = 0 then
        True
      else
        if xs.head < 128 then
          decode_injective(xs.tail, ys.tail)
        else
          if xs.head <= 223 then
            decode_injective(xs.tail.tail, ys.tail.tail)
          else
            if xs.head <= 239 then
              decode_injective(xs.tail.tail.tail, ys.tail.tail.tail)
            else
              decode_injective(xs.tail.tail.tail.tail, ys.tail.tail.tail.tail)
            end
          end
        end
      end
    ensure
      same_bytes: xs = ys
    end

  -- One well-formed 1-byte, 2-byte and 3-byte step, for `STRING.push_ascii`, `push_utf8_2` and `push_utf8_3`. See
  -- `utf8_step_4`: their invariant proofs failed the same way, on some Z3 seeds, once overflow
  -- checks on record fields joined those routines, or when bodies are withheld across modules.
  law utf8_step_1(b0: U64, xs: LIST[U64])
    require
      lead: b0 < 128
      xs_valid: valid_utf8(xs)
    trigger
      xs.prepend(b0)
    ensure
      step_valid: valid_utf8(xs.prepend(b0))
      step_decode: decode_utf8(xs.prepend(b0)) =
        decode_utf8(xs).prepend(CHAR.from_scalar(b0))
    end

  law utf8_step_2(b0: U64, b1: U64, xs: LIST[U64])
    require
      lead: b0 >= 194 and b0 <= 223
      cont: b1 >= 128 and b1 <= 191
      xs_valid: valid_utf8(xs)
    trigger
      xs.prepend(b1).prepend(b0)
    ensure
      step_valid: valid_utf8(xs.prepend(b1).prepend(b0))
      step_decode: decode_utf8(xs.prepend(b1).prepend(b0)) =
        decode_utf8(xs).prepend(CHAR.from_scalar((b0 - 192) * 64 + (b1 - 128)))
    end

  law utf8_step_3(b0: U64, b1: U64, b2: U64, xs: LIST[U64])
    require
      lead: b0 >= 224 and b0 <= 239
      cont1: if b0 = 224 then (b1 >= 160 and b1 <= 191)
             else if b0 = 237 then (b1 >= 128 and b1 <= 159)
             else (b1 >= 128 and b1 <= 191) end end
      cont2: b2 >= 128 and b2 <= 191
      xs_valid: valid_utf8(xs)
    trigger
      xs.prepend(b2).prepend(b1).prepend(b0)
    ensure
      step_valid: valid_utf8(xs.prepend(b2).prepend(b1).prepend(b0))
      step_decode: decode_utf8(xs.prepend(b2).prepend(b1).prepend(b0)) =
        decode_utf8(xs).prepend(CHAR.from_scalar((b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128)))
    end

  -- One well-formed 4-byte step (a single unfolding of `valid_utf8` and `decode_utf8`).
  -- `STRING.push_utf8_4` uses it so that its invariant proof does not depend on the
  -- solver unfolding four levels of `tail` on its own (Task C.3: that proof failed for
  -- half of the Z3 random seeds once an unrelated axiom was added to the preamble).
  law utf8_step_4(b0: U64, b1: U64, b2: U64, b3: U64, xs: LIST[U64])
    require
      lead: b0 >= 240 and b0 <= 244
      cont1: if b0 = 240 then (b1 >= 144 and b1 <= 191)
             else if b0 = 244 then (b1 >= 128 and b1 <= 143)
             else (b1 >= 128 and b1 <= 191) end end
      cont2: b2 >= 128 and b2 <= 191
      cont3: b3 >= 128 and b3 <= 191
      xs_valid: valid_utf8(xs)
    trigger
      xs.prepend(b3).prepend(b2).prepend(b1).prepend(b0)
    ensure
      step_valid: valid_utf8(xs.prepend(b3).prepend(b2).prepend(b1).prepend(b0))
      step_decode: decode_utf8(xs.prepend(b3).prepend(b2).prepend(b1).prepend(b0)) =
        decode_utf8(xs).prepend(CHAR.from_scalar((b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128)))
    end

  -- Cutting UTF-8 where a scalar starts: both sides stay well-formed, and they decode to the
  -- two sides of the scalars. This is what `STRING.slice` rests on. It is two laws, as one
  -- runs out of solver resources.
  law utf8_split_left(bs: LIST[U64], i: NAT)
    require
      valid: valid_utf8(bs)
      in_bounds: i <= decode_utf8(bs).length
      fits: bs.length <= 18446744073709551615
    variant
      bs.length
    do
      if i = 0 then
        True
      else
        if bs.head < 128 then
          let k = utf8_offset(bs.tail, i - 1)
          utf8_split_left(bs.tail, i - 1) and
          bs.tail.prepend(bs.head) = bs and
          decode_utf8(bs) = decode_utf8(bs.tail).prepend(CHAR.from_scalar(bs.head)) and
          utf8_offset(bs, i) = k + 1 and
          list_take(bs, k + 1) = list_take(bs.tail, k).prepend(bs.head) and
          list_take(bs, k + 1) = list_take(bs.tail, k).prepend(bs.head) and
          valid_utf8(list_take(bs.tail, k).prepend(bs.head)) and
          decode_utf8(list_take(bs.tail, k).prepend(bs.head)) =
            decode_utf8(list_take(bs.tail, k)).prepend(CHAR.from_scalar(bs.head)) and
          list_take(decode_utf8(bs), i) = list_take(decode_utf8(bs.tail), i - 1).prepend(decode_utf8(bs).head)
        else
          if bs.head <= 223 then
            let k = utf8_offset(bs.tail.tail, i - 1)
            utf8_split_left(bs.tail.tail, i - 1) and
            bs.tail.prepend(bs.head) = bs and
            bs.tail.tail.prepend(bs.tail.head) = bs.tail and
            step_2(bs.head, bs.tail.head, bs.tail.tail) and
            utf8_offset(bs, i) = k + 2 and
            list_take(bs, k + 2) = list_take(bs.tail, k + 1).prepend(bs.head) and
            list_take(bs.tail, k + 1) = list_take(bs.tail.tail, k).prepend(bs.tail.head) and
            list_take(bs, k + 2) = list_take(bs.tail.tail, k).prepend(bs.tail.head).prepend(bs.head) and
            step_2(bs.head, bs.tail.head, list_take(bs.tail.tail, k)) and
            list_take(decode_utf8(bs), i) = list_take(decode_utf8(bs.tail.tail), i - 1).prepend(decode_utf8(bs).head)
          else
            if bs.head <= 239 then
              let k = utf8_offset(bs.tail.tail.tail, i - 1)
              utf8_split_left(bs.tail.tail.tail, i - 1) and
              bs.tail.prepend(bs.head) = bs and
              bs.tail.tail.prepend(bs.tail.head) = bs.tail and
              bs.tail.tail.tail.prepend(bs.tail.tail.head) = bs.tail.tail and
              step_3(bs.head, bs.tail.head, bs.tail.tail.head, bs.tail.tail.tail) and
              utf8_offset(bs, i) = k + 3 and
              list_take(bs, k + 3) = list_take(bs.tail, k + 2).prepend(bs.head) and
              list_take(bs.tail, k + 2) = list_take(bs.tail.tail, k + 1).prepend(bs.tail.head) and
              list_take(bs.tail.tail, k + 1) = list_take(bs.tail.tail.tail, k).prepend(bs.tail.tail.head) and
              list_take(bs, k + 3) = list_take(bs.tail.tail.tail, k).prepend(bs.tail.tail.head).prepend(bs.tail.head).prepend(bs.head) and
              step_3(bs.head, bs.tail.head, bs.tail.tail.head, list_take(bs.tail.tail.tail, k)) and
              list_take(decode_utf8(bs), i) = list_take(decode_utf8(bs.tail.tail.tail), i - 1).prepend(decode_utf8(bs).head)
            else
              let k = utf8_offset(bs.tail.tail.tail.tail, i - 1)
              utf8_split_left(bs.tail.tail.tail.tail, i - 1) and
              bs.tail.prepend(bs.head) = bs and
              bs.tail.tail.prepend(bs.tail.head) = bs.tail and
              bs.tail.tail.tail.prepend(bs.tail.tail.head) = bs.tail.tail and
              bs.tail.tail.tail.tail.prepend(bs.tail.tail.tail.head) = bs.tail.tail.tail and
              step_4(bs.head, bs.tail.head, bs.tail.tail.head, bs.tail.tail.tail.head, bs.tail.tail.tail.tail) and
              utf8_offset(bs, i) = k + 4 and
              list_take(bs, k + 4) = list_take(bs.tail, k + 3).prepend(bs.head) and
              list_take(bs.tail, k + 3) = list_take(bs.tail.tail, k + 2).prepend(bs.tail.head) and
              list_take(bs.tail.tail, k + 2) = list_take(bs.tail.tail.tail, k + 1).prepend(bs.tail.tail.head) and
              list_take(bs.tail.tail.tail, k + 1) = list_take(bs.tail.tail.tail.tail, k).prepend(bs.tail.tail.tail.head) and
              list_take(bs, k + 4) = list_take(bs.tail.tail.tail.tail, k).prepend(bs.tail.tail.tail.head).prepend(bs.tail.tail.head).prepend(bs.tail.head).prepend(bs.head) and
              step_4(bs.head, bs.tail.head, bs.tail.tail.head, bs.tail.tail.tail.head, list_take(bs.tail.tail.tail.tail, k)) and
              list_take(decode_utf8(bs), i) = list_take(decode_utf8(bs.tail.tail.tail.tail), i - 1).prepend(decode_utf8(bs).head)
            end
          end
        end
      end
    ensure
      left_valid: valid_utf8(list_take(bs, utf8_offset(bs, i)))
      left_chars: decode_utf8(list_take(bs, utf8_offset(bs, i))) = list_take(decode_utf8(bs), i)
    end

  law utf8_split_right(bs: LIST[U64], i: NAT)
    require
      valid: valid_utf8(bs)
      in_bounds: i <= decode_utf8(bs).length
      fits: bs.length <= 18446744073709551615
    variant
      bs.length
    do
      if i = 0 then
        True
      else
        if bs.head < 128 then
          let k = utf8_offset(bs.tail, i - 1)
          utf8_split_right(bs.tail, i - 1) and
          bs.tail.prepend(bs.head) = bs and
          decode_utf8(bs) = decode_utf8(bs.tail).prepend(CHAR.from_scalar(bs.head)) and
          utf8_offset(bs, i) = k + 1 and
          list_drop(bs, k + 1) = list_drop(bs.tail, k) and
          list_drop(decode_utf8(bs), i) = list_drop(decode_utf8(bs.tail), i - 1)
        else
          if bs.head <= 223 then
            let k = utf8_offset(bs.tail.tail, i - 1)
            utf8_split_right(bs.tail.tail, i - 1) and
            bs.tail.prepend(bs.head) = bs and
            bs.tail.tail.prepend(bs.tail.head) = bs.tail and
            step_2(bs.head, bs.tail.head, bs.tail.tail) and
            utf8_offset(bs, i) = k + 2 and
            list_drop(bs, k + 2) = list_drop(bs.tail, k + 1) and
            list_drop(bs.tail, k + 1) = list_drop(bs.tail.tail, k) and
            list_drop(decode_utf8(bs), i) = list_drop(decode_utf8(bs.tail.tail), i - 1)
          else
            if bs.head <= 239 then
              let k = utf8_offset(bs.tail.tail.tail, i - 1)
              utf8_split_right(bs.tail.tail.tail, i - 1) and
              bs.tail.prepend(bs.head) = bs and
              bs.tail.tail.prepend(bs.tail.head) = bs.tail and
              bs.tail.tail.tail.prepend(bs.tail.tail.head) = bs.tail.tail and
              step_3(bs.head, bs.tail.head, bs.tail.tail.head, bs.tail.tail.tail) and
              utf8_offset(bs, i) = k + 3 and
              list_drop(bs, k + 3) = list_drop(bs.tail, k + 2) and
              list_drop(bs.tail, k + 2) = list_drop(bs.tail.tail, k + 1) and
              list_drop(bs.tail.tail, k + 1) = list_drop(bs.tail.tail.tail, k) and
              list_drop(decode_utf8(bs), i) = list_drop(decode_utf8(bs.tail.tail.tail), i - 1)
            else
              let k = utf8_offset(bs.tail.tail.tail.tail, i - 1)
              utf8_split_right(bs.tail.tail.tail.tail, i - 1) and
              bs.tail.prepend(bs.head) = bs and
              bs.tail.tail.prepend(bs.tail.head) = bs.tail and
              bs.tail.tail.tail.prepend(bs.tail.tail.head) = bs.tail.tail and
              bs.tail.tail.tail.tail.prepend(bs.tail.tail.tail.head) = bs.tail.tail.tail and
              step_4(bs.head, bs.tail.head, bs.tail.tail.head, bs.tail.tail.tail.head, bs.tail.tail.tail.tail) and
              utf8_offset(bs, i) = k + 4 and
              list_drop(bs, k + 4) = list_drop(bs.tail, k + 3) and
              list_drop(bs.tail, k + 3) = list_drop(bs.tail.tail, k + 2) and
              list_drop(bs.tail.tail, k + 2) = list_drop(bs.tail.tail.tail, k + 1) and
              list_drop(bs.tail.tail.tail, k + 1) = list_drop(bs.tail.tail.tail.tail, k) and
              list_drop(decode_utf8(bs), i) = list_drop(decode_utf8(bs.tail.tail.tail.tail), i - 1)
            end
          end
        end
      end
    ensure
      right_valid: valid_utf8(list_drop(bs, utf8_offset(bs, i)))
      right_chars: decode_utf8(list_drop(bs, utf8_offset(bs, i))) = list_drop(decode_utf8(bs), i)
    end

  -- Reading back through `list_take` and `list_drop`.
  law take_at[A](xs: LIST[A], n: NAT, i: NAT)
    require
      fits: n <= xs.length
      in_bounds: i < n
    variant
      i
    do
      if i = 0 then
        True
      else
        take_at(xs.tail, n - 1, i - 1)
      end
    ensure
      same: LIST_OPS.at(list_take(xs, n), i) = LIST_OPS.at(xs, i)
    end

  law drop_at[A](xs: LIST[A], n: NAT, i: NAT)
    require
      fits: n <= xs.length
      in_bounds: i < xs.length - n
    variant
      n
    do
      if n = 0 then
        True
      else
        drop_at(xs.tail, n - 1, i) and
        xs.tail.prepend(xs.head) = xs and
        LIST_OPS.at(xs, n + i) = LIST_OPS.at(xs.tail, n - 1 + i)
      end
    ensure
      shifted: LIST_OPS.at(list_drop(xs, n), i) = LIST_OPS.at(xs, n + i)
    end

  -- An item of a slice is the item of the whole at the slice's offset. With its trigger the
  -- solver applies it wherever a slice is indexed, as in `b.slice(lo, hi).at(k)`.
  law slice_at[A](xs: LIST[A], lo: NAT, n: NAT, k: NAT)
    require
      fits: lo + n <= xs.length
      in_bounds: k < n
    trigger
      LIST_OPS.at(list_take(list_drop(xs, lo), n), k)
    variant
      lo + k
    do
      if lo > 0 then
        list_drop(xs, lo) = list_drop(xs.tail, lo - 1) and xs.tail.prepend(xs.head) = xs and
        slice_at(xs.tail, lo - 1, n, k)
      else if k > 0 then
        list_drop(xs, 0) = xs and list_drop(xs.tail, 0) = xs.tail and
        list_take(xs, n) = list_take(xs.tail, n - 1).prepend(xs.head) and
        xs.tail.prepend(xs.head) = xs and slice_at(xs.tail, 0, n - 1, k - 1)
      else
        list_drop(xs, 0) = xs and list_take(xs, n) = list_take(xs.tail, n - 1).prepend(xs.head)
      end end
    ensure
      same: LIST_OPS.at(list_take(list_drop(xs, lo), n), k) = LIST_OPS.at(xs, lo + k)
    end

  law take_drop[A](xs: LIST[A], n: NAT)
    require
      fits: n <= xs.length
    variant
      n
    do
      if n = 0 then
        True
      else
        take_drop(xs.tail, n - 1)
      end
    ensure
      whole: list_take(xs, n).append(list_drop(xs, n)) = xs
    end

  -- Lists of one length that agree at every index are the same list.
  law same_items[A](xs: LIST[A], ys: LIST[A])
    require
      same_length: xs.length = ys.length
      fits: xs.length < 18446744073709551615
      same_at: forall k: NAT. k < xs.length implies LIST_OPS.at(xs, k) = LIST_OPS.at(ys, k)
    variant
      xs.length
    do
      if xs.length = 0 then
        True
      else
        xs.tail.prepend(xs.head) = xs and ys.tail.prepend(ys.head) = ys and
        LIST_OPS.at(xs, 0) = LIST_OPS.at(ys, 0) and
        (forall k: NAT. k < xs.tail.length implies LIST_OPS.at(xs.tail, k) = LIST_OPS.at(xs, k + 1)) and
        (forall k: NAT. k < ys.tail.length implies LIST_OPS.at(ys.tail, k) = LIST_OPS.at(ys, k + 1)) and
        same_items(xs.tail, ys.tail)
      end
    ensure
      equal: xs = ys
    end

  law less_irreflexive(xs: LIST[U64])
    variant
      xs.length
    do
      if xs.length = 0 then
        True
      else
        less_irreflexive(xs.tail)
      end
    ensure
      not_self: not list_less(xs, xs)
    end

  law less_transitive(xs: LIST[U64], ys: LIST[U64], zs: LIST[U64])
    require
      xy: list_less(xs, ys)
      yz: list_less(ys, zs)
    variant
      xs.length
    do
      if xs.length = 0 then
        True
      else
        if xs.head = ys.head and ys.head = zs.head then
          less_transitive(xs.tail, ys.tail, zs.tail)
        else
          True
        end
      end
    ensure
      xz: list_less(xs, zs)
    end

  law less_total(xs: LIST[U64], ys: LIST[U64])
    variant
      xs.length
    do
      if xs.length = 0 or ys.length = 0 then
        True
      else
        if xs.head = ys.head then
          less_total(xs.tail, ys.tail) and
          xs.tail.prepend(xs.head) = xs and
          ys.tail.prepend(ys.head) = ys
        else
          True
        end
      end
    ensure
      comparable: list_less(xs, ys) or xs = ys or list_less(ys, xs)
    end

feature {ANY}

  length: NAT
    do
      Current.size
    ensure
      def: Result = Current.model.length
    end

  is_empty: BOOL
    do
      Current.size = 0
    ensure
      def: Result = (Current.model = LIST.empty)
    end

  to_list: LIST[U64]
    do
      Current.items
    ensure
      is_model: Result = Current.model
      len: Result.length = Current.length
    end

  at(i: NAT): U64
    require
      in_bounds: i < Current.length
    do
      get_byte(Current.items, i)
    ensure
      octet: Result < 256
      model_at: Result = LIST_OPS.at(Current.model, i)
    end

  equals(other: BYTES): BOOL
    do
      Current.items = other.items
    ensure
      def: Result = (Current.model = other.model)
    end

  -- The total size must be representable, as for `STRING.concat`.
  concat(other: BYTES): BYTES
    require
      fits: Current.length <= 18446744073709551615 - other.length
    do
      { items = octets_append(Current.items, other.items), size = Current.size + other.size }
    ensure
      len: Result.length = Current.length + other.length
      model_appended: Result.model = Current.model.append(other.model)
    end

  -- The bytes from `lo` up to, not including, `hi`. In C it shares this buffer, so it costs
  -- no copy.
  slice(lo: NAT, hi: NAT): BYTES
    require
      ordered: lo <= hi
      in_bounds: hi <= Current.length
    do
      { items = octets_take(octets_drop(Current.items, lo), hi - lo), size = hi - lo }
    ensure
      len: Result.length = hi - lo
      model_slice: Result.model = list_take(list_drop(Current.model, lo), hi - lo)
    end

  -- Whether `other` occurs at offset `at`. Compiled from this source, not hand-written C.
  matches_at(other: BYTES, offset: NAT, i: NAT): BOOL
    require
      within: i <= other.length
      in_bounds: offset <= Current.length - other.length
      not_longer: other.length <= Current.length
    variant
      other.length - i
    do
      if i = other.length then
        True
      else
        if Current.at(offset + i) = other.at(i) then
          Current.matches_at(other, offset, i + 1)
        else
          False
        end
      end
    ensure
      all_match: Result = (forall k: NAT. (i <= k and k < other.length) implies
        LIST_OPS.at(Current.model, offset + k) = LIST_OPS.at(other.model, k))
    end

  starts_with(prefix: BYTES): BOOL
    do
      if prefix.length > Current.length then
        False
      else
        Current.matches_at(prefix, 0, 0)
      end
    ensure
      def: Result = (prefix.length <= Current.length and
        (forall k: NAT. k < prefix.length implies
          LIST_OPS.at(Current.model, k) = LIST_OPS.at(prefix.model, k)))
    end

  -- The first offset at or after `from` that holds byte `b`.
  index_of_byte(b: U64, from: NAT): OPTION[NAT]
    require
      in_bounds: from <= Current.length
    variant
      Current.length - from
    do
      if from = Current.length then
        None
      else
        if Current.at(from) = b then
          Some(from)
        else
          Current.index_of_byte(b, from + 1)
        end
      end
    ensure
      found: Result.is_some implies
        (from <= Result.get and Result.get < Current.length and
         LIST_OPS.at(Current.model, Result.get) = b)
      first: Result.is_some implies
        (forall k: NAT. (from <= k and k < Result.get) implies LIST_OPS.at(Current.model, k) != b)
      absent: not Result.is_some implies
        (forall k: NAT. (from <= k and k < Current.length) implies LIST_OPS.at(Current.model, k) != b)
    end

  -- The first offset at or after `from` where `other` occurs.
  index_of(other: BYTES, from: NAT): OPTION[NAT]
    require
      in_bounds: from <= Current.length
    variant
      Current.length - from
    do
      if other.length > Current.length - from then
        None
      else
        if Current.matches_at(other, from, 0) then
          Some(from)
        else
          if from = Current.length then
            None
          else
            Current.index_of(other, from + 1)
          end
        end
      end
    ensure
      found: Result.is_some implies
        (from <= Result.get and Result.get + other.length <= Current.length and
         (forall k: NAT. k < other.length implies
           LIST_OPS.at(Current.model, Result.get + k) = LIST_OPS.at(other.model, k)))
      first: Result.is_some implies
        (forall p: NAT. (from <= p and p < Result.get) implies not Current.matches_at(other, p, 0))
      absent: not Result.is_some implies
        (forall p: NAT. (from <= p and p + other.length <= Current.length) implies
          not Current.matches_at(other, p, 0))
    end

specify {EQ}

  law reflexive(a: BYTES)
    ensure
      refl: a.equals(a)
    end

  law symmetric(a: BYTES, b: BYTES)
    require
      ab: a.equals(b)
    ensure
      ba: b.equals(a)
    end

  law transitive(a: BYTES, b: BYTES, c: BYTES)
    require
      ab: a.equals(b)
      bc: b.equals(c)
    ensure
      ac: a.equals(c)
    end

invariant
  size_matches: size = items.length
  valid_octets: all_octets(items)

end
