module STRING satisfies ORD

-- Verification model of the prelude text type (spec §6.4.C). The bytes are an RFC 3629
-- UTF-8 sequence, one octet per list element; the logical value is the scalar sequence
-- `chars = BYTES.decode_utf8(bytes)`. The C11 runtime stores the same octets packed in a
-- contiguous buffer (`GardelString`), so the list is the model, not the memory layout.
-- The UTF-8 theory (`valid_utf8`, `decode_utf8` and their proven laws) lives in BYTES.
representation {NONE}
  bytes: LIST[U64]
  size: NAT
  char_count: NAT
  limit: NAT

create {ANY}

  make_empty(cap: NAT): STRING
    require
      positive_cap: cap > 0
    do
      { bytes = LIST.empty, size = 0, char_count = 0, limit = cap }
    ensure
      empty_bytes: Result.byte_length = 0
      empty_chars: Result.chars = LIST.empty
      empty_count: Result.code_point_count = 0
      empty_str: Result.is_empty
      capacity_set: Result.capacity = cap
    end

  -- Boundary decoding (spec §11): accepts exactly the well-formed UTF-8 inputs.
  from_utf8(bytes: BYTES): RESULT[STRING_ERROR, STRING]
    do
      match validate_and_count(bytes.to_list, 0)
        case Error(e) then
          Error(e)
        case Ok(count) then
          let cap = if bytes.length = 0 then 1 else bytes.length end
          Ok({ bytes = bytes.to_list,
               size = bytes.length,
               char_count = count,
               limit = cap })
      end
    ensure
      ok_iff_valid: Result.is_ok = BYTES.valid_utf8(bytes.model)
      ok_chars: Result.is_ok implies Result.get.chars = BYTES.decode_utf8(bytes.model)
      ok_len: Result.is_ok implies Result.get.byte_length = bytes.length
      ok_points: Result.is_ok implies Result.get.code_point_count = Result.get.chars.length
    end

  -- ASCII white space: space, tab, line feed and carriage return.
  is_space(c: CHAR): BOOL
    do
      c.code = 32 or c.code = 9 or c.code = 10 or c.code = 13
    end

create {NONE}

  nth_char(bs: LIST[U64], i: NAT): CHAR
    require
      valid: BYTES.valid_utf8(bs)
      in_bounds: i < BYTES.decode_utf8(bs).length
    variant
      bs.length
    do
      if bs.head < 128 then
        if i = 0 then
          CHAR.from_scalar(bs.head)
        else
          nth_char(bs.tail, i - 1)
        end
      else
        if bs.head <= 223 then
          if i = 0 then
            CHAR.from_scalar((bs.head - 192) * 64 + (bs.tail.head - 128))
          else
            nth_char(bs.tail.tail, i - 1)
          end
        else
          if bs.head <= 239 then
            if i = 0 then
              CHAR.from_scalar((bs.head - 224) * 4096 + (bs.tail.head - 128) * 64 + (bs.tail.tail.head - 128))
            else
              nth_char(bs.tail.tail.tail, i - 1)
            end
          else
            if i = 0 then
              CHAR.from_scalar((bs.head - 240) * 262144 + (bs.tail.head - 128) * 4096 + (bs.tail.tail.head - 128) * 64 + (bs.tail.tail.tail.head - 128))
            else
              nth_char(bs.tail.tail.tail.tail, i - 1)
            end
          end
        end
      end
    ensure
      matches_ops: Result = LIST_OPS.at(BYTES.decode_utf8(bs), i)
    end

  -- Validates `bs` and counts its scalars. `offset` is the position of `bs` in the whole
  -- input (for error reports). For a multi-byte lead the checks run in a fixed order:
  -- (1) each continuation byte that is present must be in 0x80..0xBF (`InvalidByte`),
  -- (2) the sequence must be complete (`TruncatedSequence`), (3) the lead-specific
  -- second-byte range (overlong `E0`/`F0`, surrogate `ED`, above U+10FFFF `F4`).
  -- The C runtime decoder (`gardel_io_read_line_result`) uses the same order.
  validate_and_count(bs: LIST[U64], offset: NAT): RESULT[STRING_ERROR, NAT]
    require
      fits: offset <= 18446744073709551615 - bs.length
    variant
      bs.length
    do
      if bs.length = 0 then
        Ok(0)
      else
        if bs.head < 128 then
          match validate_and_count(bs.tail, offset + 1)
            case Error(e) then Error(e)
            case Ok(n)    then Ok(n + 1)
          end
        else
          if bs.head >= 194 and bs.head <= 223 then
            if bs.length < 2 then
              Error(TruncatedSequence(offset, 2))
            else
              if bs.tail.head < 128 or bs.tail.head > 191 then
                Error(InvalidByte(offset + 1, bs.tail.head))
              else
                match validate_and_count(bs.tail.tail, offset + 2)
                  case Error(e) then Error(e)
                  case Ok(n)    then Ok(n + 1)
                end
              end
            end
          else
            if bs.head >= 224 and bs.head <= 239 then
              if bs.length < 2 then
                Error(TruncatedSequence(offset, 3))
              else
                if bs.tail.head < 128 or bs.tail.head > 191 then
                  Error(InvalidByte(offset + 1, bs.tail.head))
                else
                  if bs.length < 3 then
                    Error(TruncatedSequence(offset, 3))
                  else
                    if bs.tail.tail.head < 128 or bs.tail.tail.head > 191 then
                      Error(InvalidByte(offset + 2, bs.tail.tail.head))
                    else
                      if bs.head = 224 and bs.tail.head < 160 then
                        Error(OverlongEncoding(offset))
                      else
                        if bs.head = 237 and bs.tail.head >= 160 then
                          Error(UnpairedSurrogate(offset))
                        else
                          match validate_and_count(bs.tail.tail.tail, offset + 3)
                            case Error(e) then Error(e)
                            case Ok(n)    then Ok(n + 1)
                          end
                        end
                      end
                    end
                  end
                end
              end
            else
              if bs.head >= 240 and bs.head <= 244 then
                if bs.length < 2 then
                  Error(TruncatedSequence(offset, 4))
                else
                  if bs.tail.head < 128 or bs.tail.head > 191 then
                    Error(InvalidByte(offset + 1, bs.tail.head))
                  else
                    if bs.length < 3 then
                      Error(TruncatedSequence(offset, 4))
                    else
                      if bs.tail.tail.head < 128 or bs.tail.tail.head > 191 then
                        Error(InvalidByte(offset + 2, bs.tail.tail.head))
                      else
                        if bs.length < 4 then
                          Error(TruncatedSequence(offset, 4))
                        else
                          if bs.tail.tail.tail.head < 128 or bs.tail.tail.tail.head > 191 then
                            Error(InvalidByte(offset + 3, bs.tail.tail.tail.head))
                          else
                            if bs.head = 240 and bs.tail.head < 144 then
                              Error(OverlongEncoding(offset))
                            else
                              if bs.head = 244 and bs.tail.head > 143 then
                                Error(InvalidByte(offset + 1, bs.tail.head))
                              else
                                match validate_and_count(bs.tail.tail.tail.tail, offset + 4)
                                  case Error(e) then Error(e)
                                  case Ok(n)    then Ok(n + 1)
                                end
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                end
              else
                if bs.head >= 192 and bs.head <= 193 then
                  Error(OverlongEncoding(offset))
                else
                  Error(InvalidByte(offset, bs.head))
                end
              end
            end
          end
        end
      end
    ensure
      valid_iff: Result.is_ok = BYTES.valid_utf8(bs)
      ok_count: Result.is_ok implies (BYTES.decode_utf8(bs).length = Result.get)
      ok_bounded: Result.is_ok implies (Result.get <= bs.length)
    end

specify {ANY}

  byte_model: LIST[U64]
    do
      Current.bytes
    end

  chars: LIST[CHAR]
    do
      BYTES.decode_utf8(Current.bytes)
    ensure
      def: Result = BYTES.decode_utf8(Current.byte_model)
    end

feature {ANY}

  -- Byte equality. Since decoding is injective on well-formed UTF-8 (BYTES law
  -- `decode_injective`), it is exactly equality of the scalar sequences.
  equals(other: STRING): BOOL
    do
      Current.bytes = other.bytes
    ensure
      byte_equality: Result = (Current.byte_model = other.byte_model)
      char_equality: Result = (Current.chars = other.chars)
    end

  byte_length: NAT
    do
      Current.size
    ensure
      matches_bytes: Result = Current.byte_model.length
    end

  code_point_count: NAT
    do
      Current.char_count
    ensure
      def: Result = Current.chars.length
    end

  capacity: NAT
    do
      Current.limit
    ensure
      at_least_byte_length: Result >= Current.byte_length
    end

  is_empty: BOOL
    do
      Current.char_count = 0
    ensure
      def: Result = (Current.byte_length = 0)
      char_def: Result = (Current.code_point_count = 0)
      empty_chars: Result = (Current.chars = LIST.empty)
    end

  character_at(index: NAT): CHAR
    require
      in_bounds: index < Current.code_point_count
    do
      nth_char(Current.bytes, index)
    ensure
      model_at: Result = LIST_OPS.at(Current.chars, index)
    end

  -- Byte order of the UTF-8 form (decision 3), for map keys. Not a collation.
  less_than(other: STRING): BOOL
    do
      BYTES.list_less(Current.bytes, other.bytes)
    ensure
      byte_order: Result = BYTES.list_less(Current.byte_model, other.byte_model)
    end

  -- The scalars from index `lo` up to, not including, `hi`. In C it shares this buffer.
  slice(lo: NAT, hi: NAT): STRING
    require
      ordered: lo <= hi
      in_bounds: hi <= Current.code_point_count
    do
      let a = BYTES.utf8_offset(Current.bytes, lo)
      check
        first_left: BYTES.utf8_split_left(Current.bytes, lo)
        first_right: BYTES.utf8_split_right(Current.bytes, lo)
      end
      let rest = BYTES.list_drop(Current.bytes, a)
      let b = BYTES.utf8_offset(rest, hi - lo)
      check
        second_left: BYTES.utf8_split_left(rest, hi - lo)
        second_right: BYTES.utf8_split_right(rest, hi - lo)
      end
      { bytes = BYTES.list_take(rest, b),
        size = b,
        char_count = hi - lo,
        limit = if b = 0 then 1 else b end }
    ensure
      count: Result.code_point_count = hi - lo
      no_longer: Result.byte_length <= Current.byte_length
      chars_slice: Result.chars = BYTES.list_take(BYTES.list_drop(Current.chars, lo), hi - lo)
    end

  -- Whether `other` occurs at scalar index `offset`, from its index `i` on.
  matches_at(other: STRING, offset: NAT, i: NAT): BOOL
    require
      within: i <= other.code_point_count
      not_longer: other.code_point_count <= Current.code_point_count
      in_bounds: offset <= Current.code_point_count - other.code_point_count
    variant
      other.code_point_count - i
    do
      if i = other.code_point_count then
        True
      else
        if Current.character_at(offset + i) = other.character_at(i) then
          Current.matches_at(other, offset, i + 1)
        else
          False
        end
      end
    ensure
      all_match: Result = (forall k: NAT. (i <= k and k < other.code_point_count) implies
        LIST_OPS.at(Current.chars, offset + k) = LIST_OPS.at(other.chars, k))
    end

  starts_with(prefix: STRING): BOOL
    do
      if prefix.code_point_count > Current.code_point_count then
        False
      else
        Current.matches_at(prefix, 0, 0)
      end
    ensure
      def: Result = (prefix.code_point_count <= Current.code_point_count and
        (forall k: NAT. k < prefix.code_point_count implies
          LIST_OPS.at(Current.chars, k) = LIST_OPS.at(prefix.chars, k)))
    end

  ends_with(suffix: STRING): BOOL
    do
      if suffix.code_point_count > Current.code_point_count then
        False
      else
        Current.matches_at(suffix, Current.code_point_count - suffix.code_point_count, 0)
      end
    ensure
      def: Result = (suffix.code_point_count <= Current.code_point_count and
        (forall k: NAT. k < suffix.code_point_count implies
          LIST_OPS.at(Current.chars, Current.code_point_count - suffix.code_point_count + k) =
          LIST_OPS.at(suffix.chars, k)))
    end

  -- The first scalar index at or after `from` where `other` occurs.
  find(other: STRING, from: NAT): OPTION[NAT]
    require
      in_bounds: from <= Current.code_point_count
    variant
      Current.code_point_count - from
    do
      if other.code_point_count > Current.code_point_count - from then
        None
      else
        if Current.matches_at(other, from, 0) then
          Some(from)
        else
          if from = Current.code_point_count then
            None
          else
            Current.find(other, from + 1)
          end
        end
      end
    ensure
      found: Result.is_some implies
        (from <= Result.get and Result.get + other.code_point_count <= Current.code_point_count and
         (forall k: NAT. k < other.code_point_count implies
           LIST_OPS.at(Current.chars, Result.get + k) = LIST_OPS.at(other.chars, k)))
    end

  -- The first scalar index at or after `from` that holds `c`.
  find_char(c: CHAR, from: NAT): OPTION[NAT]
    require
      in_bounds: from <= Current.code_point_count
    variant
      Current.code_point_count - from
    do
      if from = Current.code_point_count then
        None
      else
        if Current.character_at(from) = c then
          Some(from)
        else
          Current.find_char(c, from + 1)
        end
      end
    ensure
      found: Result.is_some implies
        (from <= Result.get and Result.get < Current.code_point_count and
         LIST_OPS.at(Current.chars, Result.get) = c)
      first: Result.is_some implies
        (forall k: NAT. (from <= k and k < Result.get) implies LIST_OPS.at(Current.chars, k) != c)
      absent: not Result.is_some implies
        (forall k: NAT. (from <= k and k < Current.code_point_count) implies
          LIST_OPS.at(Current.chars, k) != c)
    end

  -- The first index at or after `i` that is not ASCII white space, or the length.
  space_end(i: NAT): NAT
    require
      in_bounds: i <= Current.code_point_count
    variant
      Current.code_point_count - i
    do
      if i = Current.code_point_count then
        i
      else
        if STRING.is_space(Current.character_at(i)) then
          Current.space_end(i + 1)
        else
          i
        end
      end
    ensure
      after: i <= Result and Result <= Current.code_point_count
      skipped: forall k: NAT. (i <= k and k < Result) implies STRING.is_space(LIST_OPS.at(Current.chars, k))
      stops: Result < Current.code_point_count implies not STRING.is_space(LIST_OPS.at(Current.chars, Result))
    end

  -- Going down from `j`, but not below `floor`: the start of the white space that ends at `j`.
  space_start(j: NAT, floor: NAT): NAT
    require
      ordered: floor <= j
      in_bounds: j <= Current.code_point_count
    variant
      j
    do
      if j = floor then
        j
      else
        if STRING.is_space(Current.character_at(j - 1)) then
          Current.space_start(j - 1, floor)
        else
          j
        end
      end
    ensure
      before: floor <= Result and Result <= j
      skipped: forall k: NAT. (Result <= k and k < j) implies STRING.is_space(LIST_OPS.at(Current.chars, k))
      stops: Result > floor implies not STRING.is_space(LIST_OPS.at(Current.chars, Result - 1))
    end

  -- Without ASCII white space (space, tab, line feed, carriage return) at either end.
  trim: STRING
    do
      let lo = Current.space_end(0)
      Current.slice(lo, Current.space_start(Current.code_point_count, lo))
    ensure
      no_longer: Result.byte_length <= Current.byte_length
      trimmed: Result.chars = BYTES.list_take(
        BYTES.list_drop(Current.chars, Current.space_end(0)),
        Current.space_start(Current.code_point_count, Current.space_end(0)) - Current.space_end(0))
    end

  -- How many times `c` occurs from index `i` on.
  count_char(c: CHAR, i: NAT): NAT
    require
      in_bounds: i <= Current.code_point_count
    variant
      Current.code_point_count - i
    do
      if i = Current.code_point_count then
        0
      else
        if Current.character_at(i) = c then
          Current.count_char(c, i + 1) + 1
        else
          Current.count_char(c, i + 1)
        end
      end
    ensure
      bounded: Result <= Current.code_point_count - i
      -- Each step as a contract, which holds at every fuel (see `BYTES.utf8_offset`).
      at_end: i = Current.code_point_count implies Result = 0
      hit: (i < Current.code_point_count and LIST_OPS.at(Current.chars, i) = c) implies
        Result = Current.count_char(c, i + 1) + 1
      miss: (i < Current.code_point_count and LIST_OPS.at(Current.chars, i) != c) implies
        Result = Current.count_char(c, i + 1)
    end

  -- The parts between occurrences of `sep`, from index `start`, scanning at `i`.
  split_from(sep: CHAR, start: NAT, i: NAT): LIST[STRING]
    require
      ordered: start <= i
      in_bounds: i <= Current.code_point_count
    variant
      Current.code_point_count - i
    do
      if i = Current.code_point_count then
        LIST.singleton(Current.slice(start, i))
      else
        if Current.character_at(i) = sep then
          Current.split_from(sep, i + 1, i + 1).prepend(Current.slice(start, i))
        else
          Current.split_from(sep, start, i + 1)
        end
      end
    ensure
      parts: Result.length = Current.count_char(sep, i) + 1
    end

  -- `"a,b,,c".split(',')` is `["a", "b", "", "c"]`: one more part than there are separators.
  split(sep: CHAR): LIST[STRING]
    do
      Current.split_from(sep, 0, 0)
    ensure
      parts: Result.length = Current.count_char(sep, 0) + 1
    end

  -- The only precondition is that the total byte length is representable.
  concat(other: STRING): STRING
    require
      fits: Current.byte_length <= 18446744073709551615 - other.byte_length
    do
      { bytes = Current.bytes.append(other.bytes),
        size = Current.size + other.size,
        char_count = Current.char_count + other.char_count,
        limit = if Current.size + other.size = 0 then 1 else Current.size + other.size end }
    ensure
      bytes_appended: Result.byte_length = Current.byte_length + other.byte_length
      chars_appended: Result.code_point_count = Current.code_point_count + other.code_point_count
      chars_model: Result.chars = Current.chars.append(other.chars)
    end

  to_utf8: BYTES
    do
      BYTES.from_list(Current.bytes)
    ensure
      model_matches: Result.model = Current.byte_model
      valid: BYTES.valid_utf8(Result.model)
    end

  -- Builders used by string-literal desugaring (§3.1.4). Each prepends one complete,
  -- well-formed encoded scalar.
  push_ascii(c: CHAR): STRING
    require
      is_ascii: c.code < 128
      has_room: Current.byte_length < Current.capacity
    do
      { bytes = Current.bytes.prepend(c.code),
        size = Current.size + 1,
        char_count = Current.char_count + 1,
        limit = Current.limit }
    ensure
      grew: Result.byte_length = Current.byte_length + 1
      code_point_grew: Result.code_point_count = Current.code_point_count + 1
      chars_prepended: Result.chars = Current.chars.prepend(c)
      non_empty: not Result.is_empty
      same_capacity: Result.capacity = Current.capacity
    end

  push_utf8_2(b0: U64, b1: U64): STRING
    require
      valid_prefix: b0 >= 194 and b0 <= 223
      valid_cont: b1 >= 128 and b1 <= 191
      has_room: Current.byte_length + 2 <= Current.capacity
    do
      { bytes = Current.bytes.prepend(b1).prepend(b0),
        size = Current.size + 2,
        char_count = Current.char_count + 1,
        limit = Current.limit }
    ensure
      grew: Result.byte_length = Current.byte_length + 2
      code_point_grew: Result.code_point_count = Current.code_point_count + 1
      chars_prepended: Result.chars = Current.chars.prepend(CHAR.from_scalar((b0 - 192) * 64 + (b1 - 128)))
      non_empty: not Result.is_empty
      same_capacity: Result.capacity = Current.capacity
    end

  push_utf8_3(b0: U64, b1: U64, b2: U64): STRING
    require
      valid_prefix: b0 >= 224 and b0 <= 239
      valid_cont1: if b0 = 224 then (b1 >= 160 and b1 <= 191)
                   else if b0 = 237 then (b1 >= 128 and b1 <= 159)
                   else (b1 >= 128 and b1 <= 191) end end
      valid_cont2: b2 >= 128 and b2 <= 191
      has_room: Current.byte_length + 3 <= Current.capacity
    do
      { bytes = Current.bytes.prepend(b2).prepend(b1).prepend(b0),
        size = Current.size + 3,
        char_count = Current.char_count + 1,
        limit = Current.limit }
    ensure
      grew: Result.byte_length = Current.byte_length + 3
      code_point_grew: Result.code_point_count = Current.code_point_count + 1
      chars_prepended: Result.chars = Current.chars.prepend(CHAR.from_scalar((b0 - 224) * 4096 + (b1 - 128) * 64 + (b2 - 128)))
      non_empty: not Result.is_empty
      same_capacity: Result.capacity = Current.capacity
    end

  push_utf8_4(b0: U64, b1: U64, b2: U64, b3: U64): STRING
    require
      valid_prefix: b0 >= 240 and b0 <= 244
      valid_cont1: if b0 = 240 then (b1 >= 144 and b1 <= 191)
                   else if b0 = 244 then (b1 >= 128 and b1 <= 143)
                   else (b1 >= 128 and b1 <= 191) end end
      valid_cont2: b2 >= 128 and b2 <= 191
      valid_cont3: b3 >= 128 and b3 <= 191
      has_room: Current.byte_length + 4 <= Current.capacity
    do
      { bytes = Current.bytes.prepend(b3).prepend(b2).prepend(b1).prepend(b0),
        size = Current.size + 4,
        char_count = Current.char_count + 1,
        limit = Current.limit }
    ensure
      grew: Result.byte_length = Current.byte_length + 4
      code_point_grew: Result.code_point_count = Current.code_point_count + 1
      chars_prepended: Result.chars = Current.chars.prepend(CHAR.from_scalar((b0 - 240) * 262144 + (b1 - 128) * 4096 + (b2 - 128) * 64 + (b3 - 128)))
      non_empty: not Result.is_empty
      same_capacity: Result.capacity = Current.capacity
    end

specify {EQ}

  law reflexive(a: STRING)
    ensure
      refl: a.equals(a)
    end

  law symmetric(a: STRING, b: STRING)
    require
      ab: a.equals(b)
    ensure
      ba: b.equals(a)
    end

  law transitive(a: STRING, b: STRING, c: STRING)
    require
      ab: a.equals(b)
      bc: b.equals(c)
    ensure
      ac: a.equals(c)
    end

specify {ORD}

  law irreflexive(a: STRING)
    do
      BYTES.less_irreflexive(a.byte_model)
    ensure
      not_less_than_self: not a.less_than(a)
    end

  law transitive(a: STRING, b: STRING, c: STRING)
    require
      a_lt_b: a.less_than(b)
      b_lt_c: b.less_than(c)
    do
      BYTES.less_transitive(a.byte_model, b.byte_model, c.byte_model)
    ensure
      a_lt_c: a.less_than(c)
    end

  law total(a: STRING, b: STRING)
    do
      BYTES.less_total(a.byte_model, b.byte_model)
    ensure
      comparable: a.less_than(b) or a.equals(b) or b.less_than(a)
    end

invariant
  positive_capacity: limit > 0
  size_matches: size = bytes.length
  char_count_matches: char_count = BYTES.decode_utf8(bytes).length
  char_count_bounded: char_count <= size
  within_bounds: size <= limit
  valid_bytes: BYTES.valid_utf8(bytes)

end
