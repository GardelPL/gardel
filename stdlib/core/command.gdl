module COMMAND

representation {ANY}
  | Print(text: STRING)
  | SetTimer(id: NAT, millis: U64)
  | ReadLine
  | ReadKey
  | Listen(port: NAT)
  | Send(conn: CONN_ID, data: BYTES)
  | Close(conn: CONN_ID)
  | Connect(tag: NAT, host: STRING, port: NAT)
  | CancelTimer(id: NAT)
  | Write(text: STRING)
  | TerminalSize
  | ReadFile(tag: NAT, path: STRING)
  | ListDir(tag: NAT, path: STRING)
  | RunProcess(tag: NAT, program: STRING, args: LIST[STRING], dir: STRING)
  | WriteProcess(proc: PROC_ID, data: BYTES)
  | CloseInput(proc: PROC_ID)
  | StopProcess(proc: PROC_ID)
  | RunAttached(tag: NAT, program: STRING, args: LIST[STRING], dir: STRING)

end
