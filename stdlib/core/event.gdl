module EVENT

representation {ANY}
  | Tick(id: NAT)
  | Line(res: RESULT[IO_ERROR, STRING])
  | Key(key: KEY)
  | Shutdown

feature {ANY}

  -- `=` is not available on EVENT, which will hold STRING and BYTES payloads (spec §9, §11.6).
  is_shutdown: BOOL
    do
      match Current
        case Shutdown then True
        case _ then False
      end
    end

end
