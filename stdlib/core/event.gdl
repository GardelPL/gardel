module EVENT

representation {ANY}
  | Tick(id: NAT)
  | Line(res: RESULT[IO_ERROR, STRING])
  | Key(key: KEY)
  | Accepted(conn: CONN_ID)
  | ListenFailed(port: NAT, err: IO_ERROR)
  | Received(conn: CONN_ID, data: BYTES)
  | SendFailed(conn: CONN_ID, err: IO_ERROR)
  | Closed(conn: CONN_ID)
  | Shutdown
  | Connected(tag: NAT, conn: CONN_ID)
  | ConnectFailed(tag: NAT, err: IO_ERROR)
  | Resized(width: NAT, height: NAT)
  | FileRead(tag: NAT, res: RESULT[IO_ERROR, BYTES])
  | DirListed(tag: NAT, res: RESULT[IO_ERROR, LIST[DIR_ENTRY]])
  | ProcessStarted(tag: NAT, proc: PROC_ID)
  | ProcessFailed(tag: NAT, err: IO_ERROR)
  | ProcessOutput(proc: PROC_ID, data: BYTES)
  | ProcessErrorOutput(proc: PROC_ID, data: BYTES)
  | ProcessExited(proc: PROC_ID, code: I64)
  | AttachedEnded(tag: NAT, res: RESULT[IO_ERROR, I64])
| FileWritten(tag: NAT, res: RESULT[IO_ERROR, NAT])
| Pasted(text: STRING)

feature {ANY}

  -- `=` is not available on EVENT, which holds STRING and BYTES payloads (spec §9, §11.6).
  is_shutdown: BOOL
    do
      match Current
        case Shutdown then True
        case _ then False
      end
    ensure
      def: Result = (match Current case Shutdown then True case _ then False end)
    end

end
