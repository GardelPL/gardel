-- A grid of cells, `width` by `height`, each at most 65535, which a view draws on. Drawing
-- is clipped: `text` and `fill` change only the cells inside both the rectangle they are
-- given and the screen, so a widget given a rectangle cannot draw outside it. Text takes
-- the columns a terminal gives it (`CHAR_WIDTH`), and a wide character that would be cut by
-- the edge is not drawn: a space in its style is. A screen may
-- show the terminal's cursor at one of its cells (`with_cursor`), where typing goes.
module SCREEN

representation {NONE}
  wide: NAT
  high: NAT
  lines: LIST[LIST[CELL]]
  cur_x: NAT
  cur_y: NAT
  cur_on: BOOL

invariant
  fits: wide <= 65535 and high <= 65535
  cursor_inside: cur_on implies cur_x < wide and cur_y < high

create {ANY}

  -- A screen of blank cells, at most 65535 by 65535.
  blank(w: NAT, h: NAT): SCREEN
    do
      let cw = if w <= 65535 then w else 65535 end
      let ch = if h <= 65535 then h else 65535 end
      let row: LIST[CELL] = LIST_CUT.repeat(CELL.blank, cw, LIST.empty)
      let none: LIST[LIST[CELL]] = LIST.empty
      { wide = cw, high = ch, lines = LIST_CUT.repeat(row, ch, none), cur_x = 0, cur_y = 0, cur_on = False }
    ensure
      width_set: w <= 65535 implies Result.width = w
      height_set: h <= 65535 implies Result.height = h
      no_cursor: not Result.cursor_shown
    end

  -- Row `y` of `rows`, or no cells past the last row.
  nth_row(rows: LIST[LIST[CELL]], y: NAT): LIST[CELL]
    variant
      y
    do
      if rows.length = 0 then LIST.empty
      else if y = 0 then rows.head
      else SCREEN.nth_row(rows.tail, y - 1)
      end end
    end

  -- `rows` with `cells` put on row `y` from column `x`.
  put_in(rows: LIST[LIST[CELL]], y: NAT, x: NAT, cells: LIST[CELL]): LIST[LIST[CELL]]
    require
      left: x <= 65535
      short: cells.length <= 65535
    variant
      y
    do
      if rows.length = 0 then rows
      else if y = 0 then rows.tail.prepend(SCREEN.splice(rows.head, x, cells))
      else SCREEN.put_in(rows.tail, y - 1, x, cells).prepend(rows.head)
      end end
    end

  -- `row` with `cells` from column `x`, padded with blanks when it is shorter than `x`. A wide
  -- character cut in half, on either side of `cells` or at either end of them, leaves a space
  -- in its style where its other half was, so every left half is followed by its right half
  -- and every right half follows its left one.
  splice(row: LIST[CELL], x: NAT, cells: LIST[CELL]): LIST[CELL]
    require
      left: x <= 65535
      short: cells.length <= 65535
    do
      if cells.length = 0 then
        row
      else
      let before = SCREEN.mend_last(LIST_CUT.take(row, x))
      let pad = if row.length < x then LIST_CUT.repeat(CELL.blank, x - row.length, LIST.empty) else LIST.empty end
      let after = SCREEN.mend_first(LIST_CUT.drop(row, x + cells.length))
      before.append(pad).append(SCREEN.mend_last(SCREEN.mend_first(cells))).append(after)
      end
    end

  -- `cells`, with a space for the first when it is a right half.
  mend_first(cells: LIST[CELL]): LIST[CELL]
    do
      if cells.length > 0 and cells.head.is_right_half then cells.tail.prepend(cells.head.cleared) else cells end
    ensure
      length_same: Result.length = cells.length
    end

  -- `cells`, with a space for the last when it is a left half.
  mend_last(cells: LIST[CELL]): LIST[CELL]
    do
      let none: LIST[CELL] = LIST.empty
      let back = LIST_CUT.reverse(cells, none)
      if back.length > 0 and back.head.is_left_half then
        LIST_CUT.reverse(back.tail.prepend(back.head.cleared), none)
      else
        cells
      end
    ensure
      length_same: Result.length = cells.length
    end

  -- `acc` with the cells of `chars` in style `st` in front of it, the last first, until it
  -- holds more than `room` cells. A wide character or wide grapheme cluster takes two cells,
  -- and zero-width characters, ZWJ sequences, emoji modifiers, regional-indicator flag pairs,
  -- and variation selectors are grouped as marks on their base cell.
  -- TODO(proof-GT.8): prove wide-character invariant (every left half is followed by its right half) and termination variant
  styled_into(chars: LIST[CHAR], st: STYLE, room: NAT, acc: LIST[CELL]): LIST[CELL]
    do
      SCREEN.styled_clusters_into(chars, st, room, acc, False, False)
    end

  -- Segment `chars` into cells under UAX #29 rules (`after_zwj` after U+200D, `ri_open` after
  -- an unpaired Regional Indicator).
  -- TODO(proof-GT.8): prove wide-character pairing invariant across marked_wide promotion in styled_clusters_into
  styled_clusters_into(chars: LIST[CHAR], st: STYLE, room: NAT, acc: LIST[CELL], after_zwj: BOOL, ri_open: BOOL): LIST[CELL]
    variant
      chars.length
    do
      if chars.length = 0 then
        acc
      else
        let c = chars.head
        let w = CHAR_WIDTH.of(c)
        let has_cluster = acc.length > 0
        if after_zwj and has_cluster then
          let promote = w = 2 or CHAR_WIDTH.is_skin_tone(c) or CHAR_WIDTH.is_vs16(c)
          let next_acc = if promote then SCREEN.marked_wide(acc, c) else SCREEN.marked(acc, c) end
          SCREEN.styled_clusters_into(chars.tail, st, room, next_acc, CHAR_WIDTH.is_zwj(c), False)
        else if CHAR_WIDTH.is_zwj(c) then
          SCREEN.styled_clusters_into(chars.tail, st, room, SCREEN.marked(acc, c), has_cluster, False)
        else if (CHAR_WIDTH.is_vs16(c) or CHAR_WIDTH.is_skin_tone(c)) and has_cluster then
          SCREEN.styled_clusters_into(chars.tail, st, room, SCREEN.marked_wide(acc, c), False, False)
        else if w = 0 then
          SCREEN.styled_clusters_into(chars.tail, st, room, SCREEN.marked(acc, c), False, False)
        else if CHAR_WIDTH.is_regional_indicator(c) and ri_open and has_cluster then
          SCREEN.styled_clusters_into(chars.tail, st, room, SCREEN.marked_wide(acc, c), False, False)
        else if acc.length > room then
          acc
        else if CHAR_WIDTH.is_regional_indicator(c) then
          SCREEN.styled_clusters_into(chars.tail, st, room, acc.prepend(CELL.make(c, st)), False, True)
        else if w = 2 and CELL.is_printable(c) then
          SCREEN.styled_clusters_into(chars.tail, st, room, acc.prepend(CELL.wide(c, st)).prepend(CELL.right_half(st)), False, False)
        else
          SCREEN.styled_clusters_into(chars.tail, st, room, acc.prepend(CELL.make(c, st)), False, False)
        end end end end end end end end
      end
    end

  -- `acc`, the last first, with the mark `m` on its last character.
  marked(acc: LIST[CELL], m: CHAR): LIST[CELL]
    do
      if acc.length = 0 then
        acc
      else if acc.head.is_right_half then
        if acc.tail.length = 0 then acc else acc.tail.tail.prepend(acc.tail.head.with_mark(m)).prepend(acc.head) end
      else
        acc.tail.prepend(acc.head.with_mark(m))
      end end
    ensure
      length_same: Result.length = acc.length
    end

  -- `acc`, the last first, with `m` attached to its last cluster and that cluster promoted to
  -- two cells wide if it was one cell wide.
  marked_wide(acc: LIST[CELL], m: CHAR): LIST[CELL]
    do
      if acc.length = 0 then
        acc
      else if acc.head.is_right_half then
        SCREEN.marked(acc, m)
      else
        let left_cell = acc.head.as_wide.with_mark(m)
        acc.tail.prepend(left_cell).prepend(CELL.right_half(left_cell.style))
      end end
    end

  -- `drawn`, when it is the size of `blank`, and `blank` otherwise.
  fitted(drawn: SCREEN, blank: SCREEN): SCREEN
    do
      if drawn.width = blank.width and drawn.height = blank.height then drawn else blank end
    ensure
      same_width: Result.width = blank.width
      same_height: Result.height = blank.height
    end

feature {ANY}

  width: NAT
    do
      Current.wide
    ensure
      fits: Result <= 65535
    end

  height: NAT
    do
      Current.high
    ensure
      fits: Result <= 65535
    end

  -- Whether the terminal's cursor is shown, at (`cursor_x`, `cursor_y`).
  cursor_shown: BOOL
    do
      Current.cur_on
    ensure
      inside: Result implies Current.cursor_x < Current.width and Current.cursor_y < Current.height
    end

  cursor_x: NAT
    do
      Current.cur_x
    end

  cursor_y: NAT
    do
      Current.cur_y
    end

  -- The screen with the cursor shown at column `x`, row `y`, or hidden when that is not one
  -- of its cells.
  with_cursor(x: NAT, y: NAT): SCREEN
    do
      if x < Current.wide and y < Current.high then
        { Current with cur_x = x, cur_y = y, cur_on = True }
      else
        { Current with cur_on = False }
      end
    ensure
      same_width: Result.width = Current.width
      same_height: Result.height = Current.height
      shown: Result.cursor_shown = (x < Current.width and y < Current.height)
      at_x: Result.cursor_shown implies Result.cursor_x = x
      at_y: Result.cursor_shown implies Result.cursor_y = y
    end

  -- Whether `other` puts the cursor where this screen does: both hide it, or both show it at
  -- the same cell.
  same_cursor(other: SCREEN): BOOL
    do
      if Current.cur_on then
        other.cursor_shown and other.cursor_x = Current.cur_x and other.cursor_y = Current.cur_y
      else
        not other.cursor_shown
      end
    end

  -- The whole screen as a rectangle.
  area: RECT
    do
      RECT.make(0, 0, Current.wide, Current.high)
    ensure
      at_origin: Result.x = 0 and Result.y = 0
      width_same: Result.width = Current.width
      height_same: Result.height = Current.height
    end

  -- The cells of row `y`, none past the bottom.
  row(y: NAT): LIST[CELL]
    do
      if y < Current.high then SCREEN.nth_row(Current.lines, y) else LIST.empty end
    end

  -- `cells` on row `y` from column `x`, those past the right edge left out.
  put(x: NAT, y: NAT, cells: LIST[CELL]): SCREEN
    do
      if y >= Current.high or x >= Current.wide then
        Current
      else
        { Current with lines = SCREEN.put_in(Current.lines, y, x, LIST_CUT.take(cells, Current.wide - x)) }
      end
    ensure
      same_width: Result.width = Current.width
      same_height: Result.height = Current.height
    end

  -- `s` in style `st` on row `y` from column `x`, only where it is inside `clip`.
  text(clip: RECT, x: NAT, y: NAT, s: STRING, st: STYLE): SCREEN
    do
      Current.glyphs(clip, x, y, GLYPHS.of_text(s), st)
    ensure
      same_width: Result.width = Current.width
      same_height: Result.height = Current.height
    end

  -- `cs` in style `st` on row `y` from column `x`, only where it is inside `clip`.
  glyphs(clip: RECT, x: NAT, y: NAT, cs: LIST[CHAR], st: STYLE): SCREEN
    do
      let edge = if clip.right < Current.wide then clip.right else Current.wide end
      let start = if x < clip.x then clip.x else x end
      if y < clip.y or y >= clip.bottom or start >= edge then
        Current
      else
        let none: LIST[CELL] = LIST.empty
        let cells = LIST_CUT.reverse(SCREEN.styled_into(cs, st, edge - x, none), none)
        let shown = LIST_CUT.take(LIST_CUT.drop(cells, start - x), edge - start)
        Current.put(start, y, shown)
      end
    ensure
      same_width: Result.width = Current.width
      same_height: Result.height = Current.height
    end

  -- Every cell inside `clip` set to `c` in style `st`.
  fill(clip: RECT, c: CHAR, st: STYLE): SCREEN
    do
      let edge = if clip.right < Current.wide then clip.right else Current.wide end
      let last = if clip.bottom < Current.high then clip.bottom else Current.high end
      if clip.x >= edge or clip.y >= last then
        Current
      else
        let cells = LIST_CUT.repeat(CELL.make(c, st), edge - clip.x, LIST.empty)
        Current.fill_rows(clip.x, clip.y, last, cells)
      end
    ensure
      same_width: Result.width = Current.width
      same_height: Result.height = Current.height
    end

  -- `cells` from column `x` on every row from `y` up to `last`.
  fill_rows(x: NAT, y: NAT, last: NAT, cells: LIST[CELL]): SCREEN
    variant
      last - y
    do
      if y >= last then Current else Current.put(x, y, cells).fill_rows(x, y + 1, last, cells) end
    ensure
      same_width: Result.width = Current.width
      same_height: Result.height = Current.height
    end

end
