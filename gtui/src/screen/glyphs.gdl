-- Characters in and out of UTF-8, as a screen needs them at run time: the characters of a
-- `STRING`, and the bytes of a `CHAR`. A `STRING` is always well-formed, so the `?` that
-- `decode` gives for a malformed sequence is never seen; it keeps `decode` total.
functions GLYPHS

feature {ANY}

  -- The characters of `s`, in order.
  of_text(s: STRING): LIST[CHAR]
    do
      LIST_CUT.reverse(GLYPHS.decode(s.to_utf8.to_list, LIST.empty), LIST.empty)
    end

  -- The columns `s` takes on a screen (`CHAR_WIDTH`), or 65535 when it takes more.
  width(s: STRING): NAT
    do
      GLYPHS.width_of(GLYPHS.of_text(s))
    ensure
      fits: Result <= 65535
    end

  -- The columns `cs` take on a screen, or 65535 when they take more.
  width_of(cs: LIST[CHAR]): NAT
    do
      GLYPHS.width_into(cs, 0)
    ensure
      fits: Result <= 65535
    end

  -- `acc` and the columns `cs` take under UAX #29 grapheme-cluster segmentation, or 65535 when that is more.
  -- TODO(proof-GT.8): prove GLYPHS.width_into equals the number of cells produced by SCREEN.styled_into
  width_into(cs: LIST[CHAR], acc: NAT): NAT
    require
      fits: acc <= 65535
    do
      GLYPHS.width_clusters_into(cs, acc, 0, False, False)
    ensure
      fits: Result <= 65535
    end

  -- Accumulate cluster widths across `cs` with active cluster width `cur_w` (`0..2`),
  -- `after_zwj` when the previous character was U+200D, and `ri_open` when the current cluster
  -- is an unpaired Regional Indicator.
  -- TODO(proof-GT.8): prove termination variant and width bounds across compound ZWJ/modifier/flag clusters
  width_clusters_into(cs: LIST[CHAR], acc: NAT, cur_w: NAT, after_zwj: BOOL, ri_open: BOOL): NAT
    require
      fits: acc <= 65535
      valid_cur: cur_w <= 2
    variant
      cs.length
    do
      if cs.length = 0 then
        acc
      else
        let c = cs.head
        let w = CHAR_WIDTH.of(c)
        if after_zwj and cur_w > 0 then
          let promote = cur_w = 1 and (w = 2 or CHAR_WIDTH.is_skin_tone(c) or CHAR_WIDTH.is_vs16(c))
          let next_acc = acc + (if promote then 1 else 0 end)
          let next_w = if promote then 2 else cur_w end
          if next_acc >= 65535 then
            65535
          else
            GLYPHS.width_clusters_into(cs.tail, next_acc, next_w, CHAR_WIDTH.is_zwj(c), False)
          end
        else if CHAR_WIDTH.is_zwj(c) then
          GLYPHS.width_clusters_into(cs.tail, acc, cur_w, cur_w > 0, False)
        else if (CHAR_WIDTH.is_vs16(c) or CHAR_WIDTH.is_skin_tone(c)) and cur_w > 0 then
          let delta = if cur_w = 1 then 1 else 0 end
          let next_acc = acc + delta
          if next_acc >= 65535 then
            65535
          else
            GLYPHS.width_clusters_into(cs.tail, next_acc, 2, False, False)
          end
        else if w = 0 then
          GLYPHS.width_clusters_into(cs.tail, acc, cur_w, False, False)
        else if CHAR_WIDTH.is_regional_indicator(c) then
          if ri_open and cur_w = 1 then
            let next_acc = acc + 1
            if next_acc >= 65535 then
              65535
            else
              GLYPHS.width_clusters_into(cs.tail, next_acc, 2, False, False)
            end
          else
            let next_acc = acc + 1
            if next_acc >= 65535 then
              65535
            else
              GLYPHS.width_clusters_into(cs.tail, next_acc, 1, False, True)
            end
          end
        else
          let step = if w = 2 then 2 else 1 end
          let next_acc = acc + step
          if next_acc >= 65535 then
            65535
          else
            GLYPHS.width_clusters_into(cs.tail, next_acc, step, False, False)
          end
        end end end end end
      end
    ensure
      fits: Result <= 65535
    end

  -- `n` as a character when it is a Unicode scalar value, and `?` otherwise.
  scalar(n: NAT): CHAR
    do
      if n < 1114112 and (n < 55296 or n > 57343) then CHAR.from_scalar(n) else '?' end
    end

  -- The low six bits of the item `k` of `bs`, and 64 when it is not a continuation byte or
  -- there is none.
  low_at(bs: LIST[U64], k: NAT): NAT
    do
      if k < bs.length then
        let b = LIST_OPS.at(bs, k)
        if b >= 128 and b < 192 then b - 128 else 64 end
      else
        64
      end
    ensure
      bounded: Result <= 64
    end

  -- `acc` with the characters of the UTF-8 bytes `bs` in front of it, the last first.
  decode(bs: LIST[U64], acc: LIST[CHAR]): LIST[CHAR]
    variant
      bs.length
    do
      if bs.length = 0 then
        acc
      else
        let b0 = bs.head
        let t = bs.tail
        let c1 = GLYPHS.low_at(t, 0)
        let c2 = GLYPHS.low_at(t, 1)
        let c3 = GLYPHS.low_at(t, 2)
        if b0 < 128 then
          GLYPHS.decode(t, acc.prepend(GLYPHS.scalar(b0)))
        else if b0 >= 192 and b0 < 224 and c1 < 64 then
          GLYPHS.decode(t.tail, acc.prepend(GLYPHS.scalar((b0 - 192) * 64 + c1)))
        else if b0 >= 224 and b0 < 240 and c1 < 64 and c2 < 64 then
          GLYPHS.decode(t.tail.tail, acc.prepend(GLYPHS.scalar((b0 - 224) * 4096 + c1 * 64 + c2)))
        else if b0 >= 240 and b0 < 248 and c1 < 64 and c2 < 64 and c3 < 64 then
          GLYPHS.decode(t.tail.tail.tail, acc.prepend(GLYPHS.scalar((b0 - 240) * 262144 + c1 * 4096 + c2 * 64 + c3)))
        else
          GLYPHS.decode(t, acc.prepend('?'))
        end end end end
      end
    end

  -- `out` with the UTF-8 bytes of `c`, or `out` itself when it holds a terabyte already.
  add_char(out: BYTES_BUILDER, c: CHAR): BYTES_BUILDER
    do
      let n = c.code
      if out.length > 1000000000000 then
        out
      else if n < 128 then
        out.add_byte(n)
      else if n < 2048 then
        out.add_byte(192 + n / 64).add_byte(128 + n % 64)
      else if n < 65536 then
        out.add_byte(224 + n / 4096).add_byte(128 + n / 64 % 64).add_byte(128 + n % 64)
      else if n < 2097152 then
        out.add_byte(240 + n / 262144).add_byte(128 + n / 4096 % 64).add_byte(128 + n / 64 % 64).add_byte(128 + n % 64)
      else
        out.add_byte(63)
      end end end end end
    ensure
      bounded: Result.length <= out.length + 4
    end

  -- `out` with `s`, or `out` itself when it holds a terabyte already.
  add_text(out: BYTES_BUILDER, s: STRING): BYTES_BUILDER
    do
      if out.length > 1000000000000 or s.byte_length > 1000000000000 then out else out.add_text(s) end
    end

  -- `n` spaces, or 65535 when `n` is more.
  spaces(n: NAT): STRING
    do
      let k = if n <= 65535 then n else 65535 end
      let none: LIST[CHAR] = LIST.empty
      GLYPHS.text_of(LIST_CUT.repeat(' ', k, none))
    end

  -- The text of the characters `cs`.
  text_of(cs: LIST[CHAR]): STRING
    do
      match STRING.from_utf8(GLYPHS.encode(cs, BYTES_BUILDER.empty).to_bytes)
        case Ok(s) then s
        case Error(_) then ""
      end
    end

  -- `out` with the UTF-8 bytes of `cs`.
  encode(cs: LIST[CHAR], out: BYTES_BUILDER): BYTES_BUILDER
    variant
      cs.length
    do
      if cs.length = 0 then out else GLYPHS.encode(cs.tail, GLYPHS.add_char(out, cs.head)) end
    end

  -- Display width of the longest character prefix of `cs` that fits in `max_w` columns.
  fitting_width_into(cs: LIST[CHAR], max_w: NAT, acc: NAT): NAT
    require
      bound: acc <= max_w and max_w <= 65535
    variant
      cs.length
    do
      if cs.length = 0 then
        acc
      else
        let w = CHAR_WIDTH.of(cs.head)
        if w = 0 then
          GLYPHS.fitting_width_into(cs.tail, max_w, acc)
        else if w = 1 and acc + 1 <= max_w then
          GLYPHS.fitting_width_into(cs.tail, max_w, acc + 1)
        else if w = 2 and acc + 2 <= max_w then
          GLYPHS.fitting_width_into(cs.tail, max_w, acc + 2)
        else
          acc
        end end end
      end
    ensure
      fits: Result <= 65535
    end

  -- Display width of the longest character prefix of `s` that fits in `max_w` columns.
  fitting_width(s: STRING, max_w: NAT): NAT
    require
      small: max_w <= 65535
    do
      let r = GLYPHS.fitting_width_into(GLYPHS.of_text(s), max_w, 0)
      if r <= max_w then r else max_w end
    ensure
      bounded: Result <= max_w
    end

  -- `a` followed by `b`, or `a` alone when together they would not fit a `STRING`.
  join(a: STRING, b: STRING): STRING
    do
      if a.byte_length <= 18446744073709551615 - b.byte_length then a.concat(b) else a end
    end

end
