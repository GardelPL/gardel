-- The bytes a VT terminal is sent for a list of writes: for each write, a cursor move
-- (`ESC [ row ; col H`, from 1) and its cells, with an SGR sequence wherever the style
-- changes. The pen is reset first, so a frame does not depend on what came before it. These
-- are the only control sequences a frame holds, as a cell holds no control character.
functions VT_TEXT

feature {ANY}

  -- The text of a frame: `writes`, after clearing the screen when `clear` is set.
  frame(writes: LIST[SCREEN_WRITE], clear: BOOL): STRING
    do
      let start = GLYPHS.add_text(BYTES_BUILDER.empty, if clear then "\u{1b}[0m\u{1b}[2J" else "\u{1b}[0m" end)
      let out = VT_TEXT.writes(writes, STYLE.plain, start)
      match STRING.from_utf8(out.to_bytes)
        case Ok(s) then s
        case Error(_) then ""
      end
    end

  -- The text of a frame that draws `writes`, after clearing the screen when `clear` is set,
  -- then puts the cursor where `next` has it. When the cursor was shown (`was_shown`), it is
  -- hidden while the cells are drawn, so it is never seen moving over them.
  drawn(writes: LIST[SCREEN_WRITE], clear: BOOL, was_shown: BOOL, next: SCREEN): STRING
    do
      let start = GLYPHS.add_text(BYTES_BUILDER.empty, if clear then "\u{1b}[0m\u{1b}[2J" else "\u{1b}[0m" end)
      let hidden = if was_shown then GLYPHS.add_text(start, "\u{1b}[?25l") else start end
      let out = VT_TEXT.writes(writes, STYLE.plain, hidden)
      let placed = if next.cursor_shown then GLYPHS.add_text(VT_TEXT.move(out, next.cursor_x, next.cursor_y), "\u{1b}[?25h") else out end
      match STRING.from_utf8(placed.to_bytes)
        case Ok(s) then s
        case Error(_) then ""
      end
    end

  -- Entering a full-screen interface: the alternate screen, cleared, with the cursor hidden
  -- and shaped as a bar for when a view shows it, and pastes bracketed, so that the host
  -- gives a paste as one `Pasted` event.
  enter: STRING
    do
      "\u{1b}[?1049h\u{1b}[0m\u{1b}[2J\u{1b}[?25l\u{1b}[6 q\u{1b}[?2004h"
    end

  -- Leaving it: pastes as typed, the pen reset, the cursor in the terminal's own shape and
  -- shown, and the screen that was there before.
  leave: STRING
    do
      "\u{1b}[?2004l\u{1b}[0m\u{1b}[0 q\u{1b}[?25h\u{1b}[?1049l"
    end

  -- The OSC 52 sequence that puts `text` on the terminal's clipboard. Most terminals take it;
  -- none is asked to read the clipboard back.
  copy(text: STRING): STRING
    do
      let a = GLYPHS.add_text(BYTES_BUILDER.empty, "\u{1b}]52;c;")
      let b = GLYPHS.add_text(a, BASE64.encode(text.to_utf8))
      match STRING.from_utf8(GLYPHS.add_text(b, "\u{7}").to_bytes)
        case Ok(s) then s
        case Error(_) then ""
      end
    end

  -- Whether `t` is such a sequence: `\u{1b} ] 52 ; c ;`, base64, then \u{7}. Nothing in it can
  -- end the sequence early or write on the screen.
  is_copy(t: STRING): BOOL
    do
      let b = t.to_utf8
      let head = "\u{1b}]52;c;".to_utf8
      if b.length > head.length and b.starts_with(head) then
        b.at(b.length - 1) = 7 and BASE64.all_letters(b, head.length, b.length - 1)
      else
        False
      end
    end

  -- `out` with `ws`, drawn from the pen `pen`.
  writes(ws: LIST[SCREEN_WRITE], pen: STYLE, out: BYTES_BUILDER): BYTES_BUILDER
    variant
      ws.length
    do
      if ws.length = 0 then
        out
      else
        let w = ws.head
        let moved = VT_TEXT.move(out, w.x, w.y)
        VT_TEXT.writes(ws.tail, VT_TEXT.last_style(w.content, pen), VT_TEXT.cells(w.content, pen, moved))
      end
    end

  -- `out` with the cursor moved to column `x`, row `y`, counted from 0. A write lies inside
  -- a screen of at most 65535 by 65535, so neither is ever more than 65534.
  move(out: BYTES_BUILDER, x: NAT, y: NAT): BYTES_BUILDER
    do
      let row = if y < 65535 then y + 1 else 65535 end
      let col = if x < 65535 then x + 1 else 65535 end
      let a = GLYPHS.add_text(out, "\u{1b}[")
      let b = GLYPHS.add_text(a, NUMBER_TEXT.nat_to_text(row))
      let c = GLYPHS.add_text(b, ";")
      let d = GLYPHS.add_text(c, NUMBER_TEXT.nat_to_text(col))
      GLYPHS.add_text(d, "H")
    end

  -- `out` with `cs`, each preceded by its style when it differs from the one before.
  cells(cs: LIST[CELL], pen: STYLE, out: BYTES_BUILDER): BYTES_BUILDER
    variant
      cs.length
    do
      if cs.length = 0 then
        out
      else
        let c = cs.head
        let styled = if c.style.same(pen) then out else VT_TEXT.add_sgr(out, c.style) end
        VT_TEXT.cells(cs.tail, c.style, GLYPHS.add_char(styled, c.char))
      end
    end

  -- The style of the last of `cs`, or `pen` when there is none.
  last_style(cs: LIST[CELL], pen: STYLE): STYLE
    variant
      cs.length
    do
      if cs.length = 0 then pen else VT_TEXT.last_style(cs.tail, cs.head.style) end
    end

  -- `out` with the SGR sequence that sets `s` from any pen: a reset, then each attribute,
  -- then the colours that are not the terminal's own.
  add_sgr(out: BYTES_BUILDER, s: STYLE): BYTES_BUILDER
    do
      let a = GLYPHS.add_text(out, "\u{1b}[0")
      let b = if s.is_bold then GLYPHS.add_text(a, ";1") else a end
      let c = if s.is_dim then GLYPHS.add_text(b, ";2") else b end
      let d = if s.is_underlined then GLYPHS.add_text(c, ";4") else c end
      let e = if s.is_reversed then GLYPHS.add_text(d, ";7") else d end
      let f = if s.foreground.is_default then e else VT_TEXT.add_param(e, s.foreground.foreground_code) end
      let g = if s.background.is_default then f else VT_TEXT.add_param(f, s.background.background_code) end
      GLYPHS.add_text(g, "m")
    end

  -- `out` with `;` and the number `n`.
  add_param(out: BYTES_BUILDER, n: NAT): BYTES_BUILDER
    do
      GLYPHS.add_text(GLYPHS.add_text(out, ";"), NUMBER_TEXT.nat_to_text(n))
    end

end
