-- The bytes a VT terminal is sent for a list of writes: for each write, a cursor move
-- (`ESC [ row ; col H`, from 1) and its cells, with an SGR sequence wherever the style
-- changes. Non-empty frames are bracketed in synchronized output (`ESC [ ? 2026 h` /
-- `ESC [ ? 2026 l`), and the pen is reset at the start so a frame does not depend on what
-- came before it. These are the only control sequences a frame holds, as a cell holds no
-- control character.
functions VT_TEXT

feature {ANY}

  -- The text of a frame: `writes`, after clearing the screen when `clear` is set, wrapped in
  -- synchronized output; empty when `writes` is empty and `clear` is false.
  -- TODO(proof-GT.1): prove VT_TEXT.frame introduces no control characters outside CSI SGR, cursor, and mode-2026 sequences
  frame(writes: LIST[SCREEN_WRITE], clear: BOOL): STRING
    do
      if writes.length = 0 and not clear then
        ""
      else
        let out = VT_TEXT.writes(writes, STYLE.plain, VT_TEXT.begin_frame(clear))
        VT_TEXT.finish_frame(out)
      end
    end

  -- The text of a frame that draws `writes`, after clearing the screen when `clear` is set,
  -- then puts the cursor where `next` has it. When the cursor was shown (`was_shown`), it is
  -- hidden while the cells are drawn, so it is never seen moving over them.
  -- TODO(proof-GT.1): prove VT_TEXT.drawn introduces no control characters outside CSI SGR, cursor, and mode-2026 sequences
  drawn(writes: LIST[SCREEN_WRITE], clear: BOOL, was_shown: BOOL, next: SCREEN): STRING
    do
      if writes.length = 0 and not clear and not was_shown and not next.cursor_shown then
        ""
      else
        let start = VT_TEXT.begin_frame(clear)
        let hidden = if was_shown then GLYPHS.add_text(start, "\u{1b}[?25l") else start end
        let out = VT_TEXT.writes(writes, STYLE.plain, hidden)
        let placed = if next.cursor_shown then GLYPHS.add_text(VT_TEXT.move(out, next.cursor_x, next.cursor_y), "\u{1b}[?25h") else out end
        VT_TEXT.finish_frame(placed)
      end
    end

  -- Synchronized-output and pen-reset prefix of a non-empty frame, clearing the screen when `clear` is set.
  begin_frame(clear: BOOL): BYTES_BUILDER
    do
      let prefix = if clear then "\u{1b}[?2026h\u{1b}[0m\u{1b}[2J" else "\u{1b}[?2026h\u{1b}[0m" end
      GLYPHS.add_text(BYTES_BUILDER.empty, prefix)
    end

  -- End synchronized output on `out` and decode the frame bytes as UTF-8.
  finish_frame(out: BYTES_BUILDER): STRING
    do
      match STRING.from_utf8(GLYPHS.add_text(out, "\u{1b}[?2026l").to_bytes)
        case Ok(s) then s
        case Error(_) then ""
      end
    end

  -- Entering a full-screen interface: the alternate screen, cleared, with the cursor hidden
  -- and shaped as a bar for when a view shows it, and pastes bracketed, so that the host
  -- gives a paste as one `Pasted` event.
  enter: STRING
    do
      "\u{1b}[?1049h\u{1b}[0m\u{1b}[2J\u{1b}[?25l\u{1b}[6 q\u{1b}[?2004h"
    end

  -- Leaving it: pastes as typed, the pen reset, the cursor in the terminal's own shape and
  -- shown, and the screen that was there before.
  leave: STRING
    do
      "\u{1b}[?2004l\u{1b}[0m\u{1b}[0 q\u{1b}[?25h\u{1b}[?1049l"
    end

  -- The OSC 52 sequence that puts `text` on the terminal's clipboard. Most terminals take it;
  -- none is asked to read the clipboard back.
  copy(text: STRING): STRING
    do
      let a = GLYPHS.add_text(BYTES_BUILDER.empty, "\u{1b}]52;c;")
      let b = GLYPHS.add_text(a, BASE64.encode(text.to_utf8))
      match STRING.from_utf8(GLYPHS.add_text(b, "\u{7}").to_bytes)
        case Ok(s) then s
        case Error(_) then ""
      end
    end

  -- Whether `t` is such a sequence: `\u{1b} ] 52 ; c ;`, base64, then \u{7}. Nothing in it can
  -- end the sequence early or write on the screen.
  is_copy(t: STRING): BOOL
    do
      let b = t.to_utf8
      let head = "\u{1b}]52;c;".to_utf8
      if b.length > head.length and b.starts_with(head) then
        b.at(b.length - 1) = 7 and BASE64.all_letters(b, head.length, b.length - 1)
      else
        False
      end
    end

  -- `out` with `ws`, drawn from the pen `pen`.
  writes(ws: LIST[SCREEN_WRITE], pen: STYLE, out: BYTES_BUILDER): BYTES_BUILDER
    variant
      ws.length
    do
      if ws.length = 0 then
        out
      else
        let w = ws.head
        let moved = VT_TEXT.move(out, w.x, w.y)
        VT_TEXT.writes(ws.tail, VT_TEXT.last_style(w.content, pen), VT_TEXT.cells(w.content, pen, moved))
      end
    end

  -- `out` with the cursor moved to column `x`, row `y`, counted from 0. A write lies inside
  -- a screen of at most 65535 by 65535, so neither is ever more than 65534.
  move(out: BYTES_BUILDER, x: NAT, y: NAT): BYTES_BUILDER
    do
      let row = if y < 65535 then y + 1 else 65535 end
      let col = if x < 65535 then x + 1 else 65535 end
      let a = GLYPHS.add_text(out, "\u{1b}[")
      let b = GLYPHS.add_text(a, NUMBER_TEXT.nat_to_text(row))
      let c = GLYPHS.add_text(b, ";")
      let d = GLYPHS.add_text(c, NUMBER_TEXT.nat_to_text(col))
      GLYPHS.add_text(d, "H")
    end

  -- `out` with `cs`, each preceded by its style when it differs from the one before. A right
  -- half after its left half sends nothing, as the terminal has filled it already; one after
  -- anything else, which a screen never holds, sends a space. A cell's marks follow it.
  cells(cs: LIST[CELL], pen: STYLE, out: BYTES_BUILDER): BYTES_BUILDER
    do
      VT_TEXT.cells_after(cs, pen, False, out)
    end

  -- `cells`, after a left half when `half` is set.
  cells_after(cs: LIST[CELL], pen: STYLE, half: BOOL, out: BYTES_BUILDER): BYTES_BUILDER
    variant
      cs.length
    do
      if cs.length = 0 then
        out
      else
        let c = cs.head
        if c.is_right_half and half then
          VT_TEXT.cells_after(cs.tail, pen, False, out)
        else
          let styled = if c.style.same(pen) then out else VT_TEXT.add_sgr_delta(out, pen, c.style) end
          let drawn = VT_TEXT.marks(LIST_CUT.reverse(c.marks_backwards, LIST.empty), GLYPHS.add_char(styled, c.char))
          VT_TEXT.cells_after(cs.tail, c.style, c.is_left_half, drawn)
        end
      end
    end

  -- `out` with the marks `ms`.
  marks(ms: LIST[CHAR], out: BYTES_BUILDER): BYTES_BUILDER
    variant
      ms.length
    do
      if ms.length = 0 then out else VT_TEXT.marks(ms.tail, GLYPHS.add_char(out, ms.head)) end
    end

  -- The style of the last of `cs`, or `pen` when there is none.
  last_style(cs: LIST[CELL], pen: STYLE): STYLE
    variant
      cs.length
    do
      if cs.length = 0 then pen else VT_TEXT.last_style(cs.tail, cs.head.style) end
    end

  -- `out` with the SGR sequence that transitions from `pen` to `s`. Emits only added
  -- attributes and changed colours when nothing is cleared; falls back to `add_sgr` when any
  -- attribute is turned off or a colour returns to default.
  add_sgr_delta(out: BYTES_BUILDER, pen: STYLE, s: STYLE): BYTES_BUILDER
    do
      if VT_TEXT.clears_any(pen, s) then
        VT_TEXT.add_sgr(out, s)
      else
        let base = out.length
        let diff = VT_TEXT.add_sgr_diff(out, base, pen, s)
        if diff.length = base then out else GLYPHS.add_text(diff, "m") end
      end
    end

  -- Whether changing from `pen` to `s` turns off an attribute or restores a default colour.
  clears_any(pen: STYLE, s: STYLE): BOOL
    do
      let flags_cleared =
        (pen.is_bold and not s.is_bold)
          or (pen.is_dim and not s.is_dim)
          or (pen.is_italic and not s.is_italic)
          or (pen.is_underlined and not s.is_underlined)
          or (pen.is_reversed and not s.is_reversed)
          or (pen.is_strikethrough and not s.is_strikethrough)
      let fg_cleared = not (pen.foreground.is_default or pen.foreground.is_reset) and (s.foreground.is_default or s.foreground.is_reset)
      let bg_cleared = not (pen.background.is_default or pen.background.is_reset) and (s.background.is_default or s.background.is_reset)
      flags_cleared or fg_cleared or bg_cleared
    end

  -- `out` with the SGR sequence that sets `s` from any pen: a reset, then each attribute,
  -- then the colours that are not the terminal's own.
  add_sgr(out: BYTES_BUILDER, s: STYLE): BYTES_BUILDER
    do
      let base = out.length
      let reset = VT_TEXT.add_sgr_param(out, base, 0)
      let attrs = VT_TEXT.add_sgr_diff(reset, base, STYLE.plain, s)
      GLYPHS.add_text(attrs, "m")
    end

  -- `cur` with SGR parameters for attributes and colours added or changed between `from` and `to`,
  -- starting from CSI buffer offset `base`.
  add_sgr_diff(cur: BYTES_BUILDER, base: NAT, from: STYLE, to: STYLE): BYTES_BUILDER
    do
      let b = if to.is_bold and not from.is_bold then VT_TEXT.add_sgr_param(cur, base, 1) else cur end
      let d = if to.is_dim and not from.is_dim then VT_TEXT.add_sgr_param(b, base, 2) else b end
      let it = if to.is_italic and not from.is_italic then VT_TEXT.add_sgr_param(d, base, 3) else d end
      let u = if to.is_underlined and not from.is_underlined then VT_TEXT.add_sgr_param(it, base, 4) else it end
      let r = if to.is_reversed and not from.is_reversed then VT_TEXT.add_sgr_param(u, base, 7) else u end
      let st = if to.is_strikethrough and not from.is_strikethrough then VT_TEXT.add_sgr_param(r, base, 9) else r end
      let f = if to.foreground.same(from.foreground) then st else VT_TEXT.add_color_at(st, base, True, to.foreground) end
      if to.background.same(from.background) then f else VT_TEXT.add_color_at(f, base, False, to.background) end
    end

  -- `out` with foreground (`is_fg`) or background (`not is_fg`) SGR parameters for `c`, if set,
  -- starting a CSI sequence when `out.length = base`.
  add_color_at(out: BYTES_BUILDER, base: NAT, is_fg: BOOL, c: COLOR): BYTES_BUILDER
    do
      if c.is_default or c.is_reset then
        out
      else if c.is_standard then
        VT_TEXT.add_sgr_param(out, base, if is_fg then c.foreground_code else c.background_code end)
      else
        let ext = if is_fg then 38 else 48 end
        if c.is_indexed then
          let a = VT_TEXT.add_sgr_param(out, base, ext)
          let b = VT_TEXT.add_sgr_param(a, base, 5)
          VT_TEXT.add_sgr_param(b, base, c.index)
        else if c.is_rgb then
          let a = VT_TEXT.add_sgr_param(out, base, ext)
          let b = VT_TEXT.add_sgr_param(a, base, 2)
          let r = VT_TEXT.add_sgr_param(b, base, c.r)
          let g = VT_TEXT.add_sgr_param(r, base, c.g)
          VT_TEXT.add_sgr_param(g, base, c.b)
        else
          out
        end end
      end end
    end

  -- `out` with `ESC [` (when `out.length = base`) or `;`, followed by `n`.
  add_sgr_param(out: BYTES_BUILDER, base: NAT, n: NAT): BYTES_BUILDER
    do
      let sep = if out.length = base then "\u{1b}[" else ";" end
      GLYPHS.add_text(GLYPHS.add_text(out, sep), NUMBER_TEXT.nat_to_text(n))
    end

end
