          or (n >= 73459 and n <= 73460)   -- U+11EF3..U+11EF4
          or (n >= 73472 and n <= 73473)   -- U+11F00..U+11F01
          or (n >= 73526 and n <= 73530)   -- U+11F36..U+11F3A
          or n = 73536                     -- U+11F40
          or n = 73538                     -- U+11F42
          or n = 73562                     -- U+11F5A
        case 19 then  -- U+13000..U+13FFF
          (n >= 78896 and n <= 78912)      -- U+13430..U+13440
          or (n >= 78919 and n <= 78933)   -- U+13447..U+13455
        case 22 then  -- U+16000..U+16FFF
          (n >= 90398 and n <= 90409)      -- U+1611E..U+16129
          or (n >= 90413 and n <= 90415)   -- U+1612D..U+1612F
          or (n >= 92912 and n <= 92916)   -- U+16AF0..U+16AF4
          or (n >= 92976 and n <= 92982)   -- U+16B30..U+16B36
          or n = 94031                     -- U+16F4F
          or (n >= 94095 and n <= 94098)   -- U+16F8F..U+16F92
          or n = 94180                     -- U+16FE4
        case 27 then  -- U+1B000..U+1BFFF
          (n >= 113821 and n <= 113822)      -- U+1BC9D..U+1BC9E
          or (n >= 113824 and n <= 113827)   -- U+1BCA0..U+1BCA3
        case 28 then  -- U+1C000..U+1CFFF
          (n >= 118528 and n <= 118573)      -- U+1CF00..U+1CF2D
          or (n >= 118576 and n <= 118598)   -- U+1CF30..U+1CF46
        case 29 then  -- U+1D000..U+1DFFF
          (n >= 119143 and n <= 119145)      -- U+1D167..U+1D169
          or (n >= 119155 and n <= 119170)   -- U+1D173..U+1D182
          or (n >= 119173 and n <= 119179)   -- U+1D185..U+1D18B
          or (n >= 119210 and n <= 119213)   -- U+1D1AA..U+1D1AD
          or (n >= 119362 and n <= 119364)   -- U+1D242..U+1D244
          or (n >= 121344 and n <= 121398)   -- U+1DA00..U+1DA36
          or (n >= 121403 and n <= 121452)   -- U+1DA3B..U+1DA6C
          or n = 121461                      -- U+1DA75
          or n = 121476                      -- U+1DA84
          or (n >= 121499 and n <= 121503)   -- U+1DA9B..U+1DA9F
          or (n >= 121505 and n <= 121519)   -- U+1DAA1..U+1DAAF
        case 30 then  -- U+1E000..U+1EFFF
          (n >= 122880 and n <= 122886)      -- U+1E000..U+1E006
          or (n >= 122888 and n <= 122904)   -- U+1E008..U+1E018
          or (n >= 122907 and n <= 122913)   -- U+1E01B..U+1E021
          or (n >= 122915 and n <= 122916)   -- U+1E023..U+1E024
          or (n >= 122918 and n <= 122922)   -- U+1E026..U+1E02A
          or n = 123023                      -- U+1E08F
          or (n >= 123184 and n <= 123190)   -- U+1E130..U+1E136
          or n = 123566                      -- U+1E2AE
          or (n >= 123628 and n <= 123631)   -- U+1E2EC..U+1E2EF
          or (n >= 124140 and n <= 124143)   -- U+1E4EC..U+1E4EF
          or (n >= 124398 and n <= 124399)   -- U+1E5EE..U+1E5EF
          or (n >= 125136 and n <= 125142)   -- U+1E8D0..U+1E8D6
          or (n >= 125252 and n <= 125258)   -- U+1E944..U+1E94A
        case 224 then  -- U+E0000..U+E0FFF
          n = 917505                         -- U+E0001
          or (n >= 917536 and n <= 917631)   -- U+E0020..U+E007F
          or (n >= 917760 and n <= 917999)   -- U+E0100..U+E01EF
        case _ then
          False
      end
    end

  -- East Asian wide and fullwidth characters, most emoji, and the ideograph planes 2 and 3.
  is_wide(n: NAT): BOOL
    do
      match n / 4096
        case 1 then  -- U+1000..U+1FFF
          (n >= 4352 and n <= 4447)      -- U+1100..U+115F
        case 2 then  -- U+2000..U+2FFF
          (n >= 8986 and n <= 8987)        -- U+231A..U+231B
          or (n >= 9001 and n <= 9002)     -- U+2329..U+232A
          or (n >= 9193 and n <= 9196)     -- U+23E9..U+23EC
          or n = 9200                      -- U+23F0
          or n = 9203                      -- U+23F3
          or (n >= 9725 and n <= 9726)     -- U+25FD..U+25FE
          or (n >= 9748 and n <= 9749)     -- U+2614..U+2615
          or (n >= 9800 and n <= 9811)     -- U+2648..U+2653
          or n = 9855                      -- U+267F
          or n = 9875                      -- U+2693
          or n = 9889                      -- U+26A1
          or (n >= 9898 and n <= 9899)     -- U+26AA..U+26AB
          or (n >= 9917 and n <= 9918)     -- U+26BD..U+26BE
          or (n >= 9924 and n <= 9925)     -- U+26C4..U+26C5
          or n = 9934                      -- U+26CE
          or n = 9940                      -- U+26D4
          or n = 9962                      -- U+26EA
          or (n >= 9970 and n <= 9971)     -- U+26F2..U+26F3
          or n = 9973                      -- U+26F5
          or n = 9978                      -- U+26FA
          or n = 9981                      -- U+26FD
          or n = 9989                      -- U+2705
          or (n >= 9994 and n <= 9995)     -- U+270A..U+270B
          or n = 10024                     -- U+2728
          or n = 10060                     -- U+274C
          or n = 10062                     -- U+274E
          or (n >= 10067 and n <= 10069)   -- U+2753..U+2755
          or n = 10071                     -- U+2757
          or (n >= 10133 and n <= 10135)   -- U+2795..U+2797
          or n = 10160                     -- U+27B0
          or n = 10175                     -- U+27BF
          or (n >= 11035 and n <= 11036)   -- U+2B1B..U+2B1C
          or n = 11088                     -- U+2B50
          or n = 11093                     -- U+2B55
          or (n >= 11904 and n <= 11929)   -- U+2E80..U+2E99
          or (n >= 11931 and n <= 12019)   -- U+2E9B..U+2EF3
          or (n >= 12032 and n <= 12245)   -- U+2F00..U+2FD5
          or (n >= 12272 and n <= 12329)   -- U+2FF0..U+3029
        case 3 then  -- U+3000..U+3FFF
          (n >= 12272 and n <= 12329)      -- U+2FF0..U+3029
          or (n >= 12334 and n <= 12350)   -- U+302E..U+303E
          or (n >= 12353 and n <= 12438)   -- U+3041..U+3096
          or (n >= 12443 and n <= 12543)   -- U+309B..U+30FF
          or (n >= 12549 and n <= 12591)   -- U+3105..U+312F
          or (n >= 12593 and n <= 12686)   -- U+3131..U+318E
          or (n >= 12688 and n <= 12771)   -- U+3190..U+31E3
          or (n >= 12783 and n <= 12830)   -- U+31EF..U+321E
          or (n >= 12832 and n <= 12871)   -- U+3220..U+3247
          or (n >= 12880 and n <= 19903)   -- U+3250..U+4DBF
        case 4 then  -- U+4000..U+4FFF
          (n >= 12880 and n <= 19903)      -- U+3250..U+4DBF
          or (n >= 19968 and n <= 42124)   -- U+4E00..U+A48C
        case 5 then  -- U+5000..U+5FFF
          True
        case 6 then  -- U+6000..U+6FFF
          True
        case 7 then  -- U+7000..U+7FFF
          True
        case 8 then  -- U+8000..U+8FFF
          True
        case 9 then  -- U+9000..U+9FFF
          True
        case 10 then  -- U+A000..U+AFFF
          (n >= 19968 and n <= 42124)      -- U+4E00..U+A48C
          or (n >= 42128 and n <= 42182)   -- U+A490..U+A4C6
          or (n >= 43360 and n <= 43388)   -- U+A960..U+A97C
          or (n >= 44032 and n <= 55203)   -- U+AC00..U+D7A3
        case 11 then  -- U+B000..U+BFFF
          True
        case 12 then  -- U+C000..U+CFFF
          True
        case 13 then  -- U+D000..U+DFFF
          (n >= 44032 and n <= 55203)      -- U+AC00..U+D7A3
        case 15 then  -- U+F000..U+FFFF
          (n >= 63744 and n <= 64255)      -- U+F900..U+FAFF
          or (n >= 65040 and n <= 65049)   -- U+FE10..U+FE19
          or (n >= 65072 and n <= 65106)   -- U+FE30..U+FE52
          or (n >= 65108 and n <= 65126)   -- U+FE54..U+FE66
          or (n >= 65128 and n <= 65131)   -- U+FE68..U+FE6B
          or (n >= 65281 and n <= 65376)   -- U+FF01..U+FF60
          or (n >= 65504 and n <= 65510)   -- U+FFE0..U+FFE6
        case 22 then  -- U+16000..U+16FFF
          (n >= 94176 and n <= 94179)      -- U+16FE0..U+16FE3
          or (n >= 94192 and n <= 94193)   -- U+16FF0..U+16FF1
        case 23 then  -- U+17000..U+17FFF
          True
        case 24 then  -- U+18000..U+18FFF
          (n >= 94208 and n <= 100343)       -- U+17000..U+187F7
          or (n >= 100352 and n <= 101589)   -- U+18800..U+18CD5
          or (n >= 101632 and n <= 101640)   -- U+18D00..U+18D08
        case 26 then  -- U+1A000..U+1AFFF
          (n >= 110576 and n <= 110579)      -- U+1AFF0..U+1AFF3
          or (n >= 110581 and n <= 110587)   -- U+1AFF5..U+1AFFB
          or (n >= 110589 and n <= 110590)   -- U+1AFFD..U+1AFFE
        case 27 then  -- U+1B000..U+1BFFF
          (n >= 110592 and n <= 110882)      -- U+1B000..U+1B122
          or n = 110898                      -- U+1B132
          or (n >= 110928 and n <= 110930)   -- U+1B150..U+1B152
          or n = 110933                      -- U+1B155
          or (n >= 110948 and n <= 110951)   -- U+1B164..U+1B167
          or (n >= 110960 and n <= 111355)   -- U+1B170..U+1B2FB
        case 31 then  -- U+1F000..U+1FFFF
          n = 126980                         -- U+1F004
          or n = 127183                      -- U+1F0CF
          or n = 127374                      -- U+1F18E
          or (n >= 127377 and n <= 127386)   -- U+1F191..U+1F19A
          or (n >= 127488 and n <= 127490)   -- U+1F200..U+1F202
          or (n >= 127504 and n <= 127547)   -- U+1F210..U+1F23B
          or (n >= 127552 and n <= 127560)   -- U+1F240..U+1F248
          or (n >= 127568 and n <= 127569)   -- U+1F250..U+1F251
          or (n >= 127584 and n <= 127589)   -- U+1F260..U+1F265
          or (n >= 127744 and n <= 127776)   -- U+1F300..U+1F320
          or (n >= 127789 and n <= 127797)   -- U+1F32D..U+1F335
          or (n >= 127799 and n <= 127868)   -- U+1F337..U+1F37C
          or (n >= 127870 and n <= 127891)   -- U+1F37E..U+1F393
          or (n >= 127904 and n <= 127946)   -- U+1F3A0..U+1F3CA
          or (n >= 127951 and n <= 127955)   -- U+1F3CF..U+1F3D3
          or (n >= 127968 and n <= 127984)   -- U+1F3E0..U+1F3F0
          or n = 127988                      -- U+1F3F4
          or (n >= 127992 and n <= 128062)   -- U+1F3F8..U+1F43E
          or n = 128064                      -- U+1F440
          or (n >= 128066 and n <= 128252)   -- U+1F442..U+1F4FC
          or (n >= 128255 and n <= 128317)   -- U+1F4FF..U+1F53D
          or (n >= 128331 and n <= 128334)   -- U+1F54B..U+1F54E
          or (n >= 128336 and n <= 128359)   -- U+1F550..U+1F567
          or n = 128378                      -- U+1F57A
          or (n >= 128405 and n <= 128406)   -- U+1F595..U+1F596
          or n = 128420                      -- U+1F5A4
          or (n >= 128507 and n <= 128591)   -- U+1F5FB..U+1F64F
          or (n >= 128640 and n <= 128709)   -- U+1F680..U+1F6C5
          or n = 128716                      -- U+1F6CC
          or (n >= 128720 and n <= 128722)   -- U+1F6D0..U+1F6D2
          or (n >= 128725 and n <= 128727)   -- U+1F6D5..U+1F6D7
          or (n >= 128732 and n <= 128735)   -- U+1F6DC..U+1F6DF
          or (n >= 128747 and n <= 128748)   -- U+1F6EB..U+1F6EC
          or (n >= 128756 and n <= 128764)   -- U+1F6F4..U+1F6FC
          or (n >= 128992 and n <= 129003)   -- U+1F7E0..U+1F7EB
          or n = 129008                      -- U+1F7F0
          or (n >= 129292 and n <= 129338)   -- U+1F90C..U+1F93A
          or (n >= 129340 and n <= 129349)   -- U+1F93C..U+1F945
          or (n >= 129351 and n <= 129535)   -- U+1F947..U+1F9FF
          or (n >= 129648 and n <= 129660)   -- U+1FA70..U+1FA7C
          or (n >= 129664 and n <= 129673)   -- U+1FA80..U+1FA89
          or (n >= 129679 and n <= 129734)   -- U+1FA8F..U+1FAC6
          or (n >= 129742 and n <= 129756)   -- U+1FACE..U+1FADC
          or (n >= 129759 and n <= 129769)   -- U+1FADF..U+1FAE9
          or (n >= 129776 and n <= 129784)   -- U+1FAF0..U+1FAF8
        case 32 then  -- U+20000..U+20FFF
          True
        case 33 then  -- U+21000..U+21FFF
          True
        case 34 then  -- U+22000..U+22FFF
          True
        case 35 then  -- U+23000..U+23FFF
          True
        case 36 then  -- U+24000..U+24FFF
          True
        case 37 then  -- U+25000..U+25FFF
          True
        case 38 then  -- U+26000..U+26FFF
          True
        case 39 then  -- U+27000..U+27FFF
          True
        case 40 then  -- U+28000..U+28FFF
          True
        case 41 then  -- U+29000..U+29FFF
          True
        case 42 then  -- U+2A000..U+2AFFF
          True
        case 43 then  -- U+2B000..U+2BFFF
          True
        case 44 then  -- U+2C000..U+2CFFF
          True
        case 45 then  -- U+2D000..U+2DFFF
          True
        case 46 then  -- U+2E000..U+2EFFF
          True
        case 47 then  -- U+2F000..U+2FFFF
          (n >= 131072 and n <= 196605)      -- U+20000..U+2FFFD
        case 48 then  -- U+30000..U+30FFF
          True
        case 49 then  -- U+31000..U+31FFF
          True
        case 50 then  -- U+32000..U+32FFF
          True
        case 51 then  -- U+33000..U+33FFF
          True
        case 52 then  -- U+34000..U+34FFF
          True
        case 53 then  -- U+35000..U+35FFF
          True
        case 54 then  -- U+36000..U+36FFF
          True
        case 55 then  -- U+37000..U+37FFF
          True
        case 56 then  -- U+38000..U+38FFF
          True
        case 57 then  -- U+39000..U+39FFF
          True
        case 58 then  -- U+3A000..U+3AFFF
          True
        case 59 then  -- U+3B000..U+3BFFF
          True
        case 60 then  -- U+3C000..U+3CFFF
          True
        case 61 then  -- U+3D000..U+3DFFF
          True
        case 62 then  -- U+3E000..U+3EFFF
          True
        case 63 then  -- U+3F000..U+3FFFF
          (n >= 196608 and n <= 262141)      -- U+30000..U+3FFFD
        case _ then
          False
      end
    end

end
