-- A list of items with one selected, shown from item `top` on. The selection is always an
-- item, or 0 in an empty list (`chosen_item`), and always on the page shown when `rows`
-- items are shown (`top <= selected`). As in `TEXT_VIEW`, `rows` is the height the
-- application draws the list in.
module LIST_VIEW

representation {NONE}
  entries: LIST[STRING]
  chosen: NAT
  topmost: NAT

invariant
  chosen_item: chosen < entries.length or (entries.length = 0 and chosen = 0)
  chosen_shown: topmost <= chosen

create {ANY}

  make(items: LIST[STRING]): LIST_VIEW
    do
      { entries = items, chosen = 0, topmost = 0 }
    ensure
      first_chosen: Result.selected = 0
      count_set: Result.count = items.length
    end

feature {ANY}

  items: LIST[STRING]
    do
      Current.entries
    end

  count: NAT
    do
      Current.entries.length
    end

  is_empty: BOOL
    do
      Current.entries.length = 0
    end

  -- The index of the selected item.
  selected: NAT
    do
      Current.chosen
    ensure
      an_item: Result < Current.count or (Current.count = 0 and Result = 0)
    end

  -- The selected item, none in an empty list.
  selected_item: OPTION[STRING]
    do
      if Current.chosen < Current.entries.length then Some(LIST_OPS.at(Current.entries, Current.chosen)) else None end
    ensure
      some_unless_empty: Result.is_some = (Current.count > 0)
    end

  -- The first item shown.
  top: NAT
    do
      Current.topmost
    ensure
      before_selected: Result <= Current.selected
    end

  -- Item `i` selected, or the last when `i` is past it, and the page moved to show it.
  select(i: NAT, rows: NAT): LIST_VIEW
    do
      let n = Current.entries.length
      let c = if n = 0 then 0 else if i < n then i else n - 1 end end
      let t = if c < Current.topmost then c
        else if rows = 0 then c
        else if c - Current.topmost >= rows then c - rows + 1
        else Current.topmost
        end end end
      { Current with chosen = c, topmost = t }
    ensure
      same_count: Result.count = Current.count
      chosen_set: Current.count > 0 implies Result.selected = (if i < Current.count then i else Current.count - 1 end)
      shown: rows > 0 implies Result.selected < Result.top + rows
    end

  -- Other items, with the selection kept on the same index, or the last.
  with_items(items: LIST[STRING], rows: NAT): LIST_VIEW
    do
      let fresh: LIST_VIEW = { entries = items, chosen = 0, topmost = 0 }
      fresh.select(Current.chosen, rows)
    ensure
      count_set: Result.count = items.length
      same_index: Current.selected < items.length implies Result.selected = Current.selected
    end

  down(n: NAT, rows: NAT): LIST_VIEW
    do
      Current.select(if Current.chosen <= 18446744073709551615 - n then Current.chosen + n else Current.chosen end, rows)
    ensure
      same_count: Result.count = Current.count
    end

  up(n: NAT, rows: NAT): LIST_VIEW
    do
      Current.select(if Current.chosen >= n then Current.chosen - n else 0 end, rows)
    ensure
      same_count: Result.count = Current.count
    end

  -- Moved by a key: an item for an arrow, a page for Page Up and Page Down, and to either end
  -- for Home and End. Other keys change nothing.
  on_key(k: KEY, rows: NAT): LIST_VIEW
    do
      if LIST_VIEW.moves(k) then Current.select(Current.target(k, rows), rows) else Current end
    ensure
      same_count: Result.count = Current.count
    end

  -- The item a key moves the selection to, `rows` items shown.
  target(k: KEY, rows: NAT): NAT
    do
      let page = if rows > 1 then rows - 1 else 1 end
      let c = Current.chosen
      match k
        case Down then if c < 18446744073709551615 then c + 1 else c end
        case Up then if c >= 1 then c - 1 else 0 end
        case PageDown then if c <= 18446744073709551615 - page then c + page else c end
        case PageUp then if c >= page then c - page else 0 end
        case Home then 0
        case End then if Current.entries.length > 0 then Current.entries.length - 1 else 0 end
        case _ then c
      end
    end

  -- The list drawn in `r`, in style `st`, the selected item across the whole row in `mark`.
  draw(s: SCREEN, r: RECT, st: STYLE, mark: STYLE): SCREEN
    do
      LIST_VIEW.draw_items(s, r, LIST_CUT.drop(Current.entries, Current.topmost), Current.topmost, Current.chosen, r.y, st, mark)
    ensure
      same_width: Result.width = s.width
      same_height: Result.height = s.height
    end

create {ANY}

  -- Whether `k` moves the selection: the arrows up and down, Page Up, Page Down, Home, End.
  moves(k: KEY): BOOL
    do
      match k
        case Down then True
        case Up then True
        case PageDown then True
        case PageUp then True
        case Home then True
        case End then True
        case _ then False
      end
    end

  -- `items`, the first of which is item `i`, drawn in `r` from row `y` on.
  draw_items(s: SCREEN, r: RECT, items: LIST[STRING], i: NAT, chosen: NAT, y: NAT, st: STYLE, mark: STYLE): SCREEN
    variant
      items.length
    do
      if items.length = 0 or y >= r.bottom or i = 18446744073709551615 then
        s
      else
        let drawn = if i = chosen then
            s.fill(RECT.make(r.x, y, r.width, 1), ' ', mark).text(r, r.x, y, items.head, mark)
          else
            s.text(r, r.x, y, items.head, st)
          end
        LIST_VIEW.draw_items(drawn, r, items.tail, i + 1, chosen, y + 1, st, mark)
      end
    ensure
      same_width: Result.width = s.width
      same_height: Result.height = s.height
    end

end
