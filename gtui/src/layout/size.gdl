-- The size a layout gives one child along its axis: a fixed number of cells, or a share of
-- what the fixed children leave, in proportion to a weight from 1 to 1000.
module SIZE

representation {NONE}
  | Fixed(cells: NAT)
  | Flex(weight: NAT)

invariant
  weighed: match Current
    case Fixed(_) then True
    case Flex(w) then w >= 1 and w <= 1000
  end

create {ANY}

  fixed(n: NAT): SIZE
    do
      Fixed(n)
    ensure
      not_flexible: not Result.is_flex
      cells_set: Result.fixed_cells = n
    end

  -- A share of weight `w`, taken as 1 below 1 and as 1000 above 1000.
  flex(w: NAT): SIZE
    do
      Flex(if w < 1 then 1 else if w > 1000 then 1000 else w end end)
    ensure
      flexible: Result.is_flex
    end

feature {ANY}

  is_flex: BOOL
    do
      match Current
        case Fixed(_) then False
        case Flex(_) then True
      end
    end

  -- The cells of a fixed size, and 0 for a flexible one.
  fixed_cells: NAT
    do
      match Current
        case Fixed(n) then n
        case Flex(_) then 0
      end
    ensure
      flex_none: Current.is_flex implies Result = 0
    end

  -- The weight of a flexible size, and 0 for a fixed one.
  weight: NAT
    do
      match Current
        case Fixed(_) then 0
        case Flex(w) then w
      end
    ensure
      bounded: Result <= 1000
      fixed_none: not Current.is_flex implies Result = 0
      flex_some: Current.is_flex implies Result >= 1
    end

end
