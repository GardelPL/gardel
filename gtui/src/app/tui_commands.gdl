-- The commands an application may send while `TUI` owns the terminal.
functions TUI_COMMANDS

feature {ANY}

  -- `cmds` without those that write on the screen or read from the terminal: `Print`,
  -- `Write`, `TerminalSize`, `ReadLine` and `ReadKey`. `TUI` sends those itself. A `Write` of
  -- a copy to the clipboard is kept.
  own(cmds: LIST[COMMAND]): LIST[COMMAND]
    do
      LIST_OPS.filter(cmds, fn(c: COMMAND): BOOL do TUI_COMMANDS.allowed(c) end)
    ensure
      not_longer: Result.length <= cmds.length
    end

  allowed(c: COMMAND): BOOL
    do
      match c
        case Print(_) then False
        case Write(t) then VT_TEXT.is_copy(t)
        case TerminalSize then False
        case ReadLine then False
        case ReadKey then False
        case _ then True
      end
    end

  -- The command that puts `text` on the terminal's clipboard (OSC 52), which `TUI` lets
  -- through. A terminal that does not know OSC 52 ignores it.
  copy(text: STRING): COMMAND
    do
      Write(VT_TEXT.copy(text))
    end

  -- How many of `cmds` run a child attached.
  attaching(cmds: LIST[COMMAND]): NAT
    variant
      cmds.length
    do
      if cmds.length = 0 then
        0
      else
        let n = TUI_COMMANDS.attaching(cmds.tail)
        match cmds.head
          case RunAttached(_, _, _, _) then if n < 18446744073709551615 then n + 1 else n end
          case _ then n
        end
      end
    ensure
      not_more: Result <= cmds.length
    end

  -- A read of the next key after a key or a paste, which answers a read as a key does, until
  -- keys end; nothing after any other event.
  reads_after(e: EVENT): LIST[COMMAND]
    do
      match e
        case Key(k) then
          match k
            case KeysEnded then LIST.empty
            case _ then LIST.empty.prepend(ReadKey)
          end
        case Pasted(_) then LIST.empty.prepend(ReadKey)
        case _ then LIST.empty
      end
    end

end
