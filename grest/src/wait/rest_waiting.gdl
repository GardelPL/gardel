-- The requests of a `REST_SERVER` that wait for their answers (F.8, decisions 7 and 8): at
-- most `max_waiting`, each with its connection, its tag and its timeout, in a `MAP` by tag
-- (Task H.4). A service answers a request by its tag; an answer whose tag no wait holds,
-- because the request timed out or its connection closed, is dropped. Tags are given in turn,
-- from 0 to 999999999 and then from 0 again, and a tag that a request still waits under is not
-- given, so no two requests wait under one tag.
module REST_WAITING

representation {NONE}
  waits: MAP[NAT, REST_WAIT]
  next: NAT

invariant
  bounded: waits.size <= 32
  tags: next < 1000000000
  tagged: forall t: NAT. waits.has(t) implies waits.get(t).get.tag = t

create {ANY}

  -- The most requests that wait at once. A request that would wait beyond it is answered
  -- `REST_RESPONSE.unavailable`, a `503`.
  max_waiting: NAT
    do
      32
    ensure
      def: Result = 32
    end

  empty: REST_WAITING
    do
      { waits = MAP.empty, next = 0 }
    ensure
      none: Result.count = 0
      room: Result.has_room
      first: Result.next_tag = 0
    end

create {NONE}

  -- The waits of `ws` on `c`.
  on(ws: MAP[NAT, REST_WAIT], c: CONN_ID): MAP[NAT, REST_WAIT]
    do
      ws.filter(fn(t: NAT, w: REST_WAIT): BOOL do w.connection = c end)
    end

  -- The waits of `ws` on other connections than `c`.
  off(ws: MAP[NAT, REST_WAIT], c: CONN_ID): MAP[NAT, REST_WAIT]
    do
      ws.filter(fn(t: NAT, w: REST_WAIT): BOOL do w.connection != c end)
    end

  -- A wait on `c` is one of those on it.
  some_on(ws: MAP[NAT, REST_WAIT], c: CONN_ID, t: NAT): BOOL
    require
      waits: ws.has(t)
      on_c: ws.get(t).get.connection = c
    do
      check
        agrees: forall a: NAT. forall b: NAT. a.equals(b) = (a = b)
        kept: on(ws, c).has(t)
      end
      True
    ensure
      holds: Result
      some: on(ws, c).size > 0
    end

  -- A wait on another connection than `c` is one of those off it.
  kept_off(ws: MAP[NAT, REST_WAIT], c: CONN_ID, t: NAT): BOOL
    require
      waits: ws.has(t)
      elsewhere: ws.get(t).get.connection != c
    do
      check
        agrees: forall a: NAT. forall b: NAT. a.equals(b) = (a = b)
        kept: off(ws, c).has(t)
      end
      True
    ensure
      holds: Result
      kept: off(ws, c).has(t)
    end

  -- A wait on `c` is not one of those off it.
  dropped_off(ws: MAP[NAT, REST_WAIT], c: CONN_ID, t: NAT): BOOL
    require
      waits: ws.has(t)
      on_c: ws.get(t).get.connection = c
    do
      check
        agrees: forall a: NAT. forall b: NAT. a.equals(b) = (a = b)
        gone: off(ws, c).get(t).is_none
      end
      True
    ensure
      holds: Result
      gone: not off(ws, c).has(t)
    end

  -- None of the waits off `c` is on it.
  none_on(ws: MAP[NAT, REST_WAIT], c: CONN_ID): BOOL
    do
      check
        agrees: forall a: NAT. forall b: NAT. a.equals(b) = (a = b)
        first: on(off(ws, c), c).size > 0 implies on(off(ws, c), c).has(LIST_OPS.at(on(off(ws, c), c).keys, 0))
      end
      True
    ensure
      holds: Result
      none: on(off(ws, c), c).size = 0
    end

  -- `w` after one more sweep, or as it is when the sweep times it out.
  older(w: REST_WAIT): REST_WAIT
    do
      if w.times_out then w else w.aged end
    ensure
      same_tag: Result.tag = w.tag
      aged: not w.times_out implies Result.sweeps_waited = w.sweeps_waited + 1
    end

feature {ANY}

  -- How many requests wait.
  count: NAT
    do
      Current.waits.size
    ensure
      bounded: Result <= 32
    end

  has_room: BOOL
    do
      Current.waits.size < 32
    ensure
      def: Result = (Current.count < 32)
    end

  -- The tag the next wait is given.
  next_tag: NAT
    do
      Current.next
    end

  -- The tag a handler is given to wait with, or `None` when the table is full, or when a
  -- request from a billion waits ago still waits under it.
  offered: OPTION[NAT]
    do
      if Current.has_room and not Current.waits.has(Current.next) then Some(Current.next) else None end
    ensure
      def: Result = (if Current.has_room and Current.get(Current.next_tag).is_none then Some(Current.next_tag) else None end)
      -- No request waits under it.
      fresh: Result.is_some implies Current.get(Result.get).is_none
    end

  -- Whether a request on `c` waits.
  waits_on(c: CONN_ID): BOOL
    do
      on(Current.waits, c).size > 0
    end

  -- The wait tagged `t`.
  get(t: NAT): OPTION[REST_WAIT]
    do
      Current.waits.get(t)
    ensure
      tagged: Result.is_some implies Result.get.tag = t
    end

  -- The table with `w` waiting, in place of any wait on its connection, and the next tag
  -- given.
  holding(w: REST_WAIT): REST_WAITING
    require
      offered: Current.offered = Some(w.tag)
    do
      let held = off(Current.waits, w.connection).put(w.tag, w)
      check
        agrees: forall a: NAT. forall b: NAT. a.equals(b) = (a = b)
        waits: some_on(held, w.connection, w.tag)
      end
      { waits = held,
        next = if Current.next + 1 < 1000000000 then Current.next + 1 else 0 end }
    ensure
      waits: Result.waits_on(w.connection)
      found: Result.get(w.tag).is_some and Result.get(w.tag).get.connection = w.connection
      not_more: Result.count <= Current.count + 1
      -- In turn, from 0 to 999999999 and then from 0 again.
      next_given: Result.next_tag = (if Current.next_tag = 999999999 then 0 else Current.next_tag + 1 end)
    end

  -- The table without the wait tagged `t`, once it is answered.
  taking(t: NAT): REST_WAITING
    do
      check
        agrees: forall a: NAT. forall b: NAT. a.equals(b) = (a = b)
      end
      { Current with waits = Current.waits.remove(t) }
    ensure
      gone: Result.get(t).is_none
      not_more: Result.count <= Current.count
      same_next: Result.next_tag = Current.next_tag
    end

  -- The table without the waits on `c`, once `c` closes.
  dropping(c: CONN_ID): REST_WAITING
    do
      check
        agrees: forall a: NAT. forall b: NAT. a.equals(b) = (a = b)
        none: none_on(Current.waits, c)
      end
      { Current with waits = off(Current.waits, c) }
    ensure
      gone: not Result.waits_on(c)
      not_more: Result.count <= Current.count
      same_next: Result.next_tag = Current.next_tag
    end

  -- The table after one sweep: the waits whose time does not run out, each one sweep older.
  swept: REST_WAITING
    do
      check
        agrees: forall a: NAT. forall b: NAT. a.equals(b) = (a = b)
      end
      let kept = Current.waits.filter(fn(t: NAT, w: REST_WAIT): BOOL do not w.times_out end)
      { Current with waits = kept.map(fn(t: NAT, w: REST_WAIT): REST_WAIT do REST_WAITING.older(w) end) }
    ensure
      -- Every wait is kept or expires.
      accounted: Result.count + Current.expired.length = Current.count
      same_next: Result.next_tag = Current.next_tag
    end

  -- The waits whose time runs out on the next sweep, to be answered late, oldest first but
  -- when the tags have started from 0 again.
  expired: LIST[REST_WAIT]
    do
      Current.waits.filter(fn(t: NAT, w: REST_WAIT): BOOL do w.times_out end).values
    end

specify {ANY}

  -- No other wait leaves the table: one under another tag, and on another connection, stays
  -- when a wait is held, answered or dropped.
  law holding_keeps(q: REST_WAITING, w: REST_WAIT, t: NAT)
    require
      offered: q.offered = Some(w.tag)
      waits: q.get(t).is_some
      elsewhere: q.get(t).get.connection != w.connection
    trigger
      q.holding(w).get(t)
    do
      REST_WAITING.kept_off(q.waits, w.connection, t)
    ensure
      stays: q.holding(w).get(t).is_some
    end

  -- A wait on the same connection, whose place is taken, leaves the table.
  law holding_replaces(q: REST_WAITING, w: REST_WAIT, t: NAT)
    require
      offered: q.offered = Some(w.tag)
      waits: q.get(t).is_some
      same: q.get(t).get.connection = w.connection
    trigger
      q.holding(w).get(t)
    do
      REST_WAITING.dropped_off(q.waits, w.connection, t)
    ensure
      gone: q.holding(w).get(t).is_none
    end

  law taking_keeps(q: REST_WAITING, t: NAT, u: NAT)
    require
      other: u != t
    trigger
      q.taking(t).get(u)
    ensure
      stays: q.get(u).is_some implies q.taking(t).get(u).is_some
    end

  law dropping_keeps(q: REST_WAITING, c: CONN_ID, t: NAT)
    require
      waits: q.get(t).is_some
      elsewhere: q.get(t).get.connection != c
    trigger
      q.dropping(c).get(t)
    do
      REST_WAITING.kept_off(q.waits, c, t)
    ensure
      stays: q.dropping(c).get(t).is_some
    end

  -- A sweep counts itself on each wait it keeps.
  law swept_kept(q: REST_WAITING, t: NAT)
    require
      waits: q.get(t).is_some
      in_time: not q.get(t).get.times_out
    trigger
      q.swept.get(t)
    ensure
      kept: q.swept.get(t).is_some
      aged: q.swept.get(t).get.sweeps_waited = q.get(t).get.sweeps_waited + 1
    end

  -- A wait whose time runs out leaves the table.
  law swept_gone(q: REST_WAITING, t: NAT)
    require
      waits: q.get(t).is_some
      out_of_time: q.get(t).get.times_out
    trigger
      q.swept.get(t)
    do
      check
        agrees: forall a: NAT. forall b: NAT. a.equals(b) = (a = b)
      end
      True
    ensure
      gone: q.swept.get(t).is_none
    end

  -- Only a wait whose time runs out is answered late.
  law expired_out_of_time(q: REST_WAITING, i: NAT)
    require
      inside: i < q.expired.length
    trigger
      LIST_OPS.at(q.expired, i)
    do
      check
        agrees: forall a: NAT. forall b: NAT. a.equals(b) = (a = b)
      end
      True
    ensure
      out_of_time: LIST_OPS.at(q.expired, i).times_out
    end

end
