-- A route of a service whose state is an `S`: a method, a path pattern such as `/users/:id`,
-- and the handler that answers a request that matches them. A handler is a pure function from
-- the state and a request to the next state and a response, a `REST_OUTCOME[S]`.
--
-- The pattern is kept as written, so a router can name a route whose pattern is not valid.
module REST_ROUTE[S]

representation {NONE}
  verb: HTTP_METHOD
  path: STRING
  pattern: PATH_PATTERN
  run: (s: S, r: REST_REQUEST) -> REST_OUTCOME[S]

create {ANY}

  make(m: HTTP_METHOD, p: STRING, h: (s: S, r: REST_REQUEST) -> REST_OUTCOME[S]): REST_ROUTE[S]
    do
      { verb = m, path = p, pattern = PATH_PATTERN.parse(p), run = h }
    ensure
      method_set: Result.method = m
      path_set: Result.path_text.equals(p)
    end

  -- A route whose handler does not look at the state, and keeps it.
  plain(m: HTTP_METHOD, p: STRING, h: (r: REST_REQUEST) -> HTTP_RESPONSE): REST_ROUTE[S]
    do
      REST_ROUTE.make(m, p, fn(s: S, r: REST_REQUEST): REST_OUTCOME[S] do
        REST_OUTCOME.make(s, h(r))
      end)
    ensure
      method_set: Result.method = m
    end

  -- A route whose handler reads the state, and keeps it.
  viewing(m: HTTP_METHOD, p: STRING, h: (s: S, r: REST_REQUEST) -> HTTP_RESPONSE): REST_ROUTE[S]
    do
      REST_ROUTE.make(m, p, fn(s: S, r: REST_REQUEST): REST_OUTCOME[S] do
        REST_OUTCOME.make(s, h(s, r))
      end)
    ensure
      method_set: Result.method = m
    end

  -- A route whose handler is given the body as JSON. A body that is not one JSON value, or
  -- no body, is answered with `REST_RESPONSE.bad_body`, a `400`, the state is kept, and `h`
  -- is not called.
  with_json(m: HTTP_METHOD, p: STRING, h: (s: S, r: REST_REQUEST, body: JSON) -> REST_OUTCOME[S]): REST_ROUTE[S]
    do
      REST_ROUTE.make(m, p, fn(s: S, r: REST_REQUEST): REST_OUTCOME[S] do
        match r.json_body
          case Error(e) then REST_OUTCOME.make(s, REST_RESPONSE.bad_body(e))
          case Ok(v) then h(s, r, v)
        end
      end)
    ensure
      method_set: Result.method = m
    end

feature {ANY}

  method: HTTP_METHOD
    do
      Current.verb
    end

  path_text: STRING
    do
      Current.path
    end

  path_pattern: PATH_PATTERN
    do
      Current.pattern
    end

  is_valid: BOOL
    do
      Current.pattern.is_valid
    end

  -- What the handler answers to `r` in the state `s`.
  respond(s: S, r: REST_REQUEST): REST_OUTCOME[S]
    do
      Current.run(s, r)
    end

end
