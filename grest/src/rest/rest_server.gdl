-- The server of a REST service whose state is an `S`: `ghttp`'s table of connections, a
-- `REST_ROUTER[S]`, and the state. A client's reactive program is its state, its routes, its
-- handlers and two lines:
--
--   init(args: SEQ[STRING]): STEP[REST_SERVER[STORE]]
--     do REST_SERVER.start(args, 8090, routes, STORE.empty) end
--   step(s: REST_SERVER[STORE], e: EVENT): STEP[REST_SERVER[STORE]] do s.serve(e) end
--
-- Each request is answered once and its connection closed after the answer, and the state is
-- the one its handler gave back. `serve` proves the first for every event: see
-- `REST_SERVER.within`. The state is an `S`, so whatever `S`'s invariant says holds of it
-- after every request.
module REST_SERVER[S]

representation {NONE}
  conns: HTTP_SERVER_STATE
  api: REST_ROUTER[S]
  app: S

create {ANY}

  -- A server for `api` in the state `s`, with no connections, listening on `p`.
  make(p: NAT, api: REST_ROUTER[S], s: S): REST_SERVER[S]
    require
      valid_port: p >= 1 and p <= 65535
    do
      { conns = HTTP_SERVER_STATE.make_on_port(64, p), api = api, app = s }
    ensure
      none_open: Result.open_connections = 0
      limit_set: Result.max_connections = 64
      port_set: Result.port = p
    end

  -- Starts `api` in the state `s`, on the port the first argument names, or on `p` when there
  -- is none. An argument that is not a port from 1 to 65535, or a route whose pattern is not
  -- valid, stops the program with exit status 2 and a message, before it listens.
  start(args: SEQ[STRING], p: NAT, api: REST_ROUTER[S], s: S): STEP[REST_SERVER[S]]
    require
      valid_port: p >= 1 and p <= 65535
    do
      match api.invalid_route
        case Some(bad) then
          Stop(2, LIST.empty.prepend(Print(REST_COMMANDS.complaint("grest: route pattern is not valid: ", bad))))
        case None then
          match REST_COMMANDS.first_arg(args)
            case None then
              Continue(REST_SERVER.make(p, api, s), LIST.empty.prepend(Listen(p)))
            case Some(a) then
              match REST_COMMANDS.port_of(a)
                case Some(q) then
                  Continue(REST_SERVER.make(q, api, s), LIST.empty.prepend(Listen(q)))
                case None then
                  Stop(2, LIST.empty.prepend(Print(REST_COMMANDS.complaint("grest: not a port: ", a))))
              end
          end
      end
    ensure
      bad_route_stops: api.invalid_route.is_some implies Result.is_stop
    end

  -- The commands of a step.
  commands(st: STEP[REST_SERVER[S]]): LIST[COMMAND]
    do
      match st
        case Continue(_, cmds) then cmds
        case Stop(_, cmds) then cmds
      end
    ensure
      def: Result = (match st case Continue(_, cmds) then cmds case Stop(_, cmds) then cmds end)
    end

  -- What `serve` promises of a step `st` taken on `e` from `s`:
  --
  -- * the limit on connections is the same, so the number open stays within it;
  -- * an event about a connection `c` does nothing, closes `c`, or sends `c` one answer and
  --   closes it, so a request, or a request that cannot be read, is answered once, and no
  --   connection hears an answer meant for another;
  -- * any other event names no connection.
  within(s: REST_SERVER[S], e: EVENT, st: STEP[REST_SERVER[S]]): BOOL
    do
      REST_SERVER.limit_kept(s, st) and REST_COMMANDS.shaped(e, REST_SERVER.commands(st))
    ensure
      def: Result = (REST_SERVER.limit_kept(s, st) and REST_COMMANDS.shaped(e, REST_SERVER.commands(st)))
    end

  -- `st` keeps the limit on connections of `s`.
  limit_kept(s: REST_SERVER[S], st: STEP[REST_SERVER[S]]): BOOL
    do
      match st
        case Continue(n, _) then n.max_connections = s.max_connections
        case Stop(_, _) then True
      end
    ensure
      def: Result = (match st case Continue(n, _) then n.max_connections = s.max_connections case Stop(_, _) then True end)
    end

feature {ANY}

  open_connections: NAT
    do
      Current.conns.active_connections
    ensure
      within_limit: Result <= Current.max_connections
    end

  max_connections: NAT
    do
      Current.conns.max_connections
    ensure
      in_range: Result >= 1 and Result <= 1024
    end

  port: NAT
    do
      Current.conns.server_port
    ensure
      in_range: Result >= 1 and Result <= 65535
    end

  router: REST_ROUTER[S]
    do
      Current.api
    end

  -- The service's state.
  state: S
    do
      Current.app
    end

  -- The server with its connections replaced.
  with_conns(cs: HTTP_SERVER_STATE): REST_SERVER[S]
    require
      same_limit: cs.max_connections = Current.max_connections
    do
      { Current with conns = cs }
    ensure
      limit_kept: Result.max_connections = Current.max_connections
    end

  -- The server with its connections and its state replaced.
  with_conns_and_state(cs: HTTP_SERVER_STATE, s: S): REST_SERVER[S]
    require
      same_limit: cs.max_connections = Current.max_connections
    do
      { Current with conns = cs, app = s }
    ensure
      limit_kept: Result.max_connections = Current.max_connections
    end

  -- Bytes from `c`: wait for more, or answer the request they complete, or the error that
  -- stops them, and close `c`. A complete request moves the service to the state its
  -- handler gives back.
  on_bytes(c: CONN_ID, data: BYTES): STEP[REST_SERVER[S]]
    do
      match Current.conns.lookup_connection(c)
        case None then
          Continue(Current, REST_COMMANDS.close_only(c))
        case Some(conn) then
          if not conn.connection_status.can_accept_bytes then
            Continue(Current.with_conns(Current.conns.release_connection(c)), REST_COMMANDS.close_only(c))
          else
            match HTTP_PARSER.feed(conn.parser_state, data)
              case NeedMore(next_p) then
                Continue(Current.with_conns(Current.conns.save_connection(conn.with_parser_state(next_p))), LIST.empty)
              case Complete(req, _) then
                let out = Current.api.dispatch(Current.app, req)
                Continue(Current.with_conns_and_state(Current.conns.release_connection(c), out.state), REST_COMMANDS.answer(c, out.response))
              case Failed(err) then
                Continue(Current.with_conns(Current.conns.release_connection(c)), REST_COMMANDS.answer(c, HTTP_RESPONSE.from_error(err)))
            end
          end
      end
    ensure
      within: REST_SERVER.within(Current, Received(c, data), Result)
    end

  -- The step of a REST service for the event `e`.
  serve(e: EVENT): STEP[REST_SERVER[S]]
    do
      match e
        case Accepted(c) then
          if Current.conns.has_connection_room then
            Continue(Current.with_conns(Current.conns.admit_connection(c)), LIST.empty)
          else
            Continue(Current, REST_COMMANDS.close_only(c))
          end
        case Received(c, data) then
          Current.on_bytes(c, data)
        case SendFailed(c, _) then
          Continue(Current.with_conns(Current.conns.release_connection(c)), REST_COMMANDS.close_only(c))
        case Closed(c) then
          Continue(Current.with_conns(Current.conns.release_connection(c)), LIST.empty)
        case ListenFailed(_, _) then
          Stop(1, LIST.empty.prepend(Print("grest: listen failed")))
        case Shutdown then
          Stop(0, LIST.empty)
        case _ then
          Continue(Current, LIST.empty)
      end
    ensure
      shutdown_must_stop: e.is_shutdown implies Result.is_stop
      within: REST_SERVER.within(Current, e, Result)
    end

end
