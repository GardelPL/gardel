-- The commands a `REST_SERVER` step may give, and what it reads from its arguments. They do
-- not depend on the service's state, so they are kept apart from the generic server.
functions REST_COMMANDS

feature {ANY}

  -- `what` followed by `s`, or `what` alone if `s` is too long to add.
  complaint(what: STRING, s: STRING): STRING
    do
      if s.byte_length <= 1024 and what.byte_length <= 1024 then what.concat(s) else what end
    end

  -- The first argument, if there is one.
  first_arg(args: SEQ[STRING]): OPTION[STRING]
    variant
      args
    do
      match args
        case Empty then None
        case Leaf(a) then Some(a)
        case Concat(l, _, _) then REST_COMMANDS.first_arg(l)
      end
    end

  -- `a` as a TCP port: decimal digits for a number from 1 to 65535.
  port_of(a: STRING): OPTION[NAT]
    do
      match NUMBER_TEXT.parse_nat(a)
        case Ok(n) then
          if n >= 1 and n <= 65535 then Some(n) else None end
        case Error(_) then None
      end
    ensure
      in_range: Result.is_some implies (Result.get >= 1 and Result.get <= 65535)
    end

  -- `cmd` is `Close(c)`.
  closes(cmd: COMMAND, c: CONN_ID): BOOL
    do
      match cmd
        case Close(d) then d = c
        case _ then False
      end
    ensure
      def: Result = (match cmd case Close(d) then d = c case _ then False end)
    end

  -- `cmd` is `Send(c, _)`.
  sends(cmd: COMMAND, c: CONN_ID): BOOL
    do
      match cmd
        case Send(d, _) then d = c
        case _ then False
      end
    ensure
      def: Result = (match cmd case Send(d, _) then d = c case _ then False end)
    end

  -- The timer of the sweep that closes idle connections.
  sweep_timer: NAT
    do
      0
    ensure
      def: Result = 0
    end

  -- The time between sweeps, in milliseconds. With `HTTP_CONNECTION.max_idle_ticks`, a
  -- connection that completes no request is closed after 4 to 5 seconds.
  sweep_millis: U64
    do
      1000
    ensure
      def: Result = 1000
    end

  -- The command that sets the next sweep.
  rearm: COMMAND
    do
      SetTimer(REST_COMMANDS.sweep_timer, REST_COMMANDS.sweep_millis)
    ensure
      sets: REST_COMMANDS.rearms(Result)
    end

  -- `cmd` sets the next sweep.
  rearms(cmd: COMMAND): BOOL
    do
      match cmd
        case SetTimer(id, ms) then id = REST_COMMANDS.sweep_timer and ms = REST_COMMANDS.sweep_millis
        case _ then False
      end
    ensure
      def: Result = (match cmd case SetTimer(id, ms) then id = REST_COMMANDS.sweep_timer and ms = REST_COMMANDS.sweep_millis case _ then False end)
    end

  -- `cmd` closes a connection.
  closes_one(cmd: COMMAND): BOOL
    do
      match cmd
        case Close(_) then True
        case _ then False
      end
    ensure
      def: Result = (match cmd case Close(_) then True case _ then False end)
    end

  -- `cmd` names no connection, and leaves the sweep's timer alone.
  quiet(cmd: COMMAND): BOOL
    do
      match cmd
        case Send(_, _) then False
        case Close(_) then False
        case SetTimer(id, _) then id != REST_COMMANDS.sweep_timer
        case CancelTimer(id) then id != REST_COMMANDS.sweep_timer
        case _ then True
      end
    ensure
      def: Result = (match cmd
        case Send(_, _) then False
        case Close(_) then False
        case SetTimer(id, _) then id != REST_COMMANDS.sweep_timer
        case CancelTimer(id) then id != REST_COMMANDS.sweep_timer
        case _ then True
      end)
    end

  -- What an event about the connection `c` may do: send `c` answers, one per request, and
  -- then perhaps close it. Nothing is sent after the close, and nothing to another
  -- connection.
  for_conn(cmds: LIST[COMMAND], c: CONN_ID): BOOL
    variant
      cmds.length
    do
      if cmds.length = 0 then
        True
      else if cmds.length = 1 then
        REST_COMMANDS.closes(cmds.head, c) or REST_COMMANDS.sends(cmds.head, c)
      else
        REST_COMMANDS.sends(cmds.head, c) and REST_COMMANDS.for_conn(cmds.tail, c)
      end end
    ensure
      def: Result = (cmds.length = 0
        or (cmds.length = 1 and (REST_COMMANDS.closes(cmds.head, c) or REST_COMMANDS.sends(cmds.head, c)))
        or (cmds.length >= 2 and REST_COMMANDS.sends(cmds.head, c) and REST_COMMANDS.for_conn(cmds.tail, c)))
    end

  -- How many answers `cmds` sends to `c`.
  sent_to(cmds: LIST[COMMAND], c: CONN_ID): NAT
    require
      bounded: cmds.length <= 1000
    variant
      cmds.length
    do
      if cmds.length = 0 then
        0
      else if REST_COMMANDS.sends(cmds.head, c) then
        REST_COMMANDS.sent_to(cmds.tail, c) + 1
      else
        REST_COMMANDS.sent_to(cmds.tail, c)
      end end
    ensure
      at_most: Result <= cmds.length
    end

  -- `cmd` is a `Send`.
  sends_one(cmd: COMMAND): BOOL
    do
      match cmd
        case Send(_, _) then True
        case _ then False
      end
    ensure
      def: Result = (match cmd case Send(_, _) then True case _ then False end)
    end

  -- `cmd` names none of the connections `cs` holds, and leaves the sweep's timer alone: a
  -- command of the service's own, such as a `Connect` or a `Send` to a connection it opened.
  foreign(cmd: COMMAND, cs: HTTP_SERVER_STATE): BOOL
    do
      match cmd
        case Send(d, _) then cs.lookup_connection(d).is_none
        case Close(d) then cs.lookup_connection(d).is_none
        case SetTimer(id, _) then id != REST_COMMANDS.sweep_timer
        case CancelTimer(id) then id != REST_COMMANDS.sweep_timer
        case _ then True
      end
    ensure
      def: Result = (match cmd
        case Send(d, _) then cs.lookup_connection(d).is_none
        case Close(d) then cs.lookup_connection(d).is_none
        case SetTimer(id, _) then id != REST_COMMANDS.sweep_timer
        case CancelTimer(id) then id != REST_COMMANDS.sweep_timer
        case _ then True
      end)
    end

  -- Every one of `cmds` is the service's own.
  all_foreign(cmds: LIST[COMMAND], cs: HTTP_SERVER_STATE): BOOL
    variant
      cmds.length
    do
      if cmds.length = 0 then True else REST_COMMANDS.foreign(cmds.head, cs) and REST_COMMANDS.all_foreign(cmds.tail, cs) end
    ensure
      def: Result = (cmds.length = 0 or (REST_COMMANDS.foreign(cmds.head, cs) and REST_COMMANDS.all_foreign(cmds.tail, cs)))
    end

  -- The commands of `cmds` that are the service's own, in order: the server sends no other
  -- command a service gives.
  own(cmds: LIST[COMMAND], cs: HTTP_SERVER_STATE): LIST[COMMAND]
    variant
      cmds.length
    do
      if cmds.length = 0 then
        LIST.empty
      else if REST_COMMANDS.foreign(cmds.head, cs) then
        REST_COMMANDS.own(cmds.tail, cs).prepend(cmds.head)
      else
        REST_COMMANDS.own(cmds.tail, cs)
      end end
    ensure
      all_own: REST_COMMANDS.all_foreign(Result, cs)
      woken: REST_COMMANDS.for_wake(Result, cs)
      not_longer: Result.length <= cmds.length
    end

  -- Commands of the service's own send nothing to `c`, a connection `cs` holds.
  none_to(cmds: LIST[COMMAND], cs: HTTP_SERVER_STATE, c: CONN_ID): BOOL
    require
      held: cs.lookup_connection(c).is_some
      own: REST_COMMANDS.all_foreign(cmds, cs)
      bounded: cmds.length <= 1000
    variant
      cmds.length
    do
      if cmds.length = 0 then True else REST_COMMANDS.none_to(cmds.tail, cs, c) end
    ensure
      holds: Result
      none: REST_COMMANDS.sent_to(cmds, c) = 0
    end

  -- What bytes from the connection `c`, which `cs` holds, may do: send `c` answers, one per
  -- request, and then either close it or send commands of the service's own, for a request
  -- that waits.
  for_conn_out(cmds: LIST[COMMAND], c: CONN_ID, cs: HTTP_SERVER_STATE): BOOL
    variant
      cmds.length
    do
      if cmds.length = 0 then
        True
      else if REST_COMMANDS.sends(cmds.head, c) then
        REST_COMMANDS.for_conn_out(cmds.tail, c, cs)
      else if REST_COMMANDS.closes(cmds.head, c) then
        cmds.length = 1
      else
        REST_COMMANDS.all_foreign(cmds, cs)
      end end end
    ensure
      def: Result = (cmds.length = 0
        or (cmds.length >= 1 and REST_COMMANDS.sends(cmds.head, c) and REST_COMMANDS.for_conn_out(cmds.tail, c, cs))
        or (cmds.length >= 1 and not REST_COMMANDS.sends(cmds.head, c) and REST_COMMANDS.closes(cmds.head, c) and cmds.length = 1)
        or (cmds.length >= 1 and not REST_COMMANDS.sends(cmds.head, c) and not REST_COMMANDS.closes(cmds.head, c) and REST_COMMANDS.all_foreign(cmds, cs)))
    end

  -- One answer: a `Send`, perhaps followed by the close of the same connection.
  one_answer(cmds: LIST[COMMAND]): BOOL
    do
      if cmds.length = 0 then
        False
      else
        match cmds.head
          case Send(d, _) then cmds.length = 1 or (cmds.length = 2 and REST_COMMANDS.closes(cmds.tail.head, d))
          case _ then False
        end
      end
    end

  -- What an event the service handles may do: send commands of the service's own, and then
  -- perhaps one answer to a request that waited.
  for_wake(cmds: LIST[COMMAND], cs: HTTP_SERVER_STATE): BOOL
    variant
      cmds.length
    do
      if cmds.length = 0 then
        True
      else if REST_COMMANDS.foreign(cmds.head, cs) then
        REST_COMMANDS.for_wake(cmds.tail, cs)
      else
        REST_COMMANDS.one_answer(cmds)
      end end
    ensure
      def: Result = (cmds.length = 0
        or (cmds.length >= 1 and REST_COMMANDS.foreign(cmds.head, cs) and REST_COMMANDS.for_wake(cmds.tail, cs))
        or (cmds.length >= 1 and not REST_COMMANDS.foreign(cmds.head, cs) and REST_COMMANDS.one_answer(cmds)))
    end

  -- `own` and then `ans`, an answer or nothing.
  before_answer(own: LIST[COMMAND], ans: LIST[COMMAND], cs: HTTP_SERVER_STATE): LIST[COMMAND]
    require
      own: REST_COMMANDS.all_foreign(own, cs)
      answer: ans.length = 0 or REST_COMMANDS.one_answer(ans)
    variant
      own.length
    do
      if own.length = 0 then ans else REST_COMMANDS.before_answer(own.tail, ans, cs).prepend(own.head) end
    ensure
      woken: REST_COMMANDS.for_wake(Result, cs)
      count: Result.length = own.length + ans.length
    end

  -- The answer `wire` to `c`, and its close when `close`.
  answer_wire(c: CONN_ID, wire: BYTES, close: BOOL): LIST[COMMAND]
    do
      if close then
        LIST.empty.prepend(Close(c)).prepend(Send(c, wire))
      else
        LIST.empty.prepend(Send(c, wire))
      end
    ensure
      one: REST_COMMANDS.one_answer(Result)
      short: Result.length <= 2
    end

  -- What a sweep may do: close connections and answer requests whose time ran out, then set
  -- the next sweep, last.
  for_sweep(cmds: LIST[COMMAND]): BOOL
    variant
      cmds.length
    do
      if cmds.length = 0 then
        False
      else if cmds.length = 1 then
        REST_COMMANDS.rearms(cmds.head)
      else
        (REST_COMMANDS.closes_one(cmds.head) or REST_COMMANDS.sends_one(cmds.head)) and REST_COMMANDS.for_sweep(cmds.tail)
      end end
    ensure
      def: Result = ((cmds.length = 1 and REST_COMMANDS.rearms(cmds.head))
        or (cmds.length >= 2 and (REST_COMMANDS.closes_one(cmds.head) or REST_COMMANDS.sends_one(cmds.head)) and REST_COMMANDS.for_sweep(cmds.tail)))
    end

  -- The closes of `ids`, then `cmds`.
  closing_all(ids: LIST[CONN_ID], cmds: LIST[COMMAND]): LIST[COMMAND]
    require
      swept: REST_COMMANDS.for_sweep(cmds)
    variant
      ids.length
    do
      if ids.length = 0 then cmds else REST_COMMANDS.closing_all(ids.tail, cmds).prepend(Close(ids.head)) end
    ensure
      swept: REST_COMMANDS.for_sweep(Result)
      count: Result.length = ids.length + cmds.length
    end

  -- The commands of a sweep that closes `ids`.
  sweep_commands(ids: LIST[CONN_ID]): LIST[COMMAND]
    variant
      ids.length
    do
      if ids.length = 0 then
        LIST.empty.prepend(REST_COMMANDS.rearm)
      else
        REST_COMMANDS.sweep_commands(ids.tail).prepend(Close(ids.head))
      end
    ensure
      swept: REST_COMMANDS.for_sweep(Result)
      count: Result.length = ids.length + 1
    end

  -- What any other event may do: at most one command, which names no connection.
  for_none(cmds: LIST[COMMAND]): BOOL
    do
      if cmds.length = 0 then
        True
      else if cmds.length = 1 then
        REST_COMMANDS.quiet(cmds.head)
      else
        False
      end end
    ensure
      def: Result = (cmds.length = 0 or (cmds.length = 1 and REST_COMMANDS.quiet(cmds.head)))
    end

  -- `cmds` is what an event `e` may do, from a server whose connections are `cs`: see
  -- `REST_SERVER.within`.
  shaped(e: EVENT, cmds: LIST[COMMAND], cs: HTTP_SERVER_STATE): BOOL
    do
      match e
        case Accepted(c) then REST_COMMANDS.for_conn(cmds, c)
        case Received(c, _) then
          if cs.lookup_connection(c).is_some then REST_COMMANDS.for_conn_out(cmds, c, cs) else REST_COMMANDS.for_wake(cmds, cs) end
        case SendFailed(c, _) then
          if cs.lookup_connection(c).is_some then REST_COMMANDS.for_conn(cmds, c) else REST_COMMANDS.for_wake(cmds, cs) end
        case Closed(c) then
          if cs.lookup_connection(c).is_some then REST_COMMANDS.for_conn(cmds, c) else REST_COMMANDS.for_wake(cmds, cs) end
        case Tick(id) then
          if id = REST_COMMANDS.sweep_timer then REST_COMMANDS.for_sweep(cmds) else REST_COMMANDS.for_wake(cmds, cs) end
        case _ then REST_COMMANDS.for_wake(cmds, cs)
      end
    ensure
      def: Result = (match e
        case Accepted(c) then REST_COMMANDS.for_conn(cmds, c)
        case Received(c, _) then
          (if cs.lookup_connection(c).is_some then REST_COMMANDS.for_conn_out(cmds, c, cs) else REST_COMMANDS.for_wake(cmds, cs) end)
        case SendFailed(c, _) then
          (if cs.lookup_connection(c).is_some then REST_COMMANDS.for_conn(cmds, c) else REST_COMMANDS.for_wake(cmds, cs) end)
        case Closed(c) then
          (if cs.lookup_connection(c).is_some then REST_COMMANDS.for_conn(cmds, c) else REST_COMMANDS.for_wake(cmds, cs) end)
        case Tick(id) then
          (if id = REST_COMMANDS.sweep_timer then REST_COMMANDS.for_sweep(cmds) else REST_COMMANDS.for_wake(cmds, cs) end)
        case _ then REST_COMMANDS.for_wake(cmds, cs)
      end)
    end

  -- One answer to the connection `c`, saying `Connection: close`, then its close.
  answer(c: CONN_ID, resp: HTTP_RESPONSE): LIST[COMMAND]
    do
      LIST.empty.prepend(Close(c)).prepend(Send(c, HTTP_SERIALIZER.serialize_answer(resp, False, True)))
    ensure
      once: REST_COMMANDS.for_conn(Result, c)
      two: Result.length = 2
    end

  -- Only `Close(c)`.
  close_only(c: CONN_ID): LIST[COMMAND]
    do
      LIST.empty.prepend(Close(c))
    ensure
      once: REST_COMMANDS.for_conn(Result, c)
      one: Result.length = 1
    end

end
