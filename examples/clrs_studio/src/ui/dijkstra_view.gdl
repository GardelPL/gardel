-- Weighted directed graph visualizer + live distance & shortest-path table for `DIJKSTRA`.
-- Highlights the shortest-paths tree G_π = {(v.π, v)} directly on the graph with double-line
-- green arrows (like CLRS Figure 22.2(b)) and reconstructs the full `Path from s` for every vertex.
functions DIJKSTRA_VIEW

feature {ANY}

  dist_text(d: NAT): STRING
    do
      if d >= 999999 then "∞" else NUMBER_TEXT.nat_to_text(d) end
    end

  node_badge(dj: DIJKSTRA, v: NAT): STRING
    require
      v_in: v < dj.vertex_count
    do
      let nm = DIJKSTRA_PRESETS.vertex_label(v)
      let d = DIJKSTRA_VIEW.dist_text(LIST_OPS.at(dj.distances, v))
      GLYPHS.join(GLYPHS.join("[", nm), GLYPHS.join(":", GLYPHS.join(d, "]")))
    end

  node_style(dj: DIJKSTRA, v: NAT, t: THEME, highlight_proven: BOOL): STYLE
    require
      v_in: v < dj.vertex_count
    do
      let ph = dj.phase_code
      let is_vis = LIST_OPS.at(dj.visited_flags, v)
      if ph = 1 and v = dj.active_u then
        STYLE.plain.fg(COLOR.yellow).bold
      else if ph = 1 and v = dj.active_v then
        t.focused_border
      else if is_vis and highlight_proven then
        STYLE.plain.fg(COLOR.green).bold
      else
        t.base
      end end end
    end

  -- True when directed edge `(u, v)` exists and is currently part of the predecessor tree G_π.
  is_tree_edge(dj: DIJKSTRA, u: NAT, v: NAT): BOOL
    require
      u_in: u < dj.vertex_count
      v_in: v < dj.vertex_count
    do
      dj.edge_weight(u, v) < 999999 and LIST_OPS.at(dj.parents, v) = u
    end

  edge_style(dj: DIJKSTRA, u: NAT, v: NAT, t: THEME, highlight_proven: BOOL): STYLE
    require
      u_in: u < dj.vertex_count
      v_in: v < dj.vertex_count
    do
      if dj.phase_code = 1 and dj.active_u = u and dj.active_v = v then
        t.focused_border
      else if highlight_proven and DIJKSTRA_VIEW.is_tree_edge(dj, u, v) then
        STYLE.plain.fg(COLOR.bright_green).bold
      else
        t.gutter
      end end
    end

  -- Reconstruct the predecessor path `s → ... → v` by walking `parent[]` with bounded steps.
  path_to(dj: DIJKSTRA, v: NAT, limit: NAT): STRING
    require
      v_in: v < dj.vertex_count
    variant
      limit
    do
      let lbl = DIJKSTRA_PRESETS.vertex_label(v)
      if v = dj.source_vertex or limit = 0 then
        lbl
      else
        let p = LIST_OPS.at(dj.parents, v)
        if p < dj.vertex_count and p != v then
          GLYPHS.join(DIJKSTRA_VIEW.path_to(dj, p, limit - 1), GLYPHS.join("→", lbl))
        else
          "—"
        end
      end
    end

  status_text(dj: DIJKSTRA, v: NAT): STRING
    require
      v_in: v < dj.vertex_count
    do
      let ph = dj.phase_code
      let is_vis = LIST_OPS.at(dj.visited_flags, v)
      if ph = 1 and v = dj.active_u then "◀ Active u"
      else if ph = 1 and v = dj.active_v then "▶ Relax v"
      else if is_vis then "✓ Settled"
      else "Frontier"
      end end end
    end

  row5(a: STRING, b: STRING, c: STRING, d: STRING, e: STRING): LIST[STRING]
    do
      let none: LIST[STRING] = LIST.empty
      none.prepend(e).prepend(d).prepend(c).prepend(b).prepend(a)
    end

  build_rows(dj: DIJKSTRA, idx: NAT): LIST[LIST[STRING]]
    variant
      if dj.vertex_count > idx then dj.vertex_count - idx else 0 end
    do
      if idx >= dj.vertex_count then
        LIST.empty
      else
        let nm = DIJKSTRA_PRESETS.vertex_label(idx)
        let d = DIJKSTRA_VIEW.dist_text(LIST_OPS.at(dj.distances, idx))
        let p = LIST_OPS.at(dj.parents, idx)
        let p_txt = if p < dj.vertex_count then DIJKSTRA_PRESETS.vertex_label(p) else "—" end
        let path_txt = DIJKSTRA_VIEW.path_to(dj, idx, dj.vertex_count)
        let st = DIJKSTRA_VIEW.status_text(dj, idx)
        DIJKSTRA_VIEW.build_rows(dj, idx + 1).prepend(DIJKSTRA_VIEW.row5(nm, d, p_txt, path_txt, st))
      end
    end

  dist_table(dj: DIJKSTRA): TABLE
    do
      let widths: LIST[SIZE] = LIST.empty
        .prepend(SIZE.fixed(10))
        .prepend(SIZE.flex(1))
        .prepend(SIZE.fixed(4))
        .prepend(SIZE.fixed(6))
        .prepend(SIZE.fixed(5))
      let hdr = DIJKSTRA_VIEW.row5("Node", "d[v]", "π", "Path from s", "Status")
      let rows = DIJKSTRA_VIEW.build_rows(dj, 0)
      TABLE.with_headers(widths, hdr, rows)
    end

  -- Render the 5-node weighted graph with highlighted tree edges G_π, path table, and summary.
  draw(s: SCREEN, r: RECT, dj: DIJKSTRA, t: THEME, highlight_proven: BOOL, show_values: BOOL): SCREEN
    do
      if r.is_empty or r.height < 6 or r.width < 20 or r.x > 65000 or r.y > 65000 or r.width > 65000 or r.height > 65000 then
        s
      else if dj.vertex_count < 5 then
        s
      else
        let x = r.x
        let y = r.y
        let st_s = DIJKSTRA_VIEW.node_style(dj, 0, t, highlight_proven)
        let st_t = DIJKSTRA_VIEW.node_style(dj, 1, t, highlight_proven)
        let st_x = DIJKSTRA_VIEW.node_style(dj, 2, t, highlight_proven)
        let st_y = DIJKSTRA_VIEW.node_style(dj, 3, t, highlight_proven)
        let st_z = DIJKSTRA_VIEW.node_style(dj, 4, t, highlight_proven)

        let b_s = DIJKSTRA_VIEW.node_badge(dj, 0)
        let b_t = DIJKSTRA_VIEW.node_badge(dj, 1)
        let b_x = DIJKSTRA_VIEW.node_badge(dj, 2)
        let b_y = DIJKSTRA_VIEW.node_badge(dj, 3)
        let b_z = DIJKSTRA_VIEW.node_badge(dj, 4)

        let w_st = dj.edge_weight(0, 1)
        let w_sy = dj.edge_weight(0, 3)
        let w_tx = dj.edge_weight(1, 2)
        let w_ty = dj.edge_weight(1, 3)
        let w_yt = dj.edge_weight(3, 1)
        let w_xz = dj.edge_weight(2, 4)
        let w_yz = dj.edge_weight(3, 4)

        -- Row 0: [t] ──w──▶ [x]
        let s1 = s.text(r, x + 12, y, b_t, st_t)
        let s2 = if w_tx < 999999 then
          let in_tree = highlight_proven and DIJKSTRA_VIEW.is_tree_edge(dj, 1, 2)
          let wtxt = if show_values then NUMBER_TEXT.nat_to_text(w_tx) else "─" end
          let conn = if in_tree then GLYPHS.join("══", GLYPHS.join(wtxt, "══▶")) else GLYPHS.join("──", GLYPHS.join(wtxt, "──▶")) end
          s1.text(r, x + 20, y, conn, DIJKSTRA_VIEW.edge_style(dj, 1, 2, t, highlight_proven))
        else
          s1
        end
        let s3 = s2.text(r, x + 29, y, b_x, st_x)

        -- Row 1: (s->t), (t->y), (y->t), (x->z)
        let s4 = if w_st < 999999 then
          let in_tree = highlight_proven and DIJKSTRA_VIEW.is_tree_edge(dj, 0, 1)
          let wtxt = if show_values then NUMBER_TEXT.nat_to_text(w_st) else "─" end
          let seg = if in_tree then GLYPHS.join("╔═", GLYPHS.join(wtxt, "═╝")) else GLYPHS.join("╭─", GLYPHS.join(wtxt, "─╯")) end
          s3.text(r, x + 5, y + 1, seg, DIJKSTRA_VIEW.edge_style(dj, 0, 1, t, highlight_proven))
        else
          s3
        end
        let s5 = if w_ty < 999999 then
          let in_tree = highlight_proven and DIJKSTRA_VIEW.is_tree_edge(dj, 1, 3)
          let wtxt = if show_values then NUMBER_TEXT.nat_to_text(w_ty) else "" end
          let seg = if in_tree then GLYPHS.join("║", wtxt) else GLYPHS.join("↓", wtxt) end
          s4.text(r, x + 13, y + 1, seg, DIJKSTRA_VIEW.edge_style(dj, 1, 3, t, highlight_proven))
        else
          s4
        end
        let s6 = if w_yt < 999999 then
          let in_tree = highlight_proven and DIJKSTRA_VIEW.is_tree_edge(dj, 3, 1)
          let wtxt = if show_values then NUMBER_TEXT.nat_to_text(w_yt) else "" end
          let seg = if in_tree then GLYPHS.join("▲", wtxt) else GLYPHS.join("↑", wtxt) end
          s5.text(r, x + 17, y + 1, seg, DIJKSTRA_VIEW.edge_style(dj, 3, 1, t, highlight_proven))
        else
          s5
        end
        let s7 = if w_xz < 999999 then
          let in_tree = highlight_proven and DIJKSTRA_VIEW.is_tree_edge(dj, 2, 4)
          let wtxt = if show_values then NUMBER_TEXT.nat_to_text(w_xz) else "" end
          let seg = if in_tree then GLYPHS.join("║", wtxt) else GLYPHS.join("↓", wtxt) end
          s6.text(r, x + 31, y + 1, seg, DIJKSTRA_VIEW.edge_style(dj, 2, 4, t, highlight_proven))
        else
          s6
        end

        -- Row 2: [s] and vertical stems
        let s8 = s7.text(r, x, y + 2, b_s, st_s)
        let s9 = if w_ty < 999999 then
          let ch = if highlight_proven and DIJKSTRA_VIEW.is_tree_edge(dj, 1, 3) then "║" else "│" end
          s8.text(r, x + 13, y + 2, ch, DIJKSTRA_VIEW.edge_style(dj, 1, 3, t, highlight_proven))
        else
          s8
        end
        let s10 = if w_yt < 999999 then
          let ch = if highlight_proven and DIJKSTRA_VIEW.is_tree_edge(dj, 3, 1) then "║" else "│" end
          s9.text(r, x + 17, y + 2, ch, DIJKSTRA_VIEW.edge_style(dj, 3, 1, t, highlight_proven))
        else
          s9
        end
        let s11 = if w_xz < 999999 then
          let ch = if highlight_proven and DIJKSTRA_VIEW.is_tree_edge(dj, 2, 4) then "║" else "│" end
          s10.text(r, x + 31, y + 2, ch, DIJKSTRA_VIEW.edge_style(dj, 2, 4, t, highlight_proven))
        else
          s10
        end

        -- Row 3: (s->y) and lower arrowheads
        let s12 = if w_sy < 999999 then
          let in_tree = highlight_proven and DIJKSTRA_VIEW.is_tree_edge(dj, 0, 3)
          let wtxt = if show_values then NUMBER_TEXT.nat_to_text(w_sy) else "─" end
          let seg = if in_tree then GLYPHS.join("╚═", GLYPHS.join(wtxt, "═╗")) else GLYPHS.join("╰─", GLYPHS.join(wtxt, "─╮")) end
          s11.text(r, x + 5, y + 3, seg, DIJKSTRA_VIEW.edge_style(dj, 0, 3, t, highlight_proven))
        else
          s11
        end
        let s13 = if w_ty < 999999 then
          s12.text(r, x + 13, y + 3, "▼", DIJKSTRA_VIEW.edge_style(dj, 1, 3, t, highlight_proven))
        else
          s12
        end
        let s14 = if w_yt < 999999 then
          let ch = if highlight_proven and DIJKSTRA_VIEW.is_tree_edge(dj, 3, 1) then "║" else "│" end
          s13.text(r, x + 17, y + 3, ch, DIJKSTRA_VIEW.edge_style(dj, 3, 1, t, highlight_proven))
        else
          s13
        end
        let s15 = if w_xz < 999999 then
          s14.text(r, x + 31, y + 3, "▼", DIJKSTRA_VIEW.edge_style(dj, 2, 4, t, highlight_proven))
        else
          s14
        end

        -- Row 4: [y] ──w──▶ [z]
        let s16 = s15.text(r, x + 12, y + 4, b_y, st_y)
        let s17 = if w_yz < 999999 then
          let in_tree = highlight_proven and DIJKSTRA_VIEW.is_tree_edge(dj, 3, 4)
          let wtxt = if show_values then NUMBER_TEXT.nat_to_text(w_yz) else "─" end
          let conn = if in_tree then GLYPHS.join("══", GLYPHS.join(wtxt, "══▶")) else GLYPHS.join("──", GLYPHS.join(wtxt, "──▶")) end
          s16.text(r, x + 20, y + 4, conn, DIJKSTRA_VIEW.edge_style(dj, 3, 4, t, highlight_proven))
        else
          s16
        end
        let s18 = s17.text(r, x + 29, y + 4, b_z, st_z)

        -- Distance & Shortest Path Table (6 rows: 1 header + 5 vertices)
        let tbl_r = r.drop_top(6).take_top(6)
        let s19 = if tbl_r.height >= 2 then
          DIJKSTRA_VIEW.dist_table(dj).draw(s18, tbl_r, t.base, t.keyword.bold, t.base)
        else
          s18
        end

        -- Highlighted Shortest-Path Summary banner below the table
        let s20 = if r.height >= 15 then
          let dz = LIST_OPS.at(dj.distances, 4)
          let pz = DIJKSTRA_VIEW.path_to(dj, 4, dj.vertex_count)
          let hdr_line = if dj.is_done then
            "★ Shortest path s → z (proven optimal):"
          else
            "Current best path s → z:"
          end
          let val_line = if dz < 999999 then
            GLYPHS.join(GLYPHS.join("  ", pz), GLYPHS.join("   (total weight = ", GLYPHS.join(NUMBER_TEXT.nat_to_text(dz), ")")))
          else
            "  (not yet reachable)"
          end
          let st_sum = if dj.is_done then STYLE.plain.fg(COLOR.bright_green).bold else t.active_tab end
          let sa = s19.text(r, x, y + 13, hdr_line, t.keyword.bold)
          sa.text(r, x, y + 14, val_line, st_sum)
        else
          s19
        end

        -- Legend on bottom row
        let legend_y = r.y + r.height - 1
        let s21 = s20.text(r, x, legend_y, "═ tree G_π / settled  ", STYLE.plain.fg(COLOR.bright_green).bold)
        let s22 = s21.text(r, x + 22, legend_y, "■ active u  ", STYLE.plain.fg(COLOR.yellow).bold)
        s22.text(r, x + 34, legend_y, "■ relax v", t.focused_border)
      end end
    ensure
      same_width: Result.width = s.width
      same_height: Result.height = s.height
    end

end
