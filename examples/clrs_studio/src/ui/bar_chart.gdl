-- Multi-row Unicode block bar chart renderer for `INSERTION_SORT`.
-- Colors match the verified invariant badges in `CONTRACT_PANEL`:
--   Green  = proven sorted prefix
--   Yellow = active `key` being inserted
--   Cyan   = element currently being compared / shifted
--   Base   = untouched suffix
functions BAR_CHART

feature {ANY}

  -- Maximum value in `xs` (at least 1 so scaling never divides by zero).
  max_val(xs: LIST[NAT]): NAT
    variant
      xs.length
    do
      if xs.length = 0 then
        1
      else
        let rest = BAR_CHART.max_val(xs.tail)
        if xs.head > rest then xs.head else rest end
      end
    ensure
      pos: Result >= 1
    end

  -- Display value at slot `idx`: during CompareShift/InsertKey, show `key` at `hole`.
  shown_value(st: INSERTION_SORT, idx: NAT): NAT
    require
      in_bounds: idx < st.length
    do
      let ph = st.phase_code
      if (ph = 1 or ph = 2) and idx = st.hole_index then
        st.active_key
      else
        LIST_OPS.at(st.elements, idx)
      end
    end

  -- Semantic style for bar `idx`, matching the verified CLRS invariant regions.
  bar_style(st: INSERTION_SORT, idx: NAT, t: THEME, highlight_proven: BOOL): STYLE
    do
      let ph = st.phase_code
      let proven_style = STYLE.plain.fg(COLOR.green).bold
      let key_style = STYLE.plain.fg(COLOR.yellow).bold
      let cmp_style = t.focused_border
      if ph = 3 then
        if highlight_proven then proven_style else t.base end
      else if ph = 0 then
        if idx = st.outer_j then
          key_style
        else if idx < st.outer_j and highlight_proven then
          proven_style
        else
          t.base
        end end
      else if ph = 1 then
        if idx = st.hole_index then
          key_style
        else if st.hole_index > 0 and idx = st.hole_index - 1 then
          cmp_style
        else if idx <= st.outer_j and highlight_proven then
          proven_style
        else
          t.base
        end end end
      else
        -- InsertKey
        if idx = st.hole_index then
          key_style
        else if idx <= st.outer_j and highlight_proven then
          proven_style
        else
          t.base
        end end
      end end end
    end

  -- Pointer marker below bar `idx`.
  pointer_label(st: INSERTION_SORT, idx: NAT): STRING
    do
      let ph = st.phase_code
      if ph = 3 then
        "ok"
      else if ph = 0 then
        if idx = st.outer_j then "^j" else NUMBER_TEXT.nat_to_text(idx) end
      else if idx = st.hole_index then
        "^key"
      else if ph = 1 and st.hole_index > 0 and idx = st.hole_index - 1 then
        "^cmp"
      else if idx = st.outer_j then
        "^j"
      else
        NUMBER_TEXT.nat_to_text(idx)
      end end end end end
    end

  -- Compute bar height in rows (`0..plot_h`), safe from overflow.
  bar_height(v: NAT, plot_h: NAT, mval: NAT): NAT
    require
      mval_pos: mval >= 1
      plot_ok: plot_h <= 200
    do
      if plot_h = 0 or v = 0 then
        0
      else if v <= 999 then
        let h_raw = v * plot_h / mval
        if h_raw = 0 then 1 else if h_raw <= plot_h then h_raw else plot_h end end
      else
        plot_h
      end end
    ensure
      within: Result <= plot_h
    end

  -- Render the entire bar chart, labels, pointers, and color legend inside `r`.
  draw(s: SCREEN, r: RECT, st: INSERTION_SORT, t: THEME, highlight_proven: BOOL, show_values: BOOL): SCREEN
    do
      if r.is_empty or r.height < 4 or r.width < 6 or r.x > 65000 or r.y > 65000 or r.width > 65000 or r.height > 65000 then
        s
      else
        let n = st.length
        let mval = BAR_CHART.max_val(st.elements)
        let legend_y = r.y + r.height - 1
        let ptr_y = r.y + r.height - 2
        let val_y = if show_values and r.height >= 5 then r.y + r.height - 3 else ptr_y end
        let raw_plot_h = if show_values and r.height >= 5 then r.height - 3 else r.height - 2 end
        let plot_h = if raw_plot_h <= 200 then raw_plot_h else 200 end
        let col_w_raw = r.width / n
        let col_w = if col_w_raw < 2 then 2 else if col_w_raw > 6 then 6 else col_w_raw end end
        let s1 = BAR_CHART.draw_bars(s, r, r.x, r.y, r.x + r.width, st, t, highlight_proven, show_values, 0, n, mval, plot_h, val_y, ptr_y, col_w)
        -- Draw color legend on the bottom row of `r`.
        let s2 = s1.text(r, r.x, legend_y, "■ proven sorted  ", STYLE.plain.fg(COLOR.green).bold)
        let s3 = s2.text(r, r.x + 17, legend_y, "■ key  ", STYLE.plain.fg(COLOR.yellow).bold)
        s3.text(r, r.x + 24, legend_y, "■ comparing", t.focused_border)
      end
    ensure
      same_width: Result.width = s.width
      same_height: Result.height = s.height
    end

  draw_bars(
    s: SCREEN, r: RECT, rx: NAT, ry: NAT, rright: NAT, st: INSERTION_SORT, t: THEME,
    highlight_proven: BOOL, show_values: BOOL,
    idx: NAT, n: NAT, mval: NAT, plot_h: NAT, val_y: NAT, ptr_y: NAT, col_w: NAT
  ): SCREEN
    require
      rx_ok: rx <= 65000
      ry_ok: ry <= 65000
      n_ok: n = st.length and n <= 32
      mval_pos: mval >= 1
      plot_ok: plot_h <= 200
      col_pos: col_w >= 2 and col_w <= 6
    variant
      if n > idx then n - idx else 0 end
    do
      if idx >= n then
        s
      else
        let x0 = rx + idx * col_w
        if x0 >= rright or x0 > 65500 then
          s
        else
          let v = BAR_CHART.shown_value(st, idx)
          let bar_st = BAR_CHART.bar_style(st, idx, t, highlight_proven)
          let scaled = BAR_CHART.bar_height(v, plot_h, mval)
          let bar_w = if col_w >= 3 then col_w - 1 else 1 end
          let s1 = BAR_CHART.draw_one_bar(s, r, x0, ry, plot_h, scaled, bar_w, bar_st, 0)
          let s2 = if show_values then
            let vtxt = NUMBER_TEXT.nat_to_text(v)
            s1.text(r, x0, val_y, vtxt, bar_st)
          else
            s1
          end
          let ptr = BAR_CHART.pointer_label(st, idx)
          let s3 = s2.text(r, x0, ptr_y, ptr, t.gutter)
          BAR_CHART.draw_bars(s3, r, rx, ry, rright, st, t, highlight_proven, show_values, idx + 1, n, mval, plot_h, val_y, ptr_y, col_w)
        end
      end
    ensure
      same_width: Result.width = s.width
      same_height: Result.height = s.height
    end

  draw_one_bar(s: SCREEN, clip: RECT, x: NAT, top_y: NAT, plot_h: NAT, bar_h: NAT, bar_w: NAT, st: STYLE, row: NAT): SCREEN
    require
      x_ok: x <= 65500
      top_ok: top_y <= 65535
      plot_ok: plot_h <= 200
      bw_ok: bar_w >= 1 and bar_w <= 6
    variant
      if plot_h > row then plot_h - row else 0 end
    do
      if row >= plot_h then
        s
      else
        let empty_rows = if plot_h >= bar_h then plot_h - bar_h else 0 end
        let y_row = top_y + row
        let s1 = if row >= empty_rows and y_row < 65535 then
          let cell_rect = RECT.make(x, y_row, bar_w, 1)
          if cell_rect.inside(clip) then
            s.fill(cell_rect, '█', st)
          else
            s.text(clip, x, y_row, "█", st)
          end
        else
          s
        end
        BAR_CHART.draw_one_bar(s1, clip, x, top_y, plot_h, bar_h, bar_w, st, row + 1)
      end
    ensure
      same_width: Result.width = s.width
      same_height: Result.height = s.height
    end

end
