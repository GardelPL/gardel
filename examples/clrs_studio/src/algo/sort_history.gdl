-- Pure time-travel execution trace for `INSERTION_SORT`.
-- Uses `INSERTION_SORT.work_left` as the proven termination variant to materialize
-- the entire execution from step 0 to `Done`, powering Step, Back, Reset, and Timeline Scrubbing.
module SORT_HISTORY

representation {NONE}
  steps: LIST[INSERTION_SORT]
  cursor: NAT
  init_work: NAT

create {ANY}

  from_initial(start: INSERTION_SORT): SORT_HISTORY
    do
      let trace = SORT_HISTORY.build_trace(start)
      let w0 = start.work_left
      { steps = trace, cursor = 0, init_work = w0 }
    ensure
      at_start: Result.step_index = 0
      non_empty: Result.step_count >= 1
    end

  build_trace(s: INSERTION_SORT): LIST[INSERTION_SORT]
    variant
      s.work_left
    do
      if s.is_done then
        LIST.empty.prepend(s)
      else
        SORT_HISTORY.build_trace(s.step).prepend(s)
      end
    ensure
      non_empty: Result.length >= 1
    end

feature {ANY}

  current: INSERTION_SORT
    do
      LIST_OPS.at(Current.steps, Current.cursor)
    end

  step_index: NAT
    do
      Current.cursor
    end

  step_count: NAT
    do
      Current.steps.length
    end

  last_step: NAT
    do
      Current.steps.length - 1
    end

  initial_work: NAT
    do
      Current.init_work
    end

  at_end: BOOL
    do
      Current.cursor >= Current.steps.length - 1
    end

  at_start: BOOL
    do
      Current.cursor = 0
    end

  step_forward: SORT_HISTORY
    do
      if Current.cursor < Current.steps.length - 1 and Current.cursor < 18446744073709551615 then
        { steps = Current.steps, cursor = Current.cursor + 1, init_work = Current.init_work }
      else
        Current
      end
    ensure
      same_trace: Result.step_count = Current.step_count
    end

  step_back: SORT_HISTORY
    do
      if Current.cursor > 0 then
        { steps = Current.steps, cursor = Current.cursor - 1, init_work = Current.init_work }
      else
        Current
      end
    ensure
      same_trace: Result.step_count = Current.step_count
    end

  jump_to(idx: NAT): SORT_HISTORY
    do
      let clamped = if idx < Current.steps.length then idx else Current.steps.length - 1 end
      { steps = Current.steps, cursor = clamped, init_work = Current.init_work }
    ensure
      same_trace: Result.step_count = Current.step_count
      bounded: Result.step_index < Result.step_count
    end

  reset: SORT_HISTORY
    do
      { steps = Current.steps, cursor = 0, init_work = Current.init_work }
    ensure
      at_zero: Result.step_index = 0
      same_trace: Result.step_count = Current.step_count
    end

invariant
  non_empty: steps.length >= 1
  cursor_in_bounds: cursor < steps.length

end
