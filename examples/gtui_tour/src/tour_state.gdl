-- The tour's state: which pane has the keys, the project's two trees under their tabs, the
-- source with its marked line, the output and the problems under theirs, the command palette,
-- and the screen's size, from which the panes' heights are found.
module TOUR_STATE

representation {NONE}
  wide: NAT
  high: NAT
  keys_at: FOCUS
  left_tabs: TABS
  module_tree: TREE_VIEW
  file_tree: TREE_VIEW
  source: TEXT_VIEW
  mark_line: OPTION[NAT]
  low_tabs: TABS
  issues: LIST_VIEW
  issue_lines: LIST[NAT]
  log: LIST[STRING]
  commands: PALETTE
  commands_open: BOOL
  help_modal: POPUP
  help_shown: BOOL
  bar_menu: MENU
  quit_dialog: DIALOG
  modified: BOOL
  child: STRING
  look: THEME

create {ANY}

  make_menu: MENU
    do
      let empty_items: LIST[MENU_ITEM] = LIST.empty
      let themes = empty_items
        .prepend(MENU_ITEM.item("Dracula", 23))
        .prepend(MENU_ITEM.item("Nord", 22))
        .prepend(MENU_ITEM.item("Light", 21))
        .prepend(MENU_ITEM.item("Dark", 20))
      let file_items = empty_items
        .prepend(MENU_ITEM.item("Quit", 12).with_shortcut("q"))
        .prepend(MENU_ITEM.separator)
        .prepend(MENU_ITEM.item("Open...", 11).with_shortcut("/"))
        .prepend(MENU_ITEM.item("New", 10).with_shortcut("Ctrl+N"))
      let view_items = empty_items
        .prepend(MENU_ITEM.item("Help", 24).with_shortcut("?"))
        .prepend(MENU_ITEM.separator)
        .prepend(MENU_ITEM.submenu("Theme", themes))
      let help_items = empty_items
        .prepend(MENU_ITEM.item("About", 31))
        .prepend(MENU_ITEM.item("Shortcuts", 30).with_shortcut("?"))
      let entries = empty_items
        .prepend(MENU_ITEM.submenu("Help", help_items))
        .prepend(MENU_ITEM.submenu("View", view_items))
        .prepend(MENU_ITEM.submenu("File", file_items))
      MENU.make(entries).with_border(BORDER_KIND.rounded)
    end

  make_quit_dialog: DIALOG
    do
      DIALOG.confirm("Unsaved Changes", "Discard modified buffer and quit?")
        .with_border(BORDER_KIND.rounded)
    end

  make_help: POPUP
    do
      let l1 = "Tab: move between panes | m/f/o/p: switch tabs\n"
      let l2 = "Arrows/Enter: browse tree & mark problem line\n"
      let l3 = "/: command palette | ?: toggle help | q: quit\n"
      let l4 = "Mouse: click pane to focus, click tabs/tree\n"
      let l5 = "Wheel scrolls tree, source, problems & help\n"
      let l6 = "Click outside modal or palette to dismiss"
      let text = GLYPHS.join(GLYPHS.join(l1, l2), GLYPHS.join(GLYPHS.join(l3, l4), GLYPHS.join(l5, l6)))
      POPUP.of_text("Help", text, 50, 7).with_footer("Esc/? to close").with_padding(PADDING.symmetric(0, 1))
    end

  -- The tour, with `program` as the program `/shell` runs attached, none when it is "".
  make(program: STRING): TOUR_STATE
    do
      { wide = 80, high = 24, keys_at = FOCUS.make(3),
        left_tabs = TABS.empty.with("Modules", 'm').with("Files", 'f'),
        module_tree = TREE_VIEW.make(TOUR_STATE.module_nodes),
        file_tree = TREE_VIEW.make(TOUR_STATE.file_nodes),
        source = TEXT_VIEW.make(TOUR_STATE.sample),
        mark_line = None,
        low_tabs = TABS.empty.with("Output", 'o').with("Problems (3)", 'p'),
        issues = LIST_VIEW.make(LIST.empty
          .prepend("tabs.gdl:32  within may fail in key_index")
          .prepend("tabs.gdl:29  overflow_add in key_index")
          .prepend("tabs.gdl:11  a_tab may fail in on_key")),
        issue_lines = LIST.empty.prepend(31).prepend(28).prepend(10),
        log = LIST.empty.prepend("Tab moves between panes; / opens the commands; q quits."),
        commands = PALETTE.make(TOUR_STATE.palette_entries),
        commands_open = False,
        help_modal = TOUR_STATE.make_help,
        help_shown = False,
        bar_menu = TOUR_STATE.make_menu,
        quit_dialog = TOUR_STATE.make_quit_dialog,
        modified = False,
        child = program,
        look = THEME.dark }
    end

  palette_entries: LIST[PALETTE_ENTRY]
    do
      LIST.empty
        .prepend(PALETTE_ENTRY.make("help", "show keyboard shortcuts"))
        .prepend(PALETTE_ENTRY.make("theme", "[NAME] dark, light, nord or dracula"))
        .prepend(PALETTE_ENTRY.make("top", "the source from its first line"))
        .prepend(PALETTE_ENTRY.make("shell", "[ARGS] run the program given to the tour, attached"))
        .prepend(PALETTE_ENTRY.make("quit", "leave the tour"))
        .prepend(PALETTE_ENTRY.make("clear", "empty the output"))
    end

  module_nodes: LIST[TREE_NODE]
    do
      LIST.empty
        .prepend(TREE_NODE.make("EVENT", 1))
        .prepend(TREE_NODE.make("KEY", 1))
        .prepend(TREE_NODE.make("prelude", 0))
        .prepend(TREE_NODE.make("TREE_VIEW", 2))
        .prepend(TREE_NODE.make("TABS", 2))
        .prepend(TREE_NODE.make("FRAME", 2))
        .prepend(TREE_NODE.make("widget", 1))
        .prepend(TREE_NODE.make("STYLE", 2))
        .prepend(TREE_NODE.make("SCREEN", 2))
        .prepend(TREE_NODE.make("COLOR", 2))
        .prepend(TREE_NODE.make("CELL", 2))
        .prepend(TREE_NODE.make("screen", 1))
        .prepend(TREE_NODE.make("gtui", 0).set_open(True))
    end

  file_nodes: LIST[TREE_NODE]
    do
      LIST.empty
        .prepend(TREE_NODE.make("tabs.gdl", 2))
        .prepend(TREE_NODE.make("frame.gdl", 2))
        .prepend(TREE_NODE.make("widget", 1))
        .prepend(TREE_NODE.make("color.gdl", 2))
        .prepend(TREE_NODE.make("screen", 1))
        .prepend(TREE_NODE.make("src", 0).set_open(True))
    end

  sample: LIST[STRING]
    do
      LIST.empty
        .prepend("end")
        .prepend("")
        .prepend("    end")
        .prepend("      within: Result <= keys.length")
        .prepend("    ensure")
        .prepend("      end end")
        .prepend("      else 1 + TABS.key_index(keys.tail, c)")
        .prepend("      else if keys.head = c then 0")
        .prepend("      if keys.length = 0 then 0")
        .prepend("    do")
        .prepend("      keys.length")
        .prepend("    variant")
        .prepend("  key_index(keys: LIST[CHAR], c: CHAR): NAT")
        .prepend("  -- The index of the first of `keys` that is `c`.")
        .prepend("")
        .prepend("    end")
        .prepend("      none: Result.count = 0")
        .prepend("    ensure")
        .prepend("      { names = LIST.empty, hot = LIST.empty, picked = 0 }")
        .prepend("    do")
        .prepend("  empty: TABS")
        .prepend("")
        .prepend("create {ANY}")
        .prepend("")
        .prepend("  a_tab: picked < names.length or (names.length = 0 and picked = 0)")
        .prepend("  one_key_each: hot.length = names.length")
        .prepend("invariant")
        .prepend("")
        .prepend("  picked: NAT")
        .prepend("  hot: LIST[CHAR]")
        .prepend("  names: LIST[STRING]")
        .prepend("representation {NONE}")
        .prepend("")
        .prepend("module TABS")
        .prepend("-- A row of titles, one of them chosen, each with a key that chooses it.")
    end

  -- Line `i` of `ns`, or 0 when there is none.
  nth(ns: LIST[NAT], i: NAT): NAT
    do
      if i < ns.length then LIST_OPS.at(ns, i) else 0 end
    end

feature {ANY}

  focus: FOCUS
    do
      Current.keys_at
    end

  project_tabs: TABS
    do
      Current.left_tabs
    end

  output_tabs: TABS
    do
      Current.low_tabs
    end

  -- The tree under the tab chosen on the left.
  tree: TREE_VIEW
    do
      if Current.left_tabs.selected = 0 then Current.module_tree else Current.file_tree end
    end

  text: TEXT_VIEW
    do
      Current.source
    end

  marked: OPTION[NAT]
    do
      Current.mark_line
    end

  problems: LIST_VIEW
    do
      Current.issues
    end

  output: LIST[STRING]
    do
      Current.log
    end

  palette: PALETTE
    do
      Current.commands
    end

  palette_open: BOOL
    do
      Current.commands_open
    end

  help_open: BOOL
    do
      Current.help_shown
    end

  help_popup: POPUP
    do
      Current.help_modal
    end

  top_menu: MENU
    do
      Current.bar_menu
    end

  dialog: DIALOG
    do
      Current.quit_dialog
    end

  dialog_open: BOOL
    do
      Current.quit_dialog.is_open
    end

  path_nodes: LIST[NAT]
    do
      let empty_ns: LIST[NAT] = LIST.empty
      let t = Current.tree
      if t.count = 0 then empty_ns else TOUR_STATE.ancestor_nodes(t, t.selected_row, empty_ns) end
    end

  breadcrumb: BREADCRUMB
    do
      BREADCRUMB.make(TOUR_STATE.labels_of(Current.tree, Current.path_nodes))
    end

  theme: THEME
    do
      Current.look
    end

  area: RECT
    do
      RECT.sized(Current.wide, Current.high)
    end

  -- The title of the source's frame: the node chosen in the tree, and the view.
  title: STRING
    do
      match Current.module_tree.selected
        case Some(r) then GLYPHS.join(TOUR_STATE.label_of(Current.module_tree, r.node), " Text")
        case None then "Text"
      end
    end

  -- Of a size `w` by `h`.
  sized(w: NAT, h: NAT): TOUR_STATE
    do
      { Current with wide = w, high = h }
    end

  -- `line` added to the output, the last 200 lines kept.
  logged(line: STRING): TOUR_STATE
    do
      { Current with log = LIST_CUT.take(Current.log.append(LIST.empty.prepend(line)), 200) }
    end

  request_quit: TUI_NEXT[TOUR_STATE]
    do
      if Current.modified then
        TUI_NEXT.next({ Current with quit_dialog = Current.quit_dialog.open })
      else
        TUI_NEXT.quit(0)
      end
    end

  apply_menu_choice(id: NAT): TUI_NEXT[TOUR_STATE]
    do
      if id = 10 then
        TUI_NEXT.next({ Current with modified = True }.logged("New buffer (modified)"))
      else if id = 11 then
        TUI_NEXT.next({ Current with commands = PALETTE.make(TOUR_STATE.palette_entries), commands_open = True })
      else if id = 12 then
        Current.request_quit
      else if id = 20 then
        TUI_NEXT.next({ Current with look = THEME.dark }.logged("Theme dark"))
      else if id = 21 then
        TUI_NEXT.next({ Current with look = THEME.light }.logged("Theme light"))
      else if id = 22 then
        TUI_NEXT.next({ Current with look = THEME.nord }.logged("Theme nord"))
      else if id = 23 then
        TUI_NEXT.next({ Current with look = THEME.dracula }.logged("Theme dracula"))
      else if id = 24 or id = 30 then
        TUI_NEXT.next({ Current with help_shown = True, help_modal = TOUR_STATE.make_help })
      else if id = 31 then
        TUI_NEXT.next(Current.logged("gtui 0.6.0 workbench tour"))
      else
        TUI_NEXT.next(Current)
      end end end end end end end end end
    end

  -- A key, when the palette is closed.
  browse(k: KEY): TUI_NEXT[TOUR_STATE]
    do
      if Current.quit_dialog.is_open then
        match k
          case KeysEnded then TUI_NEXT.quit(0)
          case _ then
            let next_dlg = Current.quit_dialog.on_key(k)
            match next_dlg.answer
              case Some(ans) then
                if ans = 0 then
                  TUI_NEXT.quit(0)
                else
                  TUI_NEXT.next({ Current with quit_dialog = next_dlg.clear_answer })
                end
              case None then TUI_NEXT.next({ Current with quit_dialog = next_dlg })
            end
        end
      else if Current.bar_menu.is_open then
        match k
          case KeysEnded then TUI_NEXT.quit(0)
          case _ then
            let next_m = Current.bar_menu.on_key(k)
            match next_m.chosen
              case Some(id) then { Current with bar_menu = next_m.clear_chosen }.apply_menu_choice(id)
              case None then TUI_NEXT.next({ Current with bar_menu = next_m })
            end
        end
      else if Current.help_shown then
        match k
          case Escape then TUI_NEXT.next({ Current with help_shown = False })
          case Enter then TUI_NEXT.next({ Current with help_shown = False })
          case KeysEnded then TUI_NEXT.quit(0)
          case Char(c) then
            if c = 'q' then Current.request_quit
            else if c = '?' then TUI_NEXT.next({ Current with help_shown = False })
            else TUI_NEXT.next(Current)
            end end
          case _ then TUI_NEXT.next({ Current with help_modal = Current.help_modal.on_key(k, Current.area) })
        end
      else
        match k
          case Function(n) then
            if n = 10 then
              TUI_NEXT.next({ Current with bar_menu = Current.bar_menu.open })
            else
              TUI_NEXT.next(Current.in_pane(k))
            end
          case Mod(inner, _, alt, ctrl) then
            if alt and not ctrl then
              TUI_NEXT.next({ Current with bar_menu = Current.bar_menu.on_key(k) })
            else
              TUI_NEXT.next(Current.in_pane(k))
            end
          case Ctrl(c) then
            if c = 'n' then
              TUI_NEXT.next({ Current with modified = True }.logged("New buffer (modified)"))
            else
              TUI_NEXT.next(Current.in_pane(k))
            end
          case Char(c) then
            if c = 'q' then Current.request_quit
            else if c = '/' then TUI_NEXT.next({ Current with commands = PALETTE.make(TOUR_STATE.palette_entries), commands_open = True })
            else if c = '?' then TUI_NEXT.next({ Current with help_shown = True, help_modal = TOUR_STATE.make_help })
            else TUI_NEXT.next(Current.in_pane(k))
            end end end
          case Tab then TUI_NEXT.next({ Current with keys_at = Current.keys_at.next })
          case KeysEnded then TUI_NEXT.quit(0)
          case _ then TUI_NEXT.next(Current.in_pane(k))
        end
      end end end
    end

  -- A key given to the pane that has the keys.
  in_pane(k: KEY): TOUR_STATE
    do
      let a = Current.area
      if Current.keys_at.current = 0 then
        let rows = TOUR_LAYOUT.rows_in(TOUR_LAYOUT.left(a))
        if Current.left_tabs.takes(k) then
          { Current with left_tabs = Current.left_tabs.on_key(k) }
        else if Current.left_tabs.selected = 0 then
          match k
            case Enter then { Current with module_tree = Current.module_tree.toggled(rows) }
            case _ then { Current with module_tree = Current.module_tree.on_key(k, rows) }
          end
        else
          match k
            case Enter then { Current with file_tree = Current.file_tree.toggled(rows) }
            case _ then { Current with file_tree = Current.file_tree.on_key(k, rows) }
          end
        end end
      else if Current.keys_at.current = 1 then
        { Current with source = Current.source.on_key(k, TOUR_LAYOUT.source_rows(a)) }
      else
        let rows = TOUR_LAYOUT.rows_in(TOUR_LAYOUT.bottom(a))
        if Current.low_tabs.takes(k) then
          { Current with low_tabs = Current.low_tabs.on_key(k) }
        else if Current.low_tabs.selected = 1 then
          match k
            case Enter then
              let line = TOUR_STATE.nth(Current.issue_lines, Current.issues.selected)
              let text_rows = TOUR_LAYOUT.source_rows(a)
              { Current with mark_line = Some(line), source = Current.source.showing(line, text_rows),
                keys_at = Current.keys_at.moved_to(1) }
            case _ then { Current with issues = Current.issues.on_key(k, rows) }
          end
        else
          Current
        end end
      end end
    end

  -- A key, when the palette is open: Escape closes it, Enter runs the command chosen, and
  -- the rest go to the palette.
  in_palette(k: KEY): TUI_NEXT[TOUR_STATE]
    do
      match k
        case Escape then TUI_NEXT.next({ Current with commands_open = False })
        case Enter then
          let closed = { Current with commands_open = False }
          match Current.commands.chosen
            case Some(e) then closed.run(e.name, Current.commands.arguments)
            case None then TUI_NEXT.next(closed.logged(GLYPHS.join("No command named ", Current.commands.command)))
          end
        case KeysEnded then TUI_NEXT.quit(0)
        case _ then
          let p = TOUR_LAYOUT.palette(Current.area, Current.commands)
          TUI_NEXT.next({ Current with commands = Current.commands.on_key(k, if p.height >= 3 then p.height - 3 else 0 end) })
      end
    end

  -- The command `name` run with `args`.
  run(name: STRING, args: STRING): TUI_NEXT[TOUR_STATE]
    do
      if name.equals("quit") then
        TUI_NEXT.quit(0)
      else if name.equals("clear") then
        TUI_NEXT.next({ Current with log = LIST.empty })
      else if name.equals("top") then
        TUI_NEXT.next({ Current with source = Current.source.scrolled_to(0, 1) })
      else if name.equals("theme") then
        let t = THEME.named(args)
        TUI_NEXT.next({ Current with look = t }.logged(GLYPHS.join("Theme ", t.name)))
      else if name.equals("help") then
        TUI_NEXT.next({ Current with help_shown = True, help_modal = TOUR_STATE.make_help })
      else if name.equals("shell") then
        if Current.child.is_empty then
          TUI_NEXT.next(Current.logged("No program was given to the tour to run."))
        else
          let argv: LIST[STRING] = if args.is_empty then LIST.empty else LIST.empty.prepend(args) end
          Next(Current.logged(GLYPHS.join("Running ", Current.child)), LIST.empty.prepend(RunAttached(1, Current.child, argv, "")))
        end
      else
        TUI_NEXT.next(Current.logged(GLYPHS.join("Unknown command ", name)))
      end end end end end end
    end

  -- A mouse event routed through overlays and panes using `TOUR_LAYOUT`.
  handle_mouse(m: MOUSE): TUI_NEXT[TOUR_STATE]
    do
      let area = Current.area
      let menu_r = TOUR_LAYOUT.menu_bar(area)
      if Current.quit_dialog.is_open then
        let next_dlg = Current.quit_dialog.on_mouse(m, area)
        match next_dlg.answer
          case Some(ans) then
            if ans = 0 then
              TUI_NEXT.quit(0)
            else
              TUI_NEXT.next({ Current with quit_dialog = next_dlg.clear_answer })
            end
          case None then TUI_NEXT.next({ Current with quit_dialog = next_dlg })
        end
      else if Current.bar_menu.is_open or (not Current.help_shown and not Current.commands_open and Current.bar_menu.contains(menu_r, area, m.x, m.y) and m.is_left_down) then
        let next_m = Current.bar_menu.on_mouse(m, menu_r, area)
        match next_m.chosen
          case Some(id) then { Current with bar_menu = next_m.clear_chosen }.apply_menu_choice(id)
          case None then TUI_NEXT.next({ Current with bar_menu = next_m })
        end
      else if Current.help_shown then
        if Current.help_modal.contains(area, m.x, m.y) then
          TUI_NEXT.next({ Current with help_modal = Current.help_modal.on_mouse(m, area) })
        else if m.is_left_down then
          TUI_NEXT.next({ Current with help_shown = False })
        else
          TUI_NEXT.next(Current)
        end end
      else if Current.commands_open then
        let pal_r = TOUR_LAYOUT.palette(area, Current.commands)
        if not pal_r.has(m.x, m.y) and m.is_left_down then
          TUI_NEXT.next({ Current with commands_open = False })
        else
          TUI_NEXT.next(Current)
        end
      else
        let left = TOUR_LAYOUT.left(area)
        let right = TOUR_LAYOUT.right(area)
        let bottom = TOUR_LAYOUT.bottom(area)
        if left.has(m.x, m.y) then
          let focused: TOUR_STATE = if m.is_left_down then { Current with keys_at = Current.keys_at.moved_to(0) } else Current end
          let title_r = FRAME.title_area(left)
          let inner = FRAME.inner(left)
          if title_r.has(m.x, m.y) then
            TUI_NEXT.next({ focused with left_tabs = focused.left_tabs.on_mouse(m, title_r) })
          else if inner.has(m.x, m.y) then
            if focused.left_tabs.selected = 0 then
              TUI_NEXT.next({ focused with module_tree = focused.module_tree.on_mouse(m, inner) })
            else
              TUI_NEXT.next({ focused with file_tree = focused.file_tree.on_mouse(m, inner) })
            end
          else
            TUI_NEXT.next(focused)
          end end
        else if right.has(m.x, m.y) then
          let focused: TOUR_STATE = if m.is_left_down then { Current with keys_at = Current.keys_at.moved_to(1) } else Current end
          let bc_r = TOUR_LAYOUT.breadcrumb_bar(area)
          let src_r = TOUR_LAYOUT.source_area(area)
          if bc_r.has(m.x, m.y) and m.is_left_down then
            match focused.breadcrumb.crumb_at(bc_r, m.x, m.y)
              case Some(ci) then
                let node_idx = TOUR_STATE.nth(focused.path_nodes, ci)
                let left_rows = TOUR_LAYOUT.rows_in(left)
                if focused.left_tabs.selected = 0 then
                  TUI_NEXT.next({ focused with module_tree = focused.module_tree.select_node(node_idx, left_rows) })
                else
                  TUI_NEXT.next({ focused with file_tree = focused.file_tree.select_node(node_idx, left_rows) })
                end
              case None then TUI_NEXT.next(focused)
            end
          else if src_r.has(m.x, m.y) then
            TUI_NEXT.next({ focused with source = focused.source.on_mouse(m, src_r) })
          else
            TUI_NEXT.next(focused)
          end end
        else if bottom.has(m.x, m.y) then
          let focused: TOUR_STATE = if m.is_left_down then { Current with keys_at = Current.keys_at.moved_to(2) } else Current end
          let title_r = FRAME.title_area(bottom)
          let inner = FRAME.inner(bottom)
          if title_r.has(m.x, m.y) then
            TUI_NEXT.next({ focused with low_tabs = focused.low_tabs.on_mouse(m, title_r) })
          else if inner.has(m.x, m.y) and focused.low_tabs.selected = 1 then
            let next_issues = focused.issues.on_mouse(m, inner)
            if m.is_left_down then
              let dy = m.y - inner.y
              let idx = if focused.issues.top <= 18446744073709551615 - dy then focused.issues.top + dy else 18446744073709551615 end
              if idx < focused.issues.count then
                let line = TOUR_STATE.nth(focused.issue_lines, next_issues.selected)
                let text_rows = TOUR_LAYOUT.source_rows(area)
                TUI_NEXT.next({ focused with issues = next_issues, mark_line = Some(line), source = focused.source.showing(line, text_rows) })
              else
                TUI_NEXT.next({ focused with issues = next_issues })
              end
            else
              TUI_NEXT.next({ focused with issues = next_issues })
            end
          else
            TUI_NEXT.next(focused)
          end end
        else
          TUI_NEXT.next(Current)
        end end end
      end end end end
    end

create {ANY}

  -- The label of node `i` of the tree `t`, or "".
  label_of(t: TREE_VIEW, i: NAT): STRING
    do
      if i < t.nodes.length then LIST_OPS.at(t.nodes, i).label else "" end
    end

  -- Labels of nodes `ns` in tree `t`.
  labels_of(t: TREE_VIEW, ns: LIST[NAT]): LIST[STRING]
    variant
      ns.length
    do
      if ns.length = 0 then
        let empty_s: LIST[STRING] = LIST.empty
        empty_s
      else
        TOUR_STATE.labels_of(t, ns.tail).prepend(TOUR_STATE.label_of(t, ns.head))
      end
    end

  -- Node indices from root down to `row_idx` in `t`, accumulated into `acc`.
  ancestor_nodes(t: TREE_VIEW, row_idx: NAT, acc: LIST[NAT]): LIST[NAT]
    variant
      row_idx
    do
      let rows = t.shown_rows
      if row_idx >= rows.length then
        acc
      else
        let r = LIST_OPS.at(rows, row_idx)
        let next_acc = acc.prepend(r.node)
        let p = TREE_VIEW.parent_of(rows, 0, row_idx, r.depth, row_idx)
        if p < row_idx then
          TOUR_STATE.ancestor_nodes(t, p, next_acc)
        else
          next_acc
        end
      end
    end

end
