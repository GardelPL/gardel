-- Contable: Verified Double-Entry Ledger & Live Budget Studio on `gtui` 0.6.0.
--
--   gardelc --project examples/contable --strict
--   ./build/contable_bin
reactive program CONTABLE

feature {ANY}

  update(s: CONTABLE_STATE, e: EVENT): TUI_NEXT[CONTABLE_STATE]
    do
      match e
        case Resized(w, h) then TUI_NEXT.next(s.sized(w, h))
        case Key(k) then s.handle_key(k)
        case Mouse(m) then s.handle_mouse(m)
        case _ then TUI_NEXT.next(s)
      end
    end

  edge(s: CONTABLE_STATE, pane: NAT): STYLE
    do
      if s.focus.has(pane) then s.theme.focused_border else s.theme.border end
    end

  draw_post_modal(s: SCREEN, st: CONTABLE_STATE, area: RECT, t: THEME): SCREEN
    do
      let box = area.centered(68, 9)
      let s0 = CLEAR.draw(s, box, t.base)
      let s1 = FRAME.draw_titled(
        s0, box, BORDER_KIND.rounded,
        "Post Balanced Entry (DR = CR)", "", "Enter:post  Esc:cancel",
        t.focused_border, t.active_tab
      )
      let inn = FRAME.inner_padded(box, PADDING.symmetric(0, 1))
      let s2 = s1.text(inn, inn.x, inn.y, "Format: <debit#> <credit#> <amount> [memo]", t.base)
      let s3 = s2.text(inn, inn.x, inn.y + 1, "Example: 6 0 75.00 Domain Renewal  (see # column in Accounts)", t.gutter)
      let input_r = inn.drop_top(3).take_top(1)
      let s4 = st.post_line.draw(s3, input_r, "> ", t.base, t.selection)
      let s5 = s4.text(inn, inn.x, inn.y + 5, "✓ Statically verified: DR = CR, bounds & overflow-free I64", STYLE.plain.fg(COLOR.green))
      if st.post_error.is_empty then
        s5
      else
        s5.text(inn, inn.x, inn.y + 6, st.post_error, STYLE.plain.fg(COLOR.red).bold)
      end
    ensure
      same_width: Result.width = s.width
      same_height: Result.height = s.height
    end

  view(s: CONTABLE_STATE, blank: SCREEN): SCREEN
    do
      let t = s.theme
      let area = blank.area
      let kind = BORDER_KIND.rounded
      let l = s.ledger

      -- 1. Breadcrumb row + live compile-time Trial Balance proof badge.
      let s0 = s.breadcrumb.draw(blank, CONTABLE_LAYOUT.crumb_left(area), t.gutter, t.active_tab, t.selection, t.border)
      let badge_r = CONTABLE_LAYOUT.proof_badge_area(area)
      let s1 = s0.text(badge_r, badge_r.x, badge_r.y, "✓ Trial Balance = $0.00 [PROVEN]", STYLE.plain.fg(COLOR.green).bold)

      -- 2. Main panes: Accounts (top-left), Immutable Journal (bottom-left), Tabbed Right Pane.
      let acct_r = CONTABLE_LAYOUT.accounts_pane(area)
      let jour_r = CONTABLE_LAYOUT.journal_pane(area)
      let right_r = CONTABLE_LAYOUT.right_pane(area)
      let acct_meta = GLYPHS.join(NUMBER_TEXT.nat_to_text(l.account_count), " accounts")
      let jour_meta = GLYPHS.join(NUMBER_TEXT.nat_to_text(l.entry_count), " entries")
      let s2 = FRAME.draw_titled(s1, acct_r, kind, "Chart of Accounts", acct_meta, "", edge(s, 0), t.active_tab)
      let s3 = FRAME.draw_titled(s2, jour_r, kind, "Journal (Immutable Audit Trail)", jour_meta, "", edge(s, 1), t.active_tab)
      let s4 = FRAME.draw_titled(s3, right_r, kind, "", "", "", edge(s, 2), t.active_tab)
      let s5 = FRAME.merge_borders(s4, CONTABLE_LAYOUT.main_area(area))
      let s6 = s.tabs.draw(s5, CONTABLE_LAYOUT.right_tabs_area(area), t.base, t.active_tab)

      -- 3. Left tables: Accounts & Journal.
      let a_in = CONTABLE_LAYOUT.accounts_inner(area)
      let a_tbl = CONTABLE_PANELS.accounts_table(l, s.selected_account, a_in.height)
      let a_sel_st = if s.focus.has(0) then t.selection else t.base end
      let s7 = a_tbl.draw(s6, a_in, t.base, t.active_tab, a_sel_st)

      let j_in = CONTABLE_LAYOUT.journal_inner(area)
      let j_tbl = CONTABLE_PANELS.journal_table(l, s.selected_journal, j_in.height)
      let j_sel_st = if s.focus.has(1) then t.selection else t.selection end
      let s8 = j_tbl.draw(s7, j_in, t.base, t.active_tab, j_sel_st)

      -- 4. Right pane content: Budgets (0) / Entry Detail (1) / Contracts (2).
      let s9 =
        if s.tabs.selected = 0 then
          CONTABLE_PANELS.draw_budgets_tab(s8, area, s.history, t)
        else if s.tabs.selected = 1 then
          CONTABLE_PANELS.draw_entry_tab(s8, area, l, s.selected_journal, t)
        else
          CONTABLE_PANELS.draw_contracts_tab(s8, area, s.contracts, t)
        end end

      -- 5. Action & History Scrubber bar.
      let act_r = CONTABLE_LAYOUT.action_bar(area)
      let hist_meta = GLYPHS.join(
        GLYPHS.join("Snapshot ", NUMBER_TEXT.nat_to_text(s.history.step_index)),
        GLYPHS.join("/", NUMBER_TEXT.nat_to_text(s.history.last_step))
      )
      let s10 = FRAME.draw_titled(s9, act_r, kind, "Actions & Time-Travel", hist_meta, "", t.border, t.active_tab)
      let s11 = BUTTON.make("+ New Entry").draw(s10, CONTABLE_LAYOUT.btn_new_area(area), t.active_tab, False, False)
      let s12 = BUTTON.make("↺ Reverse").draw(s11, CONTABLE_LAYOUT.btn_rev_area(area), t.base, False, False)
      let s13 = BUTTON.make("◀ Back").draw(s12, CONTABLE_LAYOUT.btn_back_area(area), t.base, False, False)
      let s14 = BUTTON.make("Next ▶").draw(s13, CONTABLE_LAYOUT.btn_next_area(area), t.base, False, False)
      let s15 = s.timeline.draw(s14, CONTABLE_LAYOUT.history_slider_area(area), t.gutter, t.string, t.active_tab)

      -- 6. Status bar.
      let left_st = GLYPHS.join("Contable · ", l.book_name)
      let right_st = "n:new r:reverse ←/→:history ↑/↓:select b/e/c:tabs 1-3:book t:theme ?:help q:quit"
      let s16 = STATUS_BAR.draw(s15, CONTABLE_LAYOUT.status_bar(area), left_st, right_st, t.selection)

      -- 7. Overlays (rendered last): TOASTs, Help POPUP, Post Entry modal, Reverse/Quit DIALOGs, top MENU.
      let s17 = s.toasts.with_border(kind).draw(s16, area, t.base, t.focused_border, t.string, t.active_tab, t.keyword)
      let s18 = if s.help_open then s.help_popup.draw(s17, area, t.base, t.focused_border, t.active_tab) else s17 end
      let s19 = if s.post_modal_open then draw_post_modal(s18, s, area, t) else s18 end
      let s20 = if s.rev_dlg.is_open then s.rev_dlg.draw(s19, area, t.base, t.focused_border, t.active_tab, t.base, t.selection) else s19 end
      let s21 = if s.quit_dlg.is_open then s.quit_dlg.draw(s20, area, t.base, t.focused_border, t.active_tab, t.base, t.selection) else s20 end
      s.top_menu.draw(s21, CONTABLE_LAYOUT.menu_bar(area), t.base, t.base, t.selection, t.gutter)
    end

  init(args: SEQ[STRING]): STEP[TUI[CONTABLE_STATE]]
    do
      TUI.start(CONTABLE_STATE.make, update, view)
    end

  step(t: TUI[CONTABLE_STATE], e: EVENT): STEP[TUI[CONTABLE_STATE]]
    do
      t.step(e)
    end

end
