-- Pre-verified starter books for `contable` (Freelance Studio, Personal Budget, Small Cafe).
-- Each preset constructs a full `LEDGER_HISTORY` through real `post_entry` and `reverse_entry`
-- calls so every historical snapshot is statically verified by Boogie/Z3.
functions LEDGER_PRESETS

feature {ANY}

  preset_name(idx: NAT): STRING
    do
      if idx = 0 then "Freelance Studio"
      else if idx = 1 then "Personal Monthly Budget"
      else "Small Cafe"
      end end
    end

  -- Helper: safely post an entry to a history if applicable, otherwise leave unchanged.
  push_entry(h: LEDGER_HISTORY, e: JOURNAL_ENTRY): LEDGER_HISTORY
    do
      let cur = h.latest
      if cur.can_post(e) then h.push(cur.post_entry(e)) else h end
    end

  -- Helper: safely reverse entry `rev_idx` (0 = newest) on the latest snapshot.
  push_reversal(h: LEDGER_HISTORY, rev_idx: NAT, date: STRING): LEDGER_HISTORY
    do
      let cur = h.latest
      if rev_idx < cur.entry_count and cur.can_reverse(rev_idx) then
        h.push(cur.reverse_entry(rev_idx, date))
      else
        h
      end
    end

  -- Step-by-step zero-balance list builder so Boogie proves `all_zero_balances` in O(1) fuel.
  add_zero_acct(accts: LIST[ACCOUNT], a: ACCOUNT): LIST[ACCOUNT]
    require
      prev_zero: LEDGER_FACTS.all_zero_balances(accts)
      a_zero: a.balance_cents = 0
    do
      accts.prepend(a)
    ensure
      still_zero: LEDGER_FACTS.all_zero_balances(Result)
      len_inc: Result.length = accts.length + 1
    end

  -- Preset 0: Freelance Studio (8 accounts, 7 entries incl. 3-leg split invoice & a reversal).
  freelance_studio: LEDGER_HISTORY
    do
      let a0: LIST[ACCOUNT] = LIST.empty
      let a1 = LEDGER_PRESETS.add_zero_acct(a0, ACCOUNT.make(7, "Meals & Travel", ACCOUNT.kind_expense, 40000))
      let a2 = LEDGER_PRESETS.add_zero_acct(a1, ACCOUNT.make(6, "Cloud & Tools", ACCOUNT.kind_expense, 30000))
      let a3 = LEDGER_PRESETS.add_zero_acct(a2, ACCOUNT.make(5, "Rent & Ops", ACCOUNT.kind_expense, 150000))
      let a4 = LEDGER_PRESETS.add_zero_acct(a3, ACCOUNT.make(4, "Client Revenue", ACCOUNT.kind_income, 0))
      let a5 = LEDGER_PRESETS.add_zero_acct(a4, ACCOUNT.make(3, "Owner Equity", ACCOUNT.kind_equity, 0))
      let a6 = LEDGER_PRESETS.add_zero_acct(a5, ACCOUNT.make(2, "Credit Card", ACCOUNT.kind_liability, 0))
      let a7 = LEDGER_PRESETS.add_zero_acct(a6, ACCOUNT.make(1, "Tax Reserve", ACCOUNT.kind_asset, 0))
      let accts = LEDGER_PRESETS.add_zero_acct(a7, ACCOUNT.make(0, "Checking", ACCOUNT.kind_asset, 0))
      let base = LEDGER.make("Freelance Studio", accts)
      let h0 = LEDGER_HISTORY.from_initial(base)
      let e1 = JOURNAL_ENTRY.make_transfer(1, "2026-11-01", "Owner Seed Capital", 0, 3, 500000)
      let h1 = LEDGER_PRESETS.push_entry(h0, e1)
      let e2 = JOURNAL_ENTRY.make_split_debit2_credit1(
        2, "2026-11-04", "Invoice #101 (Split 75/25 Tax)",
        0, 240000,
        1, 80000,
        4, 320000
      )
      let h2 = LEDGER_PRESETS.push_entry(h1, e2)
      let e3 = JOURNAL_ENTRY.make_transfer(3, "2026-11-05", "Studio Office Rent", 5, 0, 115000)
      let h3 = LEDGER_PRESETS.push_entry(h2, e3)
      let e4 = JOURNAL_ENTRY.make_transfer(4, "2026-11-09", "Cloud Hosting & CI", 6, 2, 18500)
      let h4 = LEDGER_PRESETS.push_entry(h3, e4)
      let e5 = JOURNAL_ENTRY.make_transfer(5, "2026-11-11", "Duplicate SaaS Charge", 6, 2, 4900)
      let h5 = LEDGER_PRESETS.push_entry(h4, e5)
      let h6 = LEDGER_PRESETS.push_reversal(h5, 0, "2026-11-12")
      let e7 = JOURNAL_ENTRY.make_transfer(7, "2026-11-15", "Client Lunch & Transit", 7, 2, 14250)
      let h7 = LEDGER_PRESETS.push_entry(h6, e7)
      let e8 = JOURNAL_ENTRY.make_split_debit2_credit1(
        8, "2026-11-20", "Invoice #102 (Split 75/25 Tax)",
        0, 187500,
        1, 62500,
        4, 250000
      )
      LEDGER_PRESETS.push_entry(h7, e8)
    end

  -- Preset 1: Personal Monthly Budget (8 accounts, split paycheck + household budgets).
  personal_budget: LEDGER_HISTORY
    do
      let a0: LIST[ACCOUNT] = LIST.empty
      let a1 = LEDGER_PRESETS.add_zero_acct(a0, ACCOUNT.make(7, "Dining & Coffee", ACCOUNT.kind_expense, 25000))
      let a2 = LEDGER_PRESETS.add_zero_acct(a1, ACCOUNT.make(6, "Groceries", ACCOUNT.kind_expense, 65000))
      let a3 = LEDGER_PRESETS.add_zero_acct(a2, ACCOUNT.make(5, "Housing", ACCOUNT.kind_expense, 180000))
      let a4 = LEDGER_PRESETS.add_zero_acct(a3, ACCOUNT.make(4, "Salary Income", ACCOUNT.kind_income, 0))
      let a5 = LEDGER_PRESETS.add_zero_acct(a4, ACCOUNT.make(3, "Opening Equity", ACCOUNT.kind_equity, 0))
      let a6 = LEDGER_PRESETS.add_zero_acct(a5, ACCOUNT.make(2, "Visa Card", ACCOUNT.kind_liability, 0))
      let a7 = LEDGER_PRESETS.add_zero_acct(a6, ACCOUNT.make(1, "Emergency Fund", ACCOUNT.kind_asset, 0))
      let accts = LEDGER_PRESETS.add_zero_acct(a7, ACCOUNT.make(0, "Checking", ACCOUNT.kind_asset, 0))
      let base = LEDGER.make("Personal Monthly Budget", accts)
      let h0 = LEDGER_HISTORY.from_initial(base)
      let e1 = JOURNAL_ENTRY.make_transfer(1, "2026-11-01", "Opening Checking Balance", 0, 3, 220000)
      let h1 = LEDGER_PRESETS.push_entry(h0, e1)
      let e2 = JOURNAL_ENTRY.make_split_debit2_credit1(
        2, "2026-11-03", "Paycheck (Checking + Savings)",
        0, 340000,
        1, 80000,
        4, 420000
      )
      let h2 = LEDGER_PRESETS.push_entry(h1, e2)
      let e3 = JOURNAL_ENTRY.make_transfer(3, "2026-11-04", "Monthly Apartment Rent", 5, 0, 155000)
      let h3 = LEDGER_PRESETS.push_entry(h2, e3)
      let e4 = JOURNAL_ENTRY.make_transfer(4, "2026-11-08", "Weekly Market Run", 6, 2, 18450)
      let h4 = LEDGER_PRESETS.push_entry(h3, e4)
      let e5 = JOURNAL_ENTRY.make_transfer(5, "2026-11-12", "Neighborhood Bistro", 7, 2, 9200)
      let h5 = LEDGER_PRESETS.push_entry(h4, e5)
      let e6 = JOURNAL_ENTRY.make_transfer(6, "2026-11-16", "Groceries & Produce", 6, 2, 21500)
      let h6 = LEDGER_PRESETS.push_entry(h5, e6)
      let e7 = JOURNAL_ENTRY.make_transfer(7, "2026-11-19", "Visa Partial Payment", 2, 0, 25000)
      LEDGER_PRESETS.push_entry(h6, e7)
    end

  -- Preset 2: Small Cafe (7 accounts, daily espresso sales + suppliers + payroll).
  small_cafe: LEDGER_HISTORY
    do
      let a0: LIST[ACCOUNT] = LIST.empty
      let a1 = LEDGER_PRESETS.add_zero_acct(a0, ACCOUNT.make(6, "Store Rent", ACCOUNT.kind_expense, 200000))
      let a2 = LEDGER_PRESETS.add_zero_acct(a1, ACCOUNT.make(5, "Beans & Milk", ACCOUNT.kind_expense, 90000))
      let a3 = LEDGER_PRESETS.add_zero_acct(a2, ACCOUNT.make(4, "Espresso Sales", ACCOUNT.kind_income, 0))
      let a4 = LEDGER_PRESETS.add_zero_acct(a3, ACCOUNT.make(3, "Owner Equity", ACCOUNT.kind_equity, 0))
      let a5 = LEDGER_PRESETS.add_zero_acct(a4, ACCOUNT.make(2, "Equipment Loan", ACCOUNT.kind_liability, 0))
      let a6 = LEDGER_PRESETS.add_zero_acct(a5, ACCOUNT.make(1, "Business Bank", ACCOUNT.kind_asset, 0))
      let accts = LEDGER_PRESETS.add_zero_acct(a6, ACCOUNT.make(0, "Cash Register", ACCOUNT.kind_asset, 0))
      let base = LEDGER.make("Small Cafe", accts)
      let h0 = LEDGER_HISTORY.from_initial(base)
      let e1 = JOURNAL_ENTRY.make_transfer(1, "2026-11-01", "Initial Store Capital", 1, 3, 850000)
      let h1 = LEDGER_PRESETS.push_entry(h0, e1)
      let e2 = JOURNAL_ENTRY.make_transfer(2, "2026-11-02", "Opening Cash Float", 0, 1, 45000)
      let h2 = LEDGER_PRESETS.push_entry(h1, e2)
      let e3 = JOURNAL_ENTRY.make_split_debit2_credit1(
        3, "2026-11-06", "Week 1 Sales (Cash + Card)",
        0, 62000,
        1, 148000,
        4, 210000
      )
      let h3 = LEDGER_PRESETS.push_entry(h2, e3)
      let e4 = JOURNAL_ENTRY.make_transfer(4, "2026-11-08", "Roaster & Dairy Delivery", 5, 1, 46500)
      let h4 = LEDGER_PRESETS.push_entry(h3, e4)
      let e5 = JOURNAL_ENTRY.make_transfer(5, "2026-11-10", "Monthly Store Lease", 6, 1, 180000)
      let h5 = LEDGER_PRESETS.push_entry(h4, e5)
      let e6 = JOURNAL_ENTRY.make_split_debit2_credit1(
        6, "2026-11-14", "Week 2 Sales (Cash + Card)",
        0, 74000,
        1, 176000,
        4, 250000
      )
      LEDGER_PRESETS.push_entry(h5, e6)
    end

  make_preset(idx: NAT): LEDGER_HISTORY
    do
      if idx = 0 then LEDGER_PRESETS.freelance_studio
      else if idx = 1 then LEDGER_PRESETS.personal_budget
      else LEDGER_PRESETS.small_cafe
      end end
    end

end
