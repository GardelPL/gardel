-- A small REST service built on the `grest` package.
--
--   gardelc examples/hello_api --strict
--
-- It is its routes and handlers: `REST_SERVER` holds the connections, and proves that each
-- request is answered once and its connection closed after the answer. Its handlers do not
-- look at the service's state, so the state is a `NAT` that stays `0`; see `todo_api` for a
-- service with a state.
reactive program HELLO_API

feature {ANY}

  root(r: REST_REQUEST): HTTP_RESPONSE
    do
      REST_RESPONSE.ok_text("OK")
    end

  hello(r: REST_REQUEST): HTTP_RESPONSE
    do
      REST_RESPONSE.ok_text("hello from a package")
    end

  -- `{"hello":"<name>"}`.
  greet(r: REST_REQUEST): HTTP_RESPONSE
    do
      match r.param("name")
        case None then
          REST_RESPONSE.not_found
        case Some(name) then
          match JSON.empty_object.with_field("hello", JSON.string(name))
            case Some(v) then REST_RESPONSE.ok_json(v)
            case None then REST_RESPONSE.bad_request("the name is too long")
          end
      end
    end

  -- The body it was sent, as text.
  echo(r: REST_REQUEST): HTTP_RESPONSE
    do
      match STRING.from_utf8(r.body)
        case Error(_) then REST_RESPONSE.error(HTTP_STATUS.bad_request, "the body is not UTF-8")
        case Ok(text) then REST_RESPONSE.ok_text(text)
      end
    end

  routes: REST_ROUTER[NAT]
    do
      REST_ROUTER.empty
        .on_get("/", root)
        .on_get("/hello", hello)
        .on_get("/hello/:name", greet)
        .on_post("/echo", echo)
    ensure
      four: Result.route_count = 4
    end

  init(args: SEQ[STRING]): STEP[REST_SERVER[NAT]]
    do
      REST_SERVER.start(args, 8090, routes, 0)
    end

  step(s: REST_SERVER[NAT], e: EVENT): STEP[REST_SERVER[NAT]]
    do
      s.serve(e)
    end

end
