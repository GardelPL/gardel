-- State of `gtui_dashboard`: selectable verification module table, live gauges and sparkline,
-- paragraph inspector with wrap/alignment controls, border-style & theme cycling, and help popup.
module DASH_STATE

representation {NONE}
  wide: NAT
  high: NAT
  keys_at: FOCUS
  view_tabs: TABS
  mod_table: TABLE
  history: LIST[NAT]
  tick_count: NAT
  theme_idx: NAT
  border_idx: NAT
  wrap_idx: NAT
  align_idx: NAT
  detail_para: PARAGRAPH
  help_modal: POPUP
  help_shown: BOOL

create {ANY}

  make_tabs: TABS
    do
      TABS.empty.with("Overview", '1').with("Tasks", '2').with("Events", '3').with("Unicode", '4')
    end

  make_help(kind: BORDER_KIND): POPUP
    do
      let l1 = "Up/Down/PgUp/PgDn/Home/End: select module\n"
      let l2 = "Space: record solver sample | Tab: focus\n"
      let l3 = "t: theme | b: border | w: wrap | a: align\n"
      let l4 = "1-4: switch tabs | ?: toggle help | q: quit\n"
      let l5 = "Mouse: click tabs to switch dashboard view\n"
      let l6 = "Click table rows or drag scrollbar to jump\n"
      let l7 = "Wheel scrolls table, inspector & help modal\n"
      let l8 = "Click outside modal to dismiss"
      let p1 = GLYPHS.join(GLYPHS.join(l1, l2), GLYPHS.join(l3, l4))
      let p2 = GLYPHS.join(GLYPHS.join(l5, l6), GLYPHS.join(l7, l8))
      POPUP.of_text("Dashboard Controls", GLYPHS.join(p1, p2), 54, 8)
        .with_border(kind)
        .with_padding(PADDING.symmetric(0, 1))
        .with_footer("Esc/? to close")
    end

  make: DASH_STATE
    do
      let widths: LIST[SIZE] = LIST.empty
        .prepend(SIZE.fixed(6))
        .prepend(SIZE.fixed(6))
        .prepend(SIZE.fixed(5))
        .prepend(SIZE.flex(1))
      let hdr = DASH_STATE.row4("Module", "VCs", "Time", "State")
      let rows: LIST[LIST[STRING]] = LIST.empty
        .prepend(DASH_STATE.row4("CHAR_WIDTH", "12", "18ms", "👩‍💻16"))
        .prepend(DASH_STATE.row4("SPARKLINE", "14", "24ms", "🏳️‍🌈OK"))
        .prepend(DASH_STATE.row4("SCROLLBAR", "16", "21ms", "🇺🇸OK"))
        .prepend(DASH_STATE.row4("TABLE", "22", "35ms", "🪉OK"))
        .prepend(DASH_STATE.row4("POPUP", "15", "19ms", "✓OK"))
        .prepend(DASH_STATE.row4("PARAGRAPH", "28", "42ms", "✓OK"))
        .prepend(DASH_STATE.row4("FRAME", "31", "38ms", "✓OK"))
        .prepend(DASH_STATE.row4("LAYOUT", "44", "51ms", "✓OK"))
      let hist: LIST[NAT] = LIST.empty
        .prepend(7).prepend(5).prepend(8).prepend(6)
        .prepend(4).prepend(7).prepend(3).prepend(6)
        .prepend(5).prepend(2).prepend(4).prepend(1)
      let para = PARAGRAPH.of_text(DASH_STATE.detail_for(0, 0)).with_wrap(WRAP_MODE.wrap_word).with_align(ALIGN.left)
      { wide = 80, high = 24, keys_at = FOCUS.make(2),
        view_tabs = DASH_STATE.make_tabs,
        mod_table = TABLE.with_headers(widths, hdr, rows),
        history = hist, tick_count = 0,
        theme_idx = 0, border_idx = 0, wrap_idx = 0, align_idx = 0,
        detail_para = para,
        help_modal = DASH_STATE.make_help(BORDER_KIND.rounded),
        help_shown = False }
    end

  row4(a: STRING, b: STRING, c: STRING, d: STRING): LIST[STRING]
    do
      let none: LIST[STRING] = LIST.empty
      none.prepend(d).prepend(c).prepend(b).prepend(a)
    end

  tab_note(tab_idx: NAT): STRING
    do
      if tab_idx = 0 then "View: Overview — live verification summary"
      else if tab_idx = 1 then "View: Tasks — interactive verification queue"
      else if tab_idx = 2 then "View: Events — SGR 1006 mouse & key stream"
      else "View: Unicode — Unicode 16.0 & UAX #29 clusters"
      end end end
    end

  detail_for(sel: NAT, tab_idx: NAT): STRING
    do
      let lead =
        if sel = 0 then
          GLYPHS.join("LAYOUT (GT.3): SIZE.min, SIZE.max, SIZE.percent, ", "columns_with_gap, rows_with_gap, and JUSTIFY.")
        else if sel = 1 then
          GLYPHS.join("FRAME (GT.4): Rounded, Plain, Double, and Thick ", "BORDER_KIND, PADDING, multi-titles, and merge_borders.")
        else if sel = 2 then
          GLYPHS.join("PARAGRAPH (GT.5): Word/char wrap and Left/Center/", "Right ALIGN measured by terminal display width.")
        else if sel = 3 then
          GLYPHS.join("POPUP & CLEAR (GT.6): Centered modal overlays via ", "RECT.centered, CLEAR blanking, and framed body.")
        else if sel = 4 then
          GLYPHS.join("TABLE (GT.7): Multi-column grid using LAYOUT ", "constraints, optional header row, and scrolling.")
        else if sel = 5 then
          GLYPHS.join("SCROLLBAR (GT.7): Vertical and horizontal track ", "and proportional thumb indicators.")
        else if sel = 6 then
          GLYPHS.join("SPARKLINE (GT.7): 8-level vertical block trend ", "chart with automatic or explicit ceiling.")
        else
          let p1 = GLYPHS.join("CHAR_WIDTH (GT.8): Unicode 16.0 ", "\u{1FA89}\u{1FAC6}\u{1FAE9}")
          let p2 = GLYPHS.join(" + UAX #29 ZWJ ", "\u{1F469}\u{200D}\u{1F4BB}\u{1F3F3}\u{FE0F}\u{200D}\u{1F308}")
          let p3 = GLYPHS.join(", tone \u{1F44D}\u{1F3FD}", ", flag \u{1F1FA}\u{1F1F8}.")
          GLYPHS.join(GLYPHS.join(p1, p2), p3)
        end end end end end end end
      let l2 = GLYPHS.join("\n", DASH_STATE.tab_note(tab_idx))
      let l3 = "\nContracts: verified statically under --strict with Z3."
      let l4 = "\nLayout: shared pure DASH_LAYOUT powers view & hit-testing."
      let l5 = "\nScrollbar: click or drag right track edge to jump rows."
      let l6 = "\nMouse tip: wheel here scrolls detail notes."
      GLYPHS.join(GLYPHS.join(lead, l2), GLYPHS.join(GLYPHS.join(l3, l4), GLYPHS.join(l5, l6)))
    end

feature {ANY}

  area: RECT
    do
      RECT.sized(Current.wide, Current.high)
    end

  focus: FOCUS
    do
      Current.keys_at
    end

  table: TABLE
    do
      Current.mod_table
    end

  samples: LIST[NAT]
    do
      Current.history
    end

  ticks: NAT
    do
      Current.tick_count
    end

  help_open: BOOL
    do
      Current.help_shown
    end

  theme: THEME
    do
      if Current.theme_idx = 0 then THEME.dark
      else if Current.theme_idx = 1 then THEME.nord
      else if Current.theme_idx = 2 then THEME.dracula
      else THEME.light
      end end end
    end

  border_kind: BORDER_KIND
    do
      if Current.border_idx = 0 then BORDER_KIND.rounded
      else if Current.border_idx = 1 then BORDER_KIND.plain
      else if Current.border_idx = 2 then BORDER_KIND.double
      else BORDER_KIND.thick
      end end end
    end

  border_name: STRING
    do
      if Current.border_idx = 0 then "rounded"
      else if Current.border_idx = 1 then "plain"
      else if Current.border_idx = 2 then "double"
      else "thick"
      end end end
    end

  wrap_mode: WRAP_MODE
    do
      if Current.wrap_idx = 0 then WRAP_MODE.wrap_word
      else if Current.wrap_idx = 1 then WRAP_MODE.wrap_char
      else WRAP_MODE.no_wrap
      end end
    end

  wrap_name: STRING
    do
      if Current.wrap_idx = 0 then "word"
      else if Current.wrap_idx = 1 then "char"
      else "none"
      end end
    end

  align_mode: ALIGN
    do
      if Current.align_idx = 0 then ALIGN.left
      else if Current.align_idx = 1 then ALIGN.center
      else ALIGN.right
      end end
    end

  align_name: STRING
    do
      if Current.align_idx = 0 then "left"
      else if Current.align_idx = 1 then "center"
      else "right"
      end end
    end

  -- Coverage gauge derived from the currently selected row (`1..8` out of `8`).
  coverage_gauge: GAUGE
    do
      let done = if Current.mod_table.selected < 8 then Current.mod_table.selected + 1 else 8 end
      GAUGE.ratio(done, 8).with_label(GLYPHS.join(NUMBER_TEXT.nat_to_text(done), "/8 modules"))
    end

  -- Verification cache hit rate gauge (`0..100%`).
  cache_gauge: GAUGE
    do
      let pct = 75 + (Current.tick_count % 25)
      GAUGE.percent(pct)
    end

  sparkline: SPARKLINE
    do
      SPARKLINE.make(Current.history).with_max(8)
    end

  tabs: TABS
    do
      Current.view_tabs
    end

  scrollbar: SCROLLBAR
    do
      let vis = DASH_LAYOUT.table_rows(Current.area)
      SCROLLBAR.vertical(Current.mod_table.row_count, vis, Current.mod_table.top)
    end

  inspector: PARAGRAPH
    do
      Current.detail_para
    end

  help_popup: POPUP
    do
      Current.help_modal
    end

  refresh_inspector: DASH_STATE
    do
      let text = DASH_STATE.detail_for(Current.mod_table.selected, Current.view_tabs.selected)
      let para = PARAGRAPH.of_text(text).with_wrap(Current.wrap_mode).with_align(Current.align_mode)
      { Current with detail_para = para }
    end

  sized(w: NAT, h: NAT): DASH_STATE
    do
      { Current with wide = w, high = h }
    end

  stepped_sample: DASH_STATE
    do
      let next_tick = if Current.tick_count < 1000000 then Current.tick_count + 1 else 0 end
      let sample = 1 + (next_tick * 3 + (Current.mod_table.selected % 8)) % 8
      let base_hist = if Current.history.length > 0 then Current.history.tail else Current.history end
      let next_hist = LIST_CUT.take(base_hist.append(LIST.empty.prepend(sample)), 16)
      { Current with history = next_hist, tick_count = next_tick }
    end

  on_key(k: KEY): TUI_NEXT[DASH_STATE]
    do
      if Current.help_shown then
        match k
          case Escape then TUI_NEXT.next({ Current with help_shown = False })
          case Enter then TUI_NEXT.next({ Current with help_shown = False })
          case KeysEnded then TUI_NEXT.quit(0)
          case Char(c) then
            if c = 'q' then TUI_NEXT.quit(0)
            else if c = '?' then TUI_NEXT.next({ Current with help_shown = False })
            else TUI_NEXT.next(Current)
            end end
          case _ then TUI_NEXT.next({ Current with help_modal = Current.help_modal.on_key(k, Current.area) })
        end
      else
        match k
          case KeysEnded then TUI_NEXT.quit(0)
          case Tab then TUI_NEXT.next({ Current with keys_at = Current.keys_at.next })
          case Char(c) then
            if c = 'q' then TUI_NEXT.quit(0)
            else if c = '?' then TUI_NEXT.next({ Current with help_shown = True, help_modal = DASH_STATE.make_help(Current.border_kind) })
            else if c = 't' then TUI_NEXT.next({ Current with theme_idx = if Current.theme_idx < 3 then Current.theme_idx + 1 else 0 end })
            else if c = 'b' then
              let next_b = if Current.border_idx < 3 then Current.border_idx + 1 else 0 end
              let next_kind =
                if next_b = 0 then BORDER_KIND.rounded
                else if next_b = 1 then BORDER_KIND.plain
                else if next_b = 2 then BORDER_KIND.double
                else BORDER_KIND.thick
                end end end
              TUI_NEXT.next({ Current with border_idx = next_b, help_modal = Current.help_modal.with_border(next_kind) })
            else if c = 'w' then
              let next_w = if Current.wrap_idx < 2 then Current.wrap_idx + 1 else 0 end
              TUI_NEXT.next({ Current with wrap_idx = next_w }.refresh_inspector)
            else if c = 'a' then
              let next_a = if Current.align_idx < 2 then Current.align_idx + 1 else 0 end
              TUI_NEXT.next({ Current with align_idx = next_a }.refresh_inspector)
            else if c = ' ' then TUI_NEXT.next(Current.stepped_sample)
            else if Current.view_tabs.takes(k) then
              TUI_NEXT.next({ Current with view_tabs = Current.view_tabs.on_key(k) }.refresh_inspector)
            else TUI_NEXT.next(Current)
            end end end end end end end end
          case _ then
            let vis = DASH_LAYOUT.table_rows(Current.area)
            let next_tbl = Current.mod_table.on_key(k, vis)
            let updated: DASH_STATE = { Current with mod_table = next_tbl }
            TUI_NEXT.next(if next_tbl.selected != Current.mod_table.selected then updated.refresh_inspector else updated end)
        end
      end
    end

  on_mouse(m: MOUSE): TUI_NEXT[DASH_STATE]
    do
      let area = Current.area
      if Current.help_shown then
        if Current.help_modal.contains(area, m.x, m.y) then
          TUI_NEXT.next({ Current with help_modal = Current.help_modal.on_mouse(m, area) })
        else if m.is_left_down then
          TUI_NEXT.next({ Current with help_shown = False })
        else
          TUI_NEXT.next(Current)
        end end
      else
        let tabs_r = DASH_LAYOUT.tabs_bar(area)
        let sb_r = DASH_LAYOUT.scrollbar_area(area)
        let tbl_r = DASH_LAYOUT.table_area(area)
        let insp_r = DASH_LAYOUT.inspector_area(area)
        let left_r = DASH_LAYOUT.left(area)
        let right_r = DASH_LAYOUT.right(area)
        if tabs_r.has(m.x, m.y) then
          let next_tabs = Current.view_tabs.on_mouse(m, tabs_r)
          let updated: DASH_STATE = { Current with view_tabs = next_tabs }
          TUI_NEXT.next(if next_tabs.selected != Current.view_tabs.selected then updated.refresh_inspector else updated end)
        else
          let vis = DASH_LAYOUT.table_rows(area)
          match Current.scrollbar.scroll_for_mouse(m, sb_r, Current.mod_table.row_count, vis)
            case Some(pos) then
              let cur_top = Current.mod_table.top
              let target =
                if pos > cur_top and vis > 0 and pos <= 18446744073709551615 - vis then
                  pos + vis - 1
                else
                  pos
                end
              let next_tbl = Current.mod_table.select(target, vis)
              let updated: DASH_STATE = { Current with mod_table = next_tbl, keys_at = Current.keys_at.moved_to(0) }
              TUI_NEXT.next(if next_tbl.selected != Current.mod_table.selected then updated.refresh_inspector else updated end)
            case None then
              if tbl_r.has(m.x, m.y) then
                let next_tbl = Current.mod_table.on_mouse(m, tbl_r)
                let next_focus = if m.is_left_down then Current.keys_at.moved_to(0) else Current.keys_at end
                let updated: DASH_STATE = { Current with mod_table = next_tbl, keys_at = next_focus }
                TUI_NEXT.next(if next_tbl.selected != Current.mod_table.selected then updated.refresh_inspector else updated end)
              else if insp_r.has(m.x, m.y) then
                TUI_NEXT.next({ Current with detail_para = Current.detail_para.on_mouse(m, insp_r) })
              else if m.is_left_down and left_r.has(m.x, m.y) then
                TUI_NEXT.next({ Current with keys_at = Current.keys_at.moved_to(0) })
              else if m.is_left_down and right_r.has(m.x, m.y) then
                TUI_NEXT.next({ Current with keys_at = Current.keys_at.moved_to(1) })
              else
                TUI_NEXT.next(Current)
              end end end end
          end
        end
      end
    end

end
