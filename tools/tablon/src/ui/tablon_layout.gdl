-- Where Tablon's panes are on a screen, after `issues/image.png`: the project on the left,
-- 30 columns wide; the module chosen on the right, its views' tabs on the first row inside its
-- frame; the output at the bottom, nine rows high; and the status bar on the last row.
-- `update` asks it for the heights it pages by, and `view` for where to draw, so both agree.
functions TABLON_LAYOUT

feature {ANY}

  -- The left, right, bottom and status panes of `area`.
  panes(area: RECT): LIST[RECT]
    do
      let down: LIST[SIZE] = LIST.empty.prepend(SIZE.fixed(1)).prepend(SIZE.fixed(9)).prepend(SIZE.flex(1))
      let parts = LAYOUT.rows(area, down)
      let across: LIST[SIZE] = LIST.empty.prepend(SIZE.flex(1)).prepend(SIZE.fixed(30))
      let columns = LAYOUT.columns(LIST_OPS.at(parts, 0), across)
      LIST.empty.prepend(LIST_OPS.at(parts, 2)).prepend(LIST_OPS.at(parts, 1))
        .prepend(LIST_OPS.at(columns, 1)).prepend(LIST_OPS.at(columns, 0))
    ensure
      four: Result.length = 4
    end

  left(area: RECT): RECT
    do
      LIST_OPS.at(TABLON_LAYOUT.panes(area), 0)
    end

  right(area: RECT): RECT
    do
      LIST_OPS.at(TABLON_LAYOUT.panes(area), 1)
    end

  bottom(area: RECT): RECT
    do
      LIST_OPS.at(TABLON_LAYOUT.panes(area), 2)
    end

  status(area: RECT): RECT
    do
      LIST_OPS.at(TABLON_LAYOUT.panes(area), 3)
    end

  -- The row of the views' tabs, inside the right pane's frame.
  view_tabs(r: RECT): RECT
    do
      FRAME.inner(r).take_top(1)
    end

  -- Where a view is drawn, under its tabs.
  view_body(r: RECT): RECT
    do
      FRAME.inner(r).drop_top(1)
    end

  -- The rows inside a pane's frame.
  rows_in(r: RECT): NAT
    do
      FRAME.inner(r).height
    end

  -- The rows a view of the right pane shows.
  view_rows(area: RECT): NAT
    do
      TABLON_LAYOUT.view_body(TABLON_LAYOUT.right(area)).height
    end

  -- Where the palette goes: over the bottom of the screen, at most 72 wide and 12 high.
  palette(area: RECT, p: PALETTE): RECT
    do
      p.place(area, 72, 12)
    end

end
