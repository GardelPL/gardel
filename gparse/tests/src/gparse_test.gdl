-- The `gparse` cases, which `gardelc test` sends on standard input from `cases.txt`:
--
--   gardelc test gparse
--
-- Each case is checked with `gtest`'s `CASES`, and every failure is printed with its line,
-- what it expected and what it got. The exit status is 0 when every case holds.
program GPARSE_TEST

feature {ANY}

  finish(rs: LIST[TEST_RESULT]): IO[EXIT_CODE]
    do
      let ordered = LIST_OPS.reverse(rs)
      with IO
        IO.print_line(TESTS.report(ordered))
        IO.exit(TESTS.exit_code(ordered))
      end
    end

  run_cases(n: NAT, rs: LIST[TEST_RESULT]): IO[EXIT_CODE]
    require
      bounded: n <= 100000
    variant
      100000 - n
    do
      with IO
        line_res <- IO.read_line
        match line_res
          case Ok(line) then
            if n < 100000 then
              run_cases(n + 1, CASES.check(rs, n, line, fn(c: STRING): STRING do GPARSE_TEXT.got(c) end))
            else
              finish(rs)
            end
          case Error(_) then
            finish(rs)
        end
      end
    end

  main(args: SEQ[STRING]): IO[EXIT_CODE]
    do
      run_cases(1, LIST.empty)
    end

end
